    <skos:member rdf:resource="http://www.w3.org/ns/odrl/2/Assertion"/>
    <skos:member rdf:resource="http://www.w3.org/ns/odrl/2/Privacy"/>
    <skos:member rdf:resource="http://www.w3.org/ns/odrl/2/Request"/>
    <skos:member rdf:resource="http://www.w3.org/ns/odrl/2/Ticket"/>
    <skos:prefLabel xml:lang="en">Policy Subclasses</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Policy Subclasses</skos:prefLabel>
    <skos:prefLabel xml:lang="ca">Policy Subclasses</skos:prefLabel>

    <skos:prefLabel xml:lang="es">Policy Subclasses</skos:prefLabel>

    <skos:prefLabel xml:lang="ca">Policy Subclasses</skos:prefLabel>
    <skos:scopeNote xml:lang="en">ODRL Common Vocabulary Terms</skos:scopeNote>
  </skos:Collection>
  <skos:Collection rdf:about="http://www.w3.org/ns/odrl/2/#prohibitions">
    <skos:member rdf:resource="http://www.w3.org/ns/odrl/2/Prohibition"/>
    <skos:member rdf:resource="http://www.w3.org/ns/odrl/2/prohibition"/>
    <skos:prefLabel xml:lang="en">Prohibition</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Prohibición</skos:prefLabel>
    <skos:prefLabel xml:lang="ca">Prohibició</skos:prefLabel>

    <skos:prefLabel xml:lang="es">Prohibición</skos:prefLabel>

    <skos:prefLabel xml:lang="ca">Prohibició</skos:prefLabel>
    <skos:scopeNote xml:lang="en">ODRL Core Vocabulary Terms</skos:scopeNote>
  </skos:Collection>
  <skos:Collection rdf:about="http://www.w3.org/ns/odrl/2/#ruleConcepts">
    <skos:member rdf:resource="http://www.w3.org/ns/odrl/2/Rule"/>
    <skos:member rdf:resource="http://www.w3.org/ns/odrl/2/failure"/>
    <skos:member rdf:resource="http://www.w3.org/ns/odrl/2/function"/>
    <skos:member rdf:resource="http://www.w3.org/ns/odrl/2/relation"/>
    <skos:prefLabel xml:lang="en">Rule</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Regla</skos:prefLabel>
    <skos:prefLabel xml:lang="ca">Regla</skos:prefLabel>

    <skos:prefLabel xml:lang="es">Regla</skos:prefLabel>

    <skos:prefLabel xml:lang="ca">Regla</skos:prefLabel>
    <skos:scopeNote xml:lang="en">ODRL Core Vocabulary Terms</skos:scopeNote>
  </skos:Collection>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/Action">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Action</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://schema.org/Action"/>
    <skos:definition xml:lang="en">An operation on an Asset.</skos:definition>
    <skos:note xml:lang="en">Actions may be allowed by Permissions, disallowed by Prohibitions, or made mandatory by Duties.</skos:note>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/Agreement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Agreement</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Assertion"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Offer"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Privacy"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Request"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Ticket"/>
    <skos:definition xml:lang="en">A Policy that grants the assignee a Rule over an Asset from an assigner.</skos:definition>
    <skos:note xml:lang="en">An Agreement Policy MUST contain at least one Permission or Prohibition rule, a Party with Assigner function, and a Party with Assignee function (in the same Permission or Prohibition). The Agreement Policy will grant the terms of the Policy from the Assigner to the Assignee.</skos:note>
  </rdfs:Class>
  <PartyScope rdf:about="http://www.w3.org/ns/odrl/2/All">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">All</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">Specifies that the scope of the relationship is all of the collective individuals within a context.</skos:definition>
    <skos:note xml:lang="en">For example, may be used to indicate all the users of a specific social network the party is a member of. Note that “group” scope is also assumed.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
  </PartyScope>
  <PartyScope rdf:about="http://www.w3.org/ns/odrl/2/All2ndConnections">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">All Second-level Connections</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">Specifies that the scope of the relationship is all of the second-level connections to the Party.</skos:definition>
    <skos:note xml:lang="en">For example, may be used to indicate all “friends of friends” of the Party. Note that “group” scope is also assumed.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
  </PartyScope>
  <PartyScope rdf:about="http://www.w3.org/ns/odrl/2/AllConnections">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">All First-Level Connections</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">Specifies that the scope of the relationship is all of the first-level connections of the Party.</skos:definition>
    <skos:note xml:lang="en">For example, may be used to indicate all “friends” of the Party. Note that “group” scope is also assumed.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
  </PartyScope>
  <PartyScope rdf:about="http://www.w3.org/ns/odrl/2/AllGroups">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">All Group Connections</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">Specifies that the scope of the relationship is all of the group connections of the Party.</skos:definition>
    <skos:note xml:lang="en">For example, may be used to indicate all groups that the Party is a member of. Note that “group” scope is also assumed.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
  </PartyScope>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/Assertion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Assertion</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Offer"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Privacy"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Request"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Ticket"/>
    <skos:definition xml:lang="en">A Policy that asserts a Rule over an Asset from parties.</skos:definition>
    <skos:note xml:lang="en">For example, a party (an assignee or assigner) can claim what terms they have over an Asset. An Assertion Policy does not grant such permissions/prohibitions but only asserts the parties claims. An Assetion Policy  MUST contain a target Asset, a Party with any functional role, and at least one of a Permission or Prohibition rule.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/Asset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Asset</rdfs:label>
    <skos:definition xml:lang="en">A resource or a collection of resources that are the subject of a Rule.</skos:definition>
    <skos:note xml:lang="en">The Asset entity can be any form of identifiable resource, such as data/information, content/media, applications, or services. Furthermore, it can be used to represent other Asset entities that are needed to undertake the Policy expression, such as with the Duty entity. To describe more details about the Asset, it is recommended to use Dublin Core [[dcterms]] elements or other content metadata.</skos:note>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/AssetCollection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Asset Collection</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/odrl/2/Asset"/>
    <skos:definition xml:lang="en">An Asset that is collection of individual resources</skos:definition>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/AssetScope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Asset Scope</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">Scopes for Asset Scope expressions.</skos:definition>
    <skos:note xml:lang="en">Instances of the AssetScope class represent the terms for the scope property of Assets.</skos:note>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/ConflictTerm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Conflict Strategy Preference</rdfs:label>
    <skos:definition xml:lang="en">Used to establish strategies to resolve conflicts that arise from the merging of Policies or conflicts between Permissions and Prohibitions in the same Policy.</skos:definition>
    <skos:note xml:lang="en">Instances of ConflictTerm describe strategies for resolving conflicts.</skos:note>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/Constraint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Constraint</rdfs:label>
    <skos:definition xml:lang="en">A boolean expression that refines the semantics of an Action and Party/Asset Collection or declare the conditions applicable to a Rule.</skos:definition>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/Duty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Duty</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/odrl/2/Rule"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Permission"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Prohibition"/>
    <skos:definition xml:lang="en">The obligation to perform an Action</skos:definition>
  </rdfs:Class>
  <PartyScope rdf:about="http://www.w3.org/ns/odrl/2/Group">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Group</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">Specifies that the scope of the relationship is the defined group with multiple individual members.</skos:definition>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
  </PartyScope>
  <PartyScope rdf:about="http://www.w3.org/ns/odrl/2/Individual">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Individual</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">Specifies that the scope of the relationship is the single Party individual.</skos:definition>
  </PartyScope>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/LeftOperand">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Left Operand</rdfs:label>
    <skos:definition xml:lang="en">Left operand for a constraint expression.</skos:definition>
    <skos:note xml:lang="en">Instances of the LeftOperand class are used as the leftOperand of a Constraint.</skos:note>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/LogicalConstraint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Logical Constraint</rdfs:label>
    <skos:definition xml:lang="en">A logical expression that refines the semantics of an Action and Party/Asset Collection or declare the conditions applicable to a Rule.</skos:definition>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/Offer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Offer</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Agreement"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Assertion"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Privacy"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Request"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Ticket"/>
    <skos:definition xml:lang="en">A Policy that proposes a Rule over an Asset from an assigner.</skos:definition>
    <skos:note xml:lang="en">An Offer Policy MUST contain at least one Permission or Prohibition rule and a Party with Assigner function (in the same Permission or Prohibition). The Offer Policy MAY contain a Party with Assignee function, but MUST not grant any privileges to that Party.</skos:note>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/Operator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Operator</rdfs:label>
    <skos:definition xml:lang="en">Operator for constraint expression.</skos:definition>
    <skos:note xml:lang="en">Instances of the Operator class representing relational operators.</skos:note>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/Party">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Party</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class>
        <owl:unionOf>
          <rdf:Description>
            <rdf:first rdf:resource="http://schema.org/Person"/>
            <rdf:rest>
              <rdf:Description>
                <rdf:first rdf:resource="http://schema.org/Organization"/>
                <rdf:rest>
                  <rdf:Description>
                    <rdf:first rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
                    <rdf:rest>
                      <rdf:Description>
                        <rdf:first rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
                        <rdf:rest>
                          <rdf:Description>
                            <rdf:first rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
                            <rdf:rest>
                              <rdf:Description>
                                <rdf:first rdf:resource="http://www.w3.org/2006/vcard/ns#Individual"/>
                                <rdf:rest>
                                  <rdf:Description>
                                    <rdf:first rdf:resource="http://www.w3.org/2006/vcard/ns#Organization"/>
                                    <rdf:rest>
                                      <rdf:Description>
                                        <rdf:first rdf:resource="http://www.w3.org/2006/vcard/ns#Agent"/>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                      </rdf:Description>
                                    </rdf:rest>
                                  </rdf:Description>
                                </rdf:rest>
                              </rdf:Description>
                            </rdf:rest>
                          </rdf:Description>
                        </rdf:rest>
                      </rdf:Description>
                    </rdf:rest>
                  </rdf:Description>
                </rdf:rest>
              </rdf:Description>
            </rdf:rest>
          </rdf:Description>
        </owl:unionOf>
      </owl:Class>
    </rdfs:subClassOf>
    <skos:definition xml:lang="en">An entity or a collection of entities that undertake Roles in a Rule.</skos:definition>
    <skos:note xml:lang="en">The Party entity could be a person, group of people, organisation, or agent. An agent is a person or thing that takes an active role or produces a specified effect. To describe more details about the Party, it is recommended to use W3C vCard Ontology [[vcard-rdf]] or FOAF Vocabulary [[foaf]].</skos:note>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/PartyCollection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Party Collection</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/odrl/2/Party"/>
    <skos:definition xml:lang="en">A Party that is a group of individual entities</skos:definition>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/PartyScope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Party Scope</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">Scopes for Party Scope expressions.</skos:definition>
    <skos:note xml:lang="en">Instances of the PartyScope class represent the terms for the scope property of Parties.</skos:note>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/Permission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Permission</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/odrl/2/Rule"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Duty"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Prohibition"/>
    <skos:definition xml:lang="en">The ability to perform an Action over an Asset.</skos:definition>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/Policy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Policy</rdfs:label>
    <skos:definition xml:lang="en">A non-empty group of Permissions and/or Prohibitions.</skos:definition>
    <skos:note xml:lang="en">A Policy may contain multiple Rules.</skos:note>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/Privacy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Privacy Policy</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Agreement"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Assertion"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Offer"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Request"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Ticket"/>
    <skos:definition xml:lang="en">A Policy that expresses a Rule over an Asset containing personal information.</skos:definition>
    <skos:note xml:lang="en">A Privacy Policy  MUST contain a target Asset, a Party with Assigner  is, a Party with Assignee function, and at least one of a Permission or Prohibition rule that MUST include a Duty. The target Asset SHOULD contain or relate to personal information about the Assignee. The Duty MUST describe obligations on the Assigner about managing the Asset. The Assignee is being granted the terms of the Privacy policy from the Assigner.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/Prohibition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Prohibition</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/odrl/2/Rule"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Duty"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Permission"/>
    <skos:definition xml:lang="en">The inability to perform an Action over an Asset.</skos:definition>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/Request">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Request</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Agreement"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Assertion"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Offer"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Privacy"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Ticket"/>
    <skos:definition xml:lang="en">A Policy that proposes a Rule over an Asset from an assignee.</skos:definition>
    <skos:note xml:lang="en">A Request Policy  MUST contain a target Asset, a Party with Assignee function, and at least one of a Permission or Prohibition rule. The Request MAY also contain the Party with Assigner function if this is known. No privileges are granted to any Party.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/RightOperand">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Right Operand</rdfs:label>
    <skos:definition xml:lang="en">Right operand for constraint expression.</skos:definition>
    <skos:note xml:lang="en">Instances of the RightOperand class are used as the rightOperand of a Constraint.</skos:note>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/Rule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Rule</rdfs:label>
    <skos:definition xml:lang="en">An abstract concept that represents the common characteristics of Permissions, Prohibitions, and Duties.</skos:definition>
    <skos:note xml:lang="en">Rule is an abstract concept.</skos:note>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/Set">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Set</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Agreement"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Assertion"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Offer"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Privacy"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Request"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Ticket"/>
    <skos:definition xml:lang="en">A Policy that expresses a Rule over an Asset.</skos:definition>
    <skos:note xml:lang="en">A Set Policy MUST contain a target Asset, and at least one Rule. A Set Policy is the default Policy subclass. The Set is aimed at scenarios where there is an open criteria for the semantics of the policy expressions and typically refined by other systems/profiles that process the information at a later time. No privileges are granted to any Party (if defined).</skos:note>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/Ticket">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Ticket</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Agreement"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Assertion"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Offer"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Privacy"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/odrl/2/Request"/>
    <skos:definition xml:lang="en">A Policy that grants the holder a Rule over an Asset from an assigner.</skos:definition>
    <skos:note xml:lang="en">A Ticket Policy MUST contain a target Asset and at least one of a Permission or Prohibition rule.  The Ticket MAY contain the Party with Assigner function and MUST NOT contain an Assignee. The Ticket Policy will grant the terms of the Policy to the holder of that Ticket. The holder of the Ticket MAY remain unknown or MAY have to be identified at some later stage.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/odrl/2/UndefinedTerm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Undefined Term</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">Is used to indicate how to support Actions that are not part of any vocabulary or profile in the policy expression system.</skos:definition>
    <skos:note xml:lang="en">Instances of UndefinedTerm describe strategies for processing unsupported actions.</skos:note>
  </rdfs:Class>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/absolutePosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Absolute Asset Position</rdfs:label>
    <rdfs:label xml:lang="es">Posición Absoluta del Activo</rdfs:label>
    <rdfs:label xml:lang="ca">Posició Absoluta de l'Actiu</rdfs:label>
    <skos:definition xml:lang="en">A point in space or time defined with absolute coordinates for the positioning of the target Asset.</skos:definition>
    <skos:definition xml:lang="es">Un punto en el espacio o el tiempo definido con coordenadas absolutas para la posición del Activo de destino.</skos:definition>
    <skos:definition xml:lang="ca">Un punt en l'espai o el temps definit amb coordenades absolutes per a la posició de l'Actiu de destinació.</skos:definition>
    <skos:note xml:lang="en">Example: The upper left corner of a picture may be constrained to a specific position of the canvas rendering it.</skos:note>
    <skos:note xml:lang="es">Ejemplo: la esquina superior izquierda de una imagen puede restringirse a una posición específica del lienzo que la representa.</skos:note>
    <skos:note xml:lang="ca">Exemple: la cantonada superior esquerra d'una imatge pot restringir-se a una posició específica del llenç que la representa.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/absoluteSize">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Absolute Asset Size</rdfs:label>
    <rdfs:label xml:lang="es">Tamaño Absoluto del Activo</rdfs:label>
    <rdfs:label xml:lang="ca">Mida Absoluta de l'Actiu</rdfs:label>
    <skos:definition xml:lang="en">Measure(s) of one or two axes for 2D-objects or measure(s) of one to tree axes for 3D-objects of the target Asset.</skos:definition>
    <skos:definition xml:lang="es">Medida(s) de uno o dos ejes para objetos 2D o medida(s) de uno a tres ejes para objetos 3D del Activo de destino.</skos:definition>
    <skos:definition xml:lang="ca">Mesura(es) d'un o dos eixos per a objectes 2D o mesura(es) d'un a tres eixos per a objectes 3D de l'Actiu de destinació.</skos:definition>
    <skos:note xml:lang="en">Example: The image can be resized in width to a maximum of 1000px.</skos:note>
    <skos:note xml:lang="es">Ejemplo: la imagen puede redimensionarse en anchura hasta un máximo de 1000px.</skos:note>
    <skos:note xml:lang="ca">Exemple: la imatge es pot redimensionar en amplada fins a un màxim de 1000px.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/absoluteSpatialPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Absolute Spatial Asset Position</rdfs:label>
    <rdfs:label xml:lang="es">Posición Espacial Absoluta del Activo</rdfs:label>
    <rdfs:label xml:lang="ca">Posició Espacial Absoluta de l'Actiu</rdfs:label>
    <skos:broader rdf:resource="http://www.w3.org/ns/odrl/2/absolutePosition"/>
    <skos:definition xml:lang="en">The absolute spatial positions of four corners of a rectangle on a 2D-canvas or the eight corners of a cuboid in a 3D-space for the target Asset to fit.</skos:definition>
    <skos:definition xml:lang="es">Las posiciones espaciales absolutas de las cuatro esquinas de un rectángulo en un lienzo 2D o de las ocho esquinas de un cuboide en un espacio 3D en las que debe encajar el Activo de destino.</skos:definition>
    <skos:definition xml:lang="ca">Les posicions espacials absolutes de les quatre cantonades d'un rectangle en un llenç 2D o de les vuit cantonades d'un cuboide en un espai 3D on ha d'encaixar l'Actiu de destinació.</skos:definition>
    <skos:note xml:lang="en">Example: The upper left corner of a picture may be constrained to a specific position of the canvas rendering it. Note: see also the Left Operand Relative Spatial Asset Position. </skos:note>
    <skos:note xml:lang="es">Ejemplo: la esquina superior izquierda de una imagen puede restringirse a una posición específica del lienzo que la representa. Nota: véase también el Operando Izquierdo Posición Espacial Relativa del Activo.</skos:note>
    <skos:note xml:lang="ca">Exemple: la cantonada superior esquerra d'una imatge pot restringir-se a una posició específica del llenç que la representa. Nota: vegeu també l'Operand Esquerre Posició Espacial Relativa de l'Actiu.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/absoluteTemporalPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Absolute Temporal Asset Position</rdfs:label>
    <rdfs:label xml:lang="es">Posición Temporal Absoluta del Activo</rdfs:label>
    <rdfs:label xml:lang="ca">Posició Temporal Absoluta de l'Actiu</rdfs:label>
    <skos:broader rdf:resource="http://www.w3.org/ns/odrl/2/absolutePosition"/>
    <skos:definition xml:lang="en">The absolute temporal positions in a media stream the target Asset has to fit.</skos:definition>
    <skos:definition xml:lang="es">Las posiciones temporales absolutas dentro de un flujo multimedia en las que debe encajar el Activo de destino.</skos:definition>
    <skos:definition xml:lang="ca">Les posicions temporals absolutes dins d'un flux multimèdia on ha d'encaixar l'Actiu de destinació.</skos:definition>
    <skos:note xml:lang="en">Use with Actions including the target Asset in a larger media stream. The fragment part of a Media Fragment URI (https://www.w3.org/TR/media-frags/) may be used for the right operand. See the Left Operand realativeTemporalPosition. &lt;br /&gt;Example: The MP3 music file must be positioned between second 192 and 250 of the temporal length of a stream.</skos:note>
    <skos:note xml:lang="es">Úsese con Acciones que incluyan el Activo de destino en un flujo multimedia más grande. La parte de fragmento de un URI de Media Fragments (https://www.w3.org/TR/media-frags/) puede usarse para el operando derecho. Véase el Operando Izquierdo relativeTemporalPosition. &lt;br /&gt;Ejemplo: el archivo de música MP3 debe situarse entre el segundo 192 y el 250 de la duración temporal de un flujo.</skos:note>
    <skos:note xml:lang="ca">Useu-ho amb Accions que incloguin l'Actiu de destinació en un flux multimèdia més gran. La part de fragment d'un URI de Media Fragments (https://www.w3.org/TR/media-frags/) es pot usar per a l'operand dret. Vegeu l'Operand Esquerre relativeTemporalPosition. &lt;br /&gt;Exemple: el fitxer de música MP3 s'ha de situar entre el segon 192 i el 250 de la durada temporal d'un flux.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/acceptTracking">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Accept Tracking</rdfs:label>
    <rdfs:label xml:lang="es">Aceptar seguimiento</rdfs:label>
    <rdfs:label xml:lang="ca">Acceptar seguiment</rdfs:label>
    <skos:definition xml:lang="en">To accept that the use of the Asset may be tracked.</skos:definition>
    <skos:definition xml:lang="es">Aceptar que el uso del Activo puede ser rastreado.</skos:definition>
    <skos:definition xml:lang="ca">Acceptar que l'ús de l'Actiu pot ser rastrejat.</skos:definition>
    <skos:note xml:lang="en">The collected information may be tracked by the Assigner, or may link to a Party with the role 'trackingParty' function.</skos:note>
    <skos:note xml:lang="es">La información recopilada puede ser rastreada por el Asignador, o puede vincularse a una Parte con la función de 'parte de seguimiento'.</skos:note>
    <skos:note xml:lang="ca">La informació recopilada pot ser rastrejada per l'Assignador, o pot vincular-se a una Part amb la funció de 'part de seguiment'.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/action">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf>
          <rdf:Description>
            <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Rule"/>
            <rdf:rest>
              <rdf:Description>
                <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
              </rdf:Description>
            </rdf:rest>
          </rdf:Description>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Has Action</rdfs:label>
    <rdfs:label xml:lang="es">Tiene Acción</rdfs:label>
    <rdfs:label xml:lang="ca">Té Acció</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Action"/>
    <skos:definition xml:lang="en">The operation relating to the Asset for which the Rule is being subjected.</skos:definition>
    <skos:definition xml:lang="es">La operación relativa al Activo al que se somete la Regla.</skos:definition>
    <skos:definition xml:lang="ca">L'operació relativa a l'Actiu al qual se sotmet la Regla.</skos:definition>
  </rdf:Property>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/adHocShare">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Ad-hoc sharing</rdfs:label>
    <rdfs:label xml:lang="es">Compartir ad-hoc</rdfs:label>
    <rdfs:label xml:lang="ca">Compartir ad-hoc</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The act of sharing the asset to parties in close proximity to the owner.</skos:definition>
    <skos:definition xml:lang="es">El acto de compartir el activo con partes cercanas al propietario.</skos:definition>
    <skos:definition xml:lang="ca">L'acte de compartir l'actiu amb parts properes al propietari.</skos:definition>
    <skos:note xml:lang="en">This original term and URI from the OMA specification should be used: http://www.openmobilealliance.com/oma-dd/adhoc-share .</skos:note>
    <skos:note xml:lang="es">Se debe utilizar este término y URI originales de la especificación OMA: http://www.openmobilealliance.com/oma-dd/adhoc-share .</skos:note>
    <skos:note xml:lang="ca">S'ha d'utilitzar aquest terme i URI originals de l'especificació OMA: http://www.openmobilealliance.com/oma-dd/adhoc-share .</skos:note>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/aggregate">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Aggregate</rdfs:label>
    <rdfs:label xml:lang="es">Agregar</rdfs:label>
    <rdfs:label xml:lang="ca">Agregar</rdfs:label>
    <skos:definition xml:lang="en">To use the Asset or parts of it as part of a composite collection.</skos:definition>
    <skos:definition xml:lang="es">Utilizar el Activo o partes de él como parte de una colección compuesta.</skos:definition>
    <skos:definition xml:lang="ca">Utilitzar l'Actiu o parts d'ell com a part d'una col·lecció composta.</skos:definition>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/and">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">And</rdfs:label>
    <rdfs:label xml:lang="es">Y</rdfs:label>
    <rdfs:label xml:lang="ca">I</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/operand"/>
    <skos:definition xml:lang="en">The relation is satisfied when all of the Constraints are satisfied.</skos:definition>
    <skos:definition xml:lang="es">La relación se satisface cuando se cumplen todas las Restricciones.</skos:definition>
    <skos:definition xml:lang="ca">La relació se satisfà quan es compleixen totes les Restriccions.</skos:definition>
    <skos:note xml:lang="en">This property MUST only be used for Logical Constraints, and the list of operand values MUST be Constraint instances.</skos:note>
    <skos:note xml:lang="es">Esta propiedad SÓLO DEBE usarse para Restricciones Lógicas, y la lista de valores de operando DEBE ser instancias de Restricción.</skos:note>
    <skos:note xml:lang="ca">Aquesta propietat NOMÉS S'HA d'usar per a Restriccions Lògiques, i la llista de valors d'operand HA DE ser instàncies de Restricció.</skos:note>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/andSequence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">And Sequence</rdfs:label>
    <rdfs:label xml:lang="es">Y Secuencia</rdfs:label>
    <rdfs:label xml:lang="ca">I Seqüència</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/operand"/>
    <skos:definition xml:lang="en">The relation is satisfied when each of the Constraints are satisfied in the order specified.</skos:definition>
    <skos:definition xml:lang="es">La relación se satisface cuando cada una de las Restricciones se cumple en el orden especificado.</skos:definition>
    <skos:definition xml:lang="ca">La relació se satisfà quan cadascuna de les Restriccions es compleix en l'ordre especificat.</skos:definition>
    <skos:note xml:lang="en">This property MUST only be used for Logical Constraints, and the list of operand values MUST be Constraint instances. The order of the list MUST be preserved. The andSequence operator is an example where there may be temporal conditional requirements between the operands. This may lead to situations where the outcome is unresolvable, such as deadlock if one of the Constraints is unable to be satisfied. ODRL Processing systems SHOULD plan for these scenarios and implement mechanisms to resolve them.</skos:note>
    <skos:note xml:lang="es">Esta propiedad SÓLO DEBE usarse para Restricciones Lógicas, y la lista de valores de operando DEBE ser instancias de Restricción. El orden de la lista DEBE preservarse. El operador andSequence es un ejemplo donde puede haber requisitos condicionales temporales entre los operandos. Esto puede llevar a situaciones donde el resultado es irresoluble, como un punto muerto si una de las Restricciones no puede satisfacerse. Los sistemas de procesamiento ODRL DEBERÍAN planificar estos escenarios e implementar mecanismos para resolverlos.</skos:note>
    <skos:note xml:lang="ca">Aquesta propietat NOMÉS S'HA d'usar per a Restriccions Lògiques, i la llista de valors d'operand HA DE ser instàncies de Restricció. L'ordre de la llista S'HA DE preservar. L'operador andSequence és un exemple on hi pot haver requisits condicionals temporals entre els operands. Això pot portar a situacions on el resultat és irresoluble, com un punt mort si una de les Restriccions no es pot satisfer. Els sistemes de processament ODRL HAURIEN de planificar aquests escenaris i implementar mecanismes per resoldre'ls.</skos:note>
  </rdf:Property>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/annotate">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Annotate</rdfs:label>
    <rdfs:label xml:lang="es">Anotar</rdfs:label>
    <rdfs:label xml:lang="ca">Anotar</rdfs:label>
    <skos:definition xml:lang="en">To add explanatory notations/commentaries to the Asset without modifying the Asset in any other way.</skos:definition>
    <skos:definition xml:lang="es">Añadir notaciones/comentarios explicativos al Activo sin modificar el Activo de ninguna otra manera.</skos:definition>
    <skos:definition xml:lang="ca">Afegir notacions/comentaris explicatius a l'Actiu sense modificar l'Actiu de cap altra manera.</skos:definition>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/anonymize">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Anonymize</rdfs:label>
    <rdfs:label xml:lang="es">Anonimizar</rdfs:label>
    <rdfs:label xml:lang="ca">Anonimitzar</rdfs:label>
    <skos:definition xml:lang="en">To anonymize all or parts of the Asset.</skos:definition>
    <skos:definition xml:lang="es">Anonimizar todo o parte del Activo.</skos:definition>
    <skos:definition xml:lang="ca">Anonimitzar tot o part de l'Actiu.</skos:definition>
    <skos:note xml:lang="en">For example, to remove identifying particulars for statistical or for other comparable purposes, or to use the Asset without stating the author/source.</skos:note>
    <skos:note xml:lang="es">Por ejemplo, para eliminar datos identificativos con fines estadísticos o comparables, o para usar el Activo sin indicar el autor/fuente.</skos:note>
    <skos:note xml:lang="ca">Per exemple, per eliminar dades identificatives amb finalitats estadístiques o comparables, o per usar l'Actiu sense indicar l'autor/font.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/append">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Append</rdfs:label>
    <rdfs:label xml:lang="es">Anexar</rdfs:label>
    <rdfs:label xml:lang="ca">Annexar</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The act of adding to the end of an asset.</skos:definition>
    <skos:definition xml:lang="es">El acto de añadir al final de un activo.</skos:definition>
    <skos:definition xml:lang="ca">L'acte d'afegir al final d'un actiu.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.w3.org/ns/odrl/2/modify"/>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/appendTo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Append To</rdfs:label>
    <rdfs:label xml:lang="es">Anexar a</rdfs:label>
    <rdfs:label xml:lang="ca">Annexar a</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The act of appending data to the Asset without modifying the Asset in any other way.</skos:definition>
    <skos:definition xml:lang="es">El acto de anexar datos al Activo sin modificar el Activo de ninguna otra manera.</skos:definition>
    <skos:definition xml:lang="ca">L'acte d'annexar dades a l'Actiu sense modificar l'Actiu de cap altra manera.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.w3.org/ns/odrl/2/modify"/>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/archive">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Archive</rdfs:label>
    <rdfs:label xml:lang="es">Archivar</rdfs:label>
    <rdfs:label xml:lang="ca">Arxivar</rdfs:label>
    <skos:definition xml:lang="en">To store the Asset (in a non-transient form).</skos:definition>
    <skos:definition xml:lang="es">Almacenar el Activo (en una forma no transitoria).</skos:definition>
    <skos:definition xml:lang="ca">Emmagatzemar l'Actiu (en una forma no transitòria).</skos:definition>
    <skos:note xml:lang="en">Temporal constraints may be used for temporal conditions.</skos:note>
    <skos:note xml:lang="es">Se pueden usar restricciones temporales para condiciones temporales.</skos:note>
    <skos:note xml:lang="ca">Es poden usar restriccions temporals per a condicions temporals.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/assignee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf>
          <rdf:Description>
            <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Rule"/>
            <rdf:rest>
              <rdf:Description>
                <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
              </rdf:Description>
            </rdf:rest>
          </rdf:Description>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Assignee</rdfs:label>
    <rdfs:label xml:lang="es">Cesionario</rdfs:label>
    <rdfs:label xml:lang="ca">Cessionari</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Party"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/function"/>
    <skos:definition xml:lang="en">The Party is the recipient of the Rule.</skos:definition>
    <skos:definition xml:lang="es">La Parte es la receptora de la Regla.</skos:definition>
    <skos:definition xml:lang="ca">La Part és la receptora de la Regla.</skos:definition>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/assigneeOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Party"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Assignee Of</rdfs:label>
    <rdfs:label xml:lang="es">Cesionario de</rdfs:label>
    <rdfs:label xml:lang="ca">Cessionari de</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
    <skos:definition xml:lang="en">Identifies an ODRL Policy for which the identified Party undertakes the assignee functional role.</skos:definition>
    <skos:definition xml:lang="es">Identifica una Política ODRL para la cual la Parte identificada asume el rol funcional de cesionario.</skos:definition>
    <skos:definition xml:lang="ca">Identifica una Política ODRL per a la qual la Part identificada assumeix el rol funcional de cessionari.</skos:definition>
    <skos:note xml:lang="en">When assigneeOf has been asserted between a metadata expression and an ODRL Policy, the Party being identified MUST be inferred to undertake the assignee functional role of all the Rules of that Policy.</skos:note>
    <skos:note xml:lang="es">Cuando se ha afirmado assigneeOf entre una expresión de metadatos y una Política ODRL, se DEBE inferir que la Parte identificada asume el rol funcional de cesionario de todas las Reglas de esa Política.</skos:note>
    <skos:note xml:lang="ca">Quan s'ha afirmat assigneeOf entre una expressió de metadatos i una Política ODRL, s'HA d'inferir que la Part identificada assumeix el rol funcional de cessionari de totes les Regles d'aquesta Política.</skos:note>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/assigner">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf>
          <rdf:Description>
            <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Rule"/>
            <rdf:rest>
              <rdf:Description>
                <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
              </rdf:Description>
            </rdf:rest>
          </rdf:Description>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Assigner</rdfs:label>
    <rdfs:label xml:lang="es">Cedente</rdfs:label>
    <rdfs:label xml:lang="ca">Cedent</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Party"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/function"/>
    <skos:definition xml:lang="en">The Party is the issuer of the Rule.</skos:definition>
    <skos:definition xml:lang="es">La Parte es la emisora de la Regla.</skos:definition>
    <skos:definition xml:lang="ca">La Part és l'emissora de la Regla.</skos:definition>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/assignerOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Party"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Assigner Of</rdfs:label>
    <rdfs:label xml:lang="es">Cedente de</rdfs:label>
    <rdfs:label xml:lang="ca">Cedent de</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
    <skos:definition xml:lang="en">Identifies an ODRL Policy for which the identified Party undertakes the assigner functional role.</skos:definition>
    <skos:definition xml:lang="es">Identifica una Política ODRL para la cual la Parte identificada asume el rol funcional de cedente.</skos:definition>
    <skos:definition xml:lang="ca">Identifica una Política ODRL per a la qual la Part identificada assumeix el rol funcional de cedent.</skos:definition>
    <skos:note xml:lang="en">When assignerOf has been asserted between a metadata expression and an ODRL Policy, the Party being identified MUST be inferred to undertake the assigner functional role of all the Rules of that Policy.</skos:note>
    <skos:note xml:lang="es">Cuando se ha afirmado assignerOf entre una expresión de metadatos y una Política ODRL, se DEBE inferir que la Parte identificada asume el rol funcional de cedente de todas las Reglas de esa Política.</skos:note>
    <skos:note xml:lang="ca">Quan s'ha afirmat assignerOf entre una expressió de metadatos i una Política ODRL, s'HA d'inferir que la Part identificada assumeix el rol funcional de cedent de totes les Regles d'aquesta Política.</skos:note>
  </rdf:Property>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/attachPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Attach policy</rdfs:label>
    <rdfs:label xml:lang="es">Adjuntar política</rdfs:label>
    <rdfs:label xml:lang="ca">Adjuntar política</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The act of keeping the policy notice with the asset.</skos:definition>
    <skos:definition xml:lang="es">El acto de mantener el aviso de política con el activo.</skos:definition>
    <skos:definition xml:lang="ca">L'acte de mantenir l'avís de política amb l'actiu.</skos:definition>
    <skos:exactMatch rdf:resource="http://creativecommons.org/ns#Notice"/>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/attachSource">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Attach source</rdfs:label>
    <rdfs:label xml:lang="es">Adjuntar fuente</rdfs:label>
    <rdfs:label xml:lang="ca">Adjuntar font</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The act of attaching the source of the asset and its derivatives.</skos:definition>
    <skos:definition xml:lang="es">El acto de adjuntar la fuente del activo y sus derivados.</skos:definition>
    <skos:definition xml:lang="ca">L'acte d'adjuntar la font de l'actiu i els seus derivats.</skos:definition>
    <skos:exactMatch rdf:resource="http://creativecommons.org/ns#SourceCode"/>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/attribute">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Attribute</rdfs:label>
    <rdfs:label xml:lang="es">Atribuir</rdfs:label>
    <rdfs:label xml:lang="ca">Atribuir</rdfs:label>
    <skos:definition xml:lang="en">To attribute the use of the Asset.</skos:definition>
    <skos:definition xml:lang="es">Atribuir el uso del Activo.</skos:definition>
    <skos:definition xml:lang="ca">Atribuir l'ús de l'Actiu.</skos:definition>
    <skos:note xml:lang="en">May link to an Asset with the attribution information. May link to a Party with the  role “attributedParty” function.</skos:note>
    <skos:note xml:lang="es">Puede vincular a un Activo con la información de atribución. Puede vincular a una Parte con la función de rol "parte atribuida".</skos:note>
    <skos:note xml:lang="ca">Pot vincular a un Actiu amb la informació d'atribució. Pot vincular a una Part amb la funció de rol "part atribuïda".</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/attributedParty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Attributed Party</rdfs:label>
    <rdfs:label xml:lang="es">Parte Atribuida</rdfs:label>
    <rdfs:label xml:lang="ca">Part Atribuïda</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/function"/>
    <skos:definition xml:lang="en">The Party to be attributed.</skos:definition>
    <skos:definition xml:lang="es">La Parte a ser atribuida.</skos:definition>
    <skos:definition xml:lang="ca">La Part a ser atribuïda.</skos:definition>
    <skos:note xml:lang="en">Maybe specified as part of the attribute action.</skos:note>
    <skos:note xml:lang="es">Puede especificarse como parte de la acción de atribuir.</skos:note>
    <skos:note xml:lang="ca">Pot especificar-se com a part de l'acció d'atribuir.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/attributingParty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Attributing Party</rdfs:label>
    <rdfs:label xml:lang="es">Parte Atribuyente</rdfs:label>
    <rdfs:label xml:lang="ca">Part Atribuent</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/function"/>
    <skos:definition xml:lang="en">The Party who undertakes the attribution.</skos:definition>
    <skos:definition xml:lang="es">La Parte que realiza la atribución.</skos:definition>
    <skos:definition xml:lang="ca">La Part que realitza l'atribució.</skos:definition>
    <skos:note xml:lang="en">Maybe specified as part of the attribute action.</skos:note>
    <skos:note xml:lang="es">Puede especificarse como parte de la acción de atribuir.</skos:note>
    <skos:note xml:lang="ca">Pot especificar-se com a part de l'acció d'atribuir.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </rdf:Property>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/commercialize">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Commercialize</rdfs:label>
    <rdfs:label xml:lang="es">Comercializar</rdfs:label>
    <rdfs:label xml:lang="ca">Comercialitzar</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The act of using the asset in a business environment.</skos:definition>
    <skos:definition xml:lang="es">El acto de usar el activo en un entorno empresarial.</skos:definition>
    <skos:definition xml:lang="ca">L'acte d'usar l'actiu en un entorn empresarial.</skos:definition>
    <skos:exactMatch rdf:resource="http://creativecommons.org/ns#CommercialUse"/>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/compensate">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Compensate</rdfs:label>
    <rdfs:label xml:lang="es">Compensar</rdfs:label>
    <rdfs:label xml:lang="ca">Compensar</rdfs:label>
    <skos:definition xml:lang="en">To compensate by transfer of some amount of value, if defined, for using or selling the Asset.</skos:definition>
    <skos:definition xml:lang="es">Compensar mediante la transferencia de una cantidad de valor, si se define, por usar o vender el Activo.</skos:definition>
    <skos:definition xml:lang="ca">Compensar mitjançant la transferència d'una quantitat de valor, si es defineix, per usar o vendre l'Actiu.</skos:definition>
    <skos:note xml:lang="en">The compensation may use different types of things with a value: (i) the thing is expressed by the value (term) of the Constraint name; (b) the value is expressed by operator, rightOperand, dataType and unit. Typically the assignee will compensate the assigner, but other compensation party roles may be used.</skos:note>
    <skos:note xml:lang="es">La compensación puede usar diferentes tipos de cosas con un valor: (i) la cosa se expresa por el valor (término) del nombre de la Restricción; (b) el valor se expresa por operador, operando derecho, tipo de datos y unidad. Típicamente, el cesionario compensará al cedente, pero se pueden usar otros roles de parte de compensación.</skos:note>
    <skos:note xml:lang="ca">La compensació pot usar diferents tipus de coses amb un valor: (i) la cosa s'expressa pel valor (terme) del nom de la Restricció; (b) el valor s'expressa per operador, operand dret, tipus de dades i unitat. Típicament, el cessionari compensarà al cedent, però es poden usar altres rols de part de compensació.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/compensatedParty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Compensated Party</rdfs:label>
    <rdfs:label xml:lang="es">Parte Compensada</rdfs:label>
    <rdfs:label xml:lang="ca">Part Compensada</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/function"/>
    <skos:definition xml:lang="en">The Party is the recipient of the compensation.</skos:definition>
    <skos:definition xml:lang="es">La Parte es la receptora de la compensación.</skos:definition>
    <skos:definition xml:lang="ca">La Part és la receptora de la compensació.</skos:definition>
    <skos:note xml:lang="en">Maybe specified as part of the compensate duty action.</skos:note>
    <skos:note xml:lang="es">Puede especificarse como parte de la acción de deber de compensar.</skos:note>
    <skos:note xml:lang="ca">Pot especificar-se com a part de l'acció de deure de compensar.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/compensatingParty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Compensating Party</rdfs:label>
    <rdfs:label xml:lang="es">Parte Compensadora</rdfs:label>
    <rdfs:label xml:lang="ca">Part Compensadora</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/function"/>
    <skos:definition xml:lang="en">The Party that is the provider of the compensation.</skos:definition>
    <skos:definition xml:lang="es">La Parte que es la proveedora de la compensación.</skos:definition>
    <skos:definition xml:lang="ca">La Part que és la proveïdora de la compensació.</skos:definition>
    <skos:note xml:lang="en">Maybe specified as part of the compensate duty action.</skos:note>
    <skos:note xml:lang="es">Puede especificarse como parte de la acción de deber de compensar.</skos:note>
    <skos:note xml:lang="ca">Pot especificar-se com a part de l'acció de deure de compensar.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </rdf:Property>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/concurrentUse">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Concurrent Use</rdfs:label>
    <rdfs:label xml:lang="es">Uso Concurrente</rdfs:label>
    <rdfs:label xml:lang="ca">Ús Concurrent</rdfs:label>
    <skos:definition xml:lang="en">To create multiple copies of the Asset that are being concurrently used.</skos:definition>
    <skos:definition xml:lang="es">Crear múltiples copias del Activo que se están utilizando concurrentemente.</skos:definition>
    <skos:definition xml:lang="ca">Crear múltiples còpies de l'Actiu que s'estan utilitzant concurrentment.</skos:definition>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/conflict">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Handle Policy Conflicts</rdfs:label>
    <rdfs:label xml:lang="es">Manejar Conflictos de Política</rdfs:label>
    <rdfs:label xml:lang="ca">Gestionar Conflictes de Política</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/ConflictTerm"/>
    <skos:definition xml:lang="en">The conflict-resolution strategy for a Policy.</skos:definition>
    <skos:definition xml:lang="es">La estrategia de resolución de conflictos para una Política.</skos:definition>
    <skos:definition xml:lang="ca">L'estratègia de resolució de conflictes per a una Política.</skos:definition>
    <skos:note xml:lang="en">If no strategy is specified, the default is invalid.</skos:note>
    <skos:note xml:lang="es">Si no se especifica ninguna estrategia, el valor predeterminado es inválido.</skos:note>
    <skos:note xml:lang="ca">Si no s'especifica cap estratègia, el valor per defecte és invàlid.</skos:note>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/consentedParty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Consented Party</rdfs:label>
    <rdfs:label xml:lang="es">Parte Consentida</rdfs:label>
    <rdfs:label xml:lang="ca">Part Consentida</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/function"/>
    <skos:definition xml:lang="en">The Party who obtains the consent.</skos:definition>
    <skos:definition xml:lang="es">La Parte que obtiene el consentimiento.</skos:definition>
    <skos:definition xml:lang="ca">La Part que obté el consentiment.</skos:definition>
    <skos:note xml:lang="en">Maybe specified as part of the obtainConsent action.</skos:note>
    <skos:note xml:lang="es">Puede especificarse como parte de la acción obtainConsent.</skos:note>
    <skos:note xml:lang="ca">Pot especificar-se com a part de l'acció obtainConsent.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/consentingParty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Consenting Party</rdfs:label>
    <rdfs:label xml:lang="es">Parte que Consiente</rdfs:label>
    <rdfs:label xml:lang="ca">Part que Consent</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/function"/>
    <skos:definition xml:lang="en">The Party to obtain consent from.</skos:definition>
    <skos:definition xml:lang="es">La Parte de la que se obtiene el consentimiento.</skos:definition>
    <skos:definition xml:lang="ca">La Part de la qual s'obté el consentiment.</skos:definition>
    <skos:note xml:lang="en">Maybe specified as part of the obtainConsent action.</skos:note>
    <skos:note xml:lang="es">Puede especificarse como parte de la acción obtainConsent.</skos:note>
    <skos:note xml:lang="ca">Pot especificar-se com a part de l'acció obtainConsent.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/consequence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Duty"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Consequence</rdfs:label>
    <rdfs:label xml:lang="es">Consecuencia</rdfs:label>
    <rdfs:label xml:lang="ca">Conseqüència</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Duty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/failure"/>
    <skos:definition xml:lang="en">Relates a Duty to another Duty, the latter being a consequence of not fulfilling the former.</skos:definition>
    <skos:definition xml:lang="es">Relaciona un Deber con otro Deber, siendo este último una consecuencia de no cumplir el primero.</skos:definition>
    <skos:definition xml:lang="ca">Relaciona un Deure amb un altre Deure, sent aquest últim una conseqüència de no complir el primer.</skos:definition>
    <skos:note xml:lang="en">The consequence property is utilised to express the repercussions of not fulfilling an agreed Policy obligation or duty for a Permission. If either of these fails to be fulfilled, then this will result in the consequence Duty also becoming a new requirement, meaning that the original obligation or duty, as well as the consequence Duty must all be fulfilled</skos:note>
    <skos:note xml:lang="es">La propiedad de consecuencia se utiliza para expresar las repercusiones de no cumplir una obligación o deber de Política acordado para un Permiso. Si alguno de estos no se cumple, esto dará como resultado que el Deber de consecuencia también se convierta en un nuevo requisito, lo que significa que tanto la obligación o deber original, como el Deber de consecuencia deben cumplirse.</skos:note>
    <skos:note xml:lang="ca">La propietat de conseqüència s'utilitza per expressar les repercussions de no complir una obligació o deure de Política acordat per a un Permís. Si algun d'aquests no es compleix, això donarà com a resultat que el Deure de conseqüència també esdevingui un nou requisit, la qual cosa significa que tant l'obligació o deure original, com el Deure de conseqüència s'han de complir.</skos:note>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/constraint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf>
          <rdf:Description>
            <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
            <rdf:rest>
              <rdf:Description>
                <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Rule"/>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
              </rdf:Description>
            </rdf:rest>
          </rdf:Description>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Has Constraint</rdfs:label>
    <rdfs:label xml:lang="es">Tiene Restricción</rdfs:label>
    <rdfs:label xml:lang="ca">Té Restricció</rdfs:label>
    <rdfs:range>
      <owl:Class>
        <owl:unionOf>
          <rdf:Description>
            <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Constraint"/>
            <rdf:rest>
              <rdf:Description>
                <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/LogicalConstraint"/>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
              </rdf:Description>
            </rdf:rest>
          </rdf:Description>
        </owl:unionOf>
      </owl:Class>
    </rdfs:range>
    <skos:definition xml:lang="en">Constraint applied to a Rule</skos:definition>
    <skos:definition xml:lang="es">Restricción aplicada a una Regla</skos:definition>
    <skos:definition xml:lang="ca">Restricció aplicada a una Regla</skos:definition>
    <skos:note xml:lang="en">Constraints on Rules are used to determine if a rule is Active or not. Example: the Permission rule is only active during the year 2018.</skos:note>
    <skos:note xml:lang="es">Las restricciones en las Reglas se utilizan para determinar si una regla está Activa o no. Ejemplo: la regla de Permiso solo está activa durante el año 2018.</skos:note>
    <skos:note xml:lang="ca">Les restriccions a les Regles s'utilitzen per determinar si una regla està Activa o no. Exemple: la regla de Permís només està activa durant l'any 2018.</skos:note>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/contractedParty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Contracted Party</rdfs:label>
    <rdfs:label xml:lang="es">Parte Contratada</rdfs:label>
    <rdfs:label xml:lang="ca">Part Contractada</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/function"/>
    <skos:definition xml:lang="en">The Party who is being contracted.</skos:definition>
    <skos:definition xml:lang="es">La Parte que está siendo contratada.</skos:definition>
    <skos:definition xml:lang="ca">La Part que està sent contractada.</skos:definition>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/contractingParty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Contracting Party</rdfs:label>
    <rdfs:label xml:lang="es">Parte Contratante</rdfs:label>
    <rdfs:label xml:lang="ca">Part Contractant</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/function"/>
    <skos:definition xml:lang="en">The Party who is offering the contract.</skos:definition>
    <skos:definition xml:lang="es">La Parte que ofrece el contrato.</skos:definition>
    <skos:definition xml:lang="ca">La Part que ofereix el contracte.</skos:definition>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </rdf:Property>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/copy">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Copy</rdfs:label>
    <rdfs:label xml:lang="es">Copiar</rdfs:label>
    <rdfs:label xml:lang="ca">Copiar</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <owl:sameAs rdf:resource="http://www.w3.org/ns/odrl/2/reproduce"/>
    <skos:definition xml:lang="en">The act of making an exact reproduction of the asset.</skos:definition>
    <skos:definition xml:lang="es">El acto de hacer una reproducción exacta del activo.</skos:definition>
    <skos:definition xml:lang="ca">L'acte de fer una reproducció exacta de l'actiu.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.w3.org/ns/odrl/2/reproduce"/>
  </Action>
  <owl:Thing rdf:about="http://www.w3.org/ns/odrl/2/core">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">ODRL Core Profile</rdfs:label>
    <rdfs:label xml:lang="es">Perfil Principal de ODRL</rdfs:label>
    <rdfs:label xml:lang="ca">Perfil Principal d'ODRL</rdfs:label>
    <skos:definition xml:lang="en">Identifier for the ODRL Core Profile</skos:definition>
    <skos:definition xml:lang="es">Identificador para el Perfil Principal de ODRL</skos:definition>
    <skos:definition xml:lang="ca">Identificador per al Perfil Principal d'ODRL</skos:definition>
  </owl:Thing>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/count">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Count</rdfs:label>
    <rdfs:label xml:lang="es">Contar</rdfs:label>
    <rdfs:label xml:lang="ca">Comptar</rdfs:label>
    <skos:definition xml:lang="en">Numeric count of executions of the action of the Rule.</skos:definition>
    <skos:definition xml:lang="es">Recuento numérico de ejecuciones de la acción de la Regla.</skos:definition>
    <skos:definition xml:lang="ca">Recompte numèric d'execucions de l'acció de la Regla.</skos:definition>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/dataType">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Constraint"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Datatype</rdfs:label>
    <rdfs:label xml:lang="es">Tipo de datos</rdfs:label>
    <rdfs:label xml:lang="ca">Tipus de dades</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <skos:definition xml:lang="en">The datatype of the value of the rightOperand or rightOperandReference of a Constraint.</skos:definition>
    <skos:definition xml:lang="es">El tipo de datos del valor del operando derecho o la referencia del operando derecho de una Restricción.</skos:definition>
    <skos:definition xml:lang="ca">El tipus de dades del valor de l'operand dret o la referència de l'operand dret d'una Restricció.</skos:definition>
    <skos:note xml:lang="en">In RDF encodings, use of the rdf:datatype MUST be used. In JSON-LD encoding, the use of @type MUST be used.</skos:note>
    <skos:note xml:lang="es">En codificaciones RDF, se DEBE usar rdf:datatype. En codificación JSON-LD, se DEBE usar @type.</skos:note>
    <skos:note xml:lang="ca">En codificacions RDF, s'HA d'usar rdf:datatype. En codificació JSON-LD, s'HA d'usar @type.</skos:note>
  </rdf:Property>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/dateTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Datetime</rdfs:label>
    <rdfs:label xml:lang="es">Fecha y hora</rdfs:label>
    <rdfs:label xml:lang="ca">Data i hora</rdfs:label>
    <skos:definition xml:lang="en">The date (and optional time and timezone) of exercising the action of the Rule. Right operand value MUST be an xsd:date or xsd:dateTime as defined by [[xmlschema11-2]].</skos:definition>
    <skos:definition xml:lang="es">La fecha (y opcionalmente la hora y la zona horaria) de ejercicio de la acción de la Regla. El valor del operando derecho DEBE ser un xsd:date o xsd:dateTime como se define en [[xmlschema11-2]].</skos:definition>
    <skos:definition xml:lang="ca">La data (i opcionalment l'hora i la zona horària) d'exercici de l'acció de la Regla. El valor de l'operand dret HA DE ser un xsd:date o xsd:dateTime com es defineix a [[xmlschema11-2]].</skos:definition>
    <skos:note xml:lang="en">The use of Timezone information is strongly recommended. The Rule may be exercised before (with operator lt/lteq) or after (with operator gt/gteq) the date(time) defined by the Right operand. &lt;br /&gt;Example: &lt;code&gt;dateTime gteq 2017-12-31T06:00Z&lt;/code&gt; means the Rule can only be exercised after (and including) 6:00AM on the 31st Decemeber 2017 UTC time.</skos:note>
    <skos:note xml:lang="es">Se recomienda encarecidamente el uso de información de zona horaria. La Regla puede ejercerse antes (con el operador lt/lteq) o después (con el operador gt/gteq) de la fecha (hora) definida por el operando Derecho. &lt;br /&gt;Ejemplo: &lt;code&gt;dateTime gteq 2017-12-31T06:00Z&lt;/code&gt; significa que la Regla solo puede ejercerse después (e incluyendo) las 6:00 a.m. del 31 de diciembre de 2017, hora UTC.</skos:note>
    <skos:note xml:lang="ca">Es recomana encaridament l'ús d'informació de zona horària. La Regla es pot exercir abans (amb l'operador lt/lteq) o després (amb l'operador gt/gteq) de la data (hora) definida per l'operand Dret. &lt;br /&gt;Exemple: &lt;code&gt;dateTime gteq 2017-12-31T06:00Z&lt;/code&gt; significa que la Regla només es pot exercir després (i incloent) les 6:00 a.m. del 31 de desembre de 2017, hora UTC.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/delayPeriod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Delay Period</rdfs:label>
    <rdfs:label xml:lang="es">Período de Retraso</rdfs:label>
    <rdfs:label xml:lang="ca">Període de Retard</rdfs:label>
    <skos:definition xml:lang="en">A time delay period prior to exercising the action of the Rule. The point in time triggering this period MAY be defined by another temporal Constraint combined by a Logical Constraint (utilising the odrl:andSequence operand). Right operand value MUST be an xsd:duration as defined by [[xmlschema11-2]].</skos:definition>
    <skos:definition xml:lang="es">Un período de retraso de tiempo antes de ejercer la acción de la Regla. El punto en el tiempo que desencadena este período PUEDE definirse por otra Restricción temporal combinada por una Restricción Lógica (utilizando el operando odrl:andSequence). El valor del operando derecho DEBE ser un xsd:duration como se define en [[xmlschema11-2]].</skos:definition>
    <skos:definition xml:lang="ca">Un període de retard de temps abans d'exercir l'acció de la Regla. El punt en el temps que desencadena aquest període POT definir-se per una altra Restricció temporal combinada per una Restricció Lògica (utilitzant l'operand odrl:andSequence). El valor de l'operand dret HA DE ser un xsd:duration com es defineix a [[xmlschema11-2]].</skos:definition>
    <skos:note xml:lang="en">Only the eq, gt, gteq operators SHOULD be used. &lt;br /&gt;Example: &lt;code&gt;delayPeriod eq P60M&lt;/code&gt; indicates a delay of 60 Minutes before exercising the action.</skos:note>
    <skos:note xml:lang="es">Solo se DEBEN usar los operadores eq, gt, gteq. &lt;br /&gt;Ejemplo: &lt;code&gt;delayPeriod eq P60M&lt;/code&gt; indica un retraso de 60 minutos antes de ejercer la acción.</skos:note>
    <skos:note xml:lang="ca">Només s'HAURIEN d'usar els operadors eq, gt, gteq. &lt;br /&gt;Exemple: &lt;code&gt;delayPeriod eq P60M&lt;/code&gt; indica un retard de 60 minuts abans d'exercir l'acció.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/delete">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Delete</rdfs:label>
    <rdfs:label xml:lang="es">Eliminar</rdfs:label>
    <rdfs:label xml:lang="ca">Eliminar</rdfs:label>
    <skos:definition xml:lang="en">To permanently remove all copies of the Asset after it has been used.</skos:definition>
    <skos:definition xml:lang="es">Eliminar permanentemente todas las copias del Activo después de que se haya utilizado.</skos:definition>
    <skos:definition xml:lang="ca">Eliminar permanentment totes les còpies de l'Actiu després que s'hagi utilitzat.</skos:definition>
    <skos:note xml:lang="en">Use a constraint to define under which conditions the Asset must be deleted.</skos:note>
    <skos:note xml:lang="es">Use una restricción para definir bajo qué condiciones se debe eliminar el Activo.</skos:note>
    <skos:note xml:lang="ca">Useu una restricció per definir sota quines condicions s'ha d'eliminar l'Actiu.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/deliveryChannel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Delivery Channel</rdfs:label>
    <rdfs:label xml:lang="es">Canal de Entrega</rdfs:label>
    <rdfs:label xml:lang="ca">Canal de Lliurament</rdfs:label>
    <skos:definition xml:lang="en">The delivery channel used for exercising the action of the Rule.</skos:definition>
    <skos:definition xml:lang="es">El canal de entrega utilizado para ejercer la acción de la Regla.</skos:definition>
    <skos:definition xml:lang="ca">El canal de lliurament utilitzat per exercir l'acció de la Regla.</skos:definition>
    <skos:note xml:lang="en">Example: the asset may be distributed only on mobile networks.</skos:note>
    <skos:note xml:lang="es">Ejemplo: el activo solo puede distribuirse en redes móviles.</skos:note>
    <skos:note xml:lang="ca">Exemple: l'actiu només es pot distribuir en xarxes mòbils.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/derive">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Derive</rdfs:label>
    <rdfs:label xml:lang="es">Derivar</rdfs:label>
    <rdfs:label xml:lang="ca">Derivar</rdfs:label>
    <skos:definition xml:lang="en">To create a new derivative Asset from this Asset and to edit or modify the derivative.</skos:definition>
    <skos:definition xml:lang="es">Crear un nuevo Activo derivado de este Activo y editar o modificar el derivado.</skos:definition>
    <skos:definition xml:lang="ca">Crear un nou Actiu derivat d'aquest Actiu i editar o modificar el derivat.</skos:definition>
    <skos:note xml:lang="en">A new asset is created and may have significant overlaps with the original Asset. (Note that the notion of whether or not the change is significant enough to qualify as a new asset is subjective). To the derived Asset a next policy may be applied.</skos:note>
    <skos:note xml:lang="es">Se crea un nuevo activo y puede tener superposiciones significativas con el Activo original. (Tenga en cuenta que la noción de si el cambio es lo suficientemente significativo como para calificar como un nuevo activo es subjetiva). Al Activo derivado se le puede aplicar una política siguiente.</skos:note>
    <skos:note xml:lang="ca">Es crea un nou actiu i pot tenir superposicions significatives amb l'Actiu original. (Tingueu en compte que la noció de si el canvi és prou significatiu com per qualificar-lo com un nou actiu és subjectiva). A l'Actiu derivat se li pot aplicar una política següent.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/device">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Device</rdfs:label>
    <rdfs:label xml:lang="es">Dispositivo</rdfs:label>
    <rdfs:label xml:lang="ca">Dispositiu</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">An identified device used for exercising the action of the Rule.</skos:definition>
    <skos:definition xml:lang="es">Un dispositivo identificado utilizado para ejercer la acción de la Regla.</skos:definition>
    <skos:definition xml:lang="ca">Un dispositiu identificat utilitzat per exercir l'acció de la Regla.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.w3.org/ns/odrl/2/systemDevice"/>
    <skos:note>See System Device.</skos:note>
    <skos:note xml:lang="es">Ver Dispositivo del Sistema.</skos:note>
    <skos:note xml:lang="ca">Vegeu Dispositiu del Sistema.</skos:note>
  </LeftOperand>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/digitize">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Digitize</rdfs:label>
    <rdfs:label xml:lang="es">Digitalizar</rdfs:label>
    <rdfs:label xml:lang="ca">Digitalitzar</rdfs:label>
    <skos:definition xml:lang="en">To produce a digital copy of (or otherwise digitize) the Asset from its analogue form.</skos:definition>
    <skos:definition xml:lang="es">Producir una copia digital (o digitalizar de otro modo) del Activo a partir de su forma analógica.</skos:definition>
    <skos:definition xml:lang="ca">Produir una còpia digital (o digitalitzar d'una altra manera) de l'Actiu a partir de la seva forma analògica.</skos:definition>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/display">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Display</rdfs:label>
    <rdfs:label xml:lang="es">Mostrar</rdfs:label>
    <rdfs:label xml:lang="ca">Mostrar</rdfs:label>
    <skos:definition xml:lang="en">To create a static and transient rendition of an Asset.</skos:definition>
    <skos:definition xml:lang="es">Crear una representación estática y transitoria de un Activo.</skos:definition>
    <skos:definition xml:lang="ca">Crear una representació estàtica i transitòria d'un Actiu.</skos:definition>
    <skos:note xml:lang="en">For example, displaying an image on a screen. If the action is to be performed to a wider audience than just the Assignees, then the Recipient constraint is recommended to be used.</skos:note>
    <skos:note xml:lang="es">Por ejemplo, mostrar una imagen en una pantalla. Si la acción se va a realizar a una audiencia más amplia que solo los Cesionarios, se recomienda utilizar la restricción de Destinatario.</skos:note>
    <skos:note xml:lang="ca">Per exemple, mostrar una imatge en una pantalla. Si l'acció s'ha de realitzar a una audiència més àmplia que només els Cessionaris, es recomana utilitzar la restricció de Destinatari.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/play"/>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/distribute">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Distribute</rdfs:label>
    <rdfs:label xml:lang="es">Distribuir</rdfs:label>
    <rdfs:label xml:lang="ca">Distribuir</rdfs:label>
    <skos:definition xml:lang="en">To supply the Asset to third-parties.</skos:definition>
    <skos:definition xml:lang="es">Suministrar el Activo a terceros.</skos:definition>
    <skos:definition xml:lang="ca">Subministrar l'Actiu a tercers.</skos:definition>
    <skos:note xml:lang="en">It is recommended to use nextPolicy to express the allowable usages by third-parties.</skos:note>
    <skos:note xml:lang="es">Se recomienda usar nextPolicy para expresar los usos permitidos por terceros.</skos:note>
    <skos:note xml:lang="ca">Es recomana usar nextPolicy per expressar els usos permesos per tercers.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/duty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Permission"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Has Duty</rdfs:label>
    <rdfs:label xml:lang="es">Tiene Deber</rdfs:label>
    <rdfs:label xml:lang="ca">Té Deure</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Duty"/>
    <skos:definition xml:lang="en">Relates an individual Duty to a Permission.</skos:definition>
    <skos:definition xml:lang="es">Relaciona un Deber individual con un Permiso.</skos:definition>
    <skos:definition xml:lang="ca">Relaciona un Deure individual amb un Permís.</skos:definition>
    <skos:note xml:lang="en">A Duty is a pre-condition which must be fulfilled in order to receive the Permission.</skos:note>
    <skos:note xml:lang="es">Un Deber es una pre-condición que debe cumplirse para recibir el Permiso.</skos:note>
    <skos:note xml:lang="ca">Un Deure és una pre-condició que s'ha de complir per rebre el Permís.</skos:note>
  </rdf:Property>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/elapsedTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Elapsed Time</rdfs:label>
    <rdfs:label xml:lang="es">Tiempo Transcurrido</rdfs:label>
    <rdfs:label xml:lang="ca">Temps Transcorregut</rdfs:label>
    <skos:definition xml:lang="en">A continuous elapsed time period which may be used for exercising of the action of the Rule. Right operand value MUST be an xsd:duration as defined by [[xmlschema11-2]].</skos:definition>
    <skos:definition xml:lang="es">Un período de tiempo transcurrido continuo que puede usarse para ejercer la acción de la Regla. El valor del operando derecho DEBE ser un xsd:duration como se define en [[xmlschema11-2]].</skos:definition>
    <skos:definition xml:lang="ca">Un període de temps transcorregut continu que es pot usar per exercir l'acció de la Regla. El valor de l'operand dret HA DE ser un xsd:duration com es defineix a [[xmlschema11-2]].</skos:definition>
    <skos:note>Only the eq, lt, lteq operators SHOULD be used. See also Metered Time. &lt;br /&gt;Example: &lt;code&gt;elpasedTime eq P60M&lt;/code&gt; indicates a total elapsed time of 60 Minutes.</skos:note>
    <skos:note xml:lang="es">Solo se DEBEN usar los operadores eq, lt, lteq. Ver también Tiempo Medido. &lt;br /&gt;Ejemplo: &lt;code&gt;elpasedTime eq P60M&lt;/code&gt; indica un tiempo transcurrido total de 60 minutos.</skos:note>
    <skos:note xml:lang="ca">Només s'HAURIEN d'usar els operadors eq, lt, lteq. Vegeu també Temps Mesurat. &lt;br /&gt;Exemple: &lt;code&gt;elpasedTime eq P60M&lt;/code&gt; indica un temps transcorregut total de 60 minuts.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/ensureExclusivity">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Ensure Exclusivity</rdfs:label>
    <rdfs:label xml:lang="es">Asegurar Exclusividad</rdfs:label>
    <rdfs:label xml:lang="ca">Assegurar Exclusivitat</rdfs:label>
    <skos:definition xml:lang="en">To ensure that the Rule on the Asset is exclusive.</skos:definition>
    <skos:definition xml:lang="es">Asegurar que la Regla sobre el Activo es exclusiva.</skos:definition>
    <skos:definition xml:lang="ca">Assegurar que la Regla sobre l'Actiu és exclusiva.</skos:definition>
    <skos:note xml:lang="en">If used as a Duty, the assignee should be explicitly indicated as the party that is ensuring the exclusivity of the Rule.</skos:note>
    <skos:note xml:lang="es">Si se utiliza como un Deber, el cesionario debe indicarse explícitamente como la parte que asegura la exclusividad de la Regla.</skos:note>
    <skos:note xml:lang="ca">Si s'utilitza com un Deure, el cessionari s'ha d'indicar explícitament com la part que assegura l'exclusivitat de la Regla.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <Operator rdf:about="http://www.w3.org/ns/odrl/2/eq">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Equal to</rdfs:label>
    <rdfs:label xml:lang="es">Igual a</rdfs:label>
    <rdfs:label xml:lang="ca">Igual a</rdfs:label>
    <skos:definition xml:lang="en">Indicating that a given value equals the right operand of the Constraint.</skos:definition>
    <skos:definition xml:lang="es">Indica que un valor dado es igual al operando derecho de la Restricción.</skos:definition>
    <skos:definition xml:lang="ca">Indica que un valor donat és igual a l'operand dret de la Restricció.</skos:definition>
  </Operator>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/event">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Event</rdfs:label>
    <rdfs:label xml:lang="es">Evento</rdfs:label>
    <rdfs:label xml:lang="ca">Esdeveniment</rdfs:label>
    <skos:definition xml:lang="en">An identified event setting a context for exercising the action of the Rule.</skos:definition>
    <skos:definition xml:lang="es">Un evento identificado que establece un contexto para ejercer la acción de la Regla.</skos:definition>
    <skos:definition xml:lang="ca">Un esdeveniment identificat que estableix un context per exercir l'acció de la Regla.</skos:definition>
    <skos:note xml:lang="en">Events are temporal periods of time, and operators can be used to signal before (lt), during (eq) or after (gt) the event. &lt;br /&gt;Example: May be taken during the “FIFA World Cup 2020” only.</skos:note>
    <skos:note xml:lang="es">Los eventos son períodos de tiempo temporales, y los operadores se pueden usar para señalar antes (lt), durante (eq) o después (gt) del evento. &lt;br /&gt;Ejemplo: solo se puede tomar durante la "Copa Mundial de la FIFA 2020".</skos:note>
    <skos:note xml:lang="ca">Els esdeveniments són períodes de temps temporals, i els operadors es poden usar per assenyalar abans (lt), durant (eq) o després (gt) de l'esdeveniment. &lt;br /&gt;Exemple: només es pot prendre durant la "Copa del Món de la FIFA 2020".</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/execute">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Execute</rdfs:label>
    <rdfs:label xml:lang="es">Ejecutar</rdfs:label>
    <rdfs:label xml:lang="ca">Executar</rdfs:label>
    <skos:definition xml:lang="en">To run the computer program Asset.</skos:definition>
    <skos:definition xml:lang="es">Ejecutar el programa informático Activo.</skos:definition>
    <skos:definition xml:lang="ca">Executar el programa informàtic Actiu.</skos:definition>
    <skos:note xml:lang="en">For example, machine executable code or Java such as a game or application.</skos:note>
    <skos:note xml:lang="es">Por ejemplo, código ejecutable de máquina o Java, como un juego o una aplicación.</skos:note>
    <skos:note xml:lang="ca">Per exemple, codi executable de màquina o Java, com un joc o una aplicació.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/export">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Export</rdfs:label>
    <rdfs:label xml:lang="es">Exportar</rdfs:label>
    <rdfs:label xml:lang="ca">Exportar</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The act of transforming the asset into a new form.</skos:definition>
    <skos:definition xml:lang="es">El acto de transformar el activo en una nueva forma.</skos:definition>
    <skos:definition xml:lang="ca">L'acte de transformar l'actiu en una nova forma.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.w3.org/ns/odrl/2/transform"/>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/extract">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Extract</rdfs:label>
    <rdfs:label xml:lang="es">Extraer</rdfs:label>
    <rdfs:label xml:lang="ca">Extreure</rdfs:label>
    <skos:definition xml:lang="en">To extract parts of the Asset and to use it as a new Asset.</skos:definition>
    <skos:definition xml:lang="es">Extraer partes del Activo y usarlo como un nuevo Activo.</skos:definition>
    <skos:definition xml:lang="ca">Extreure parts de l'Actiu i usar-lo com un nou Actiu.</skos:definition>
    <skos:note xml:lang="en">A new asset is created and may have very little in common with the original Asset. (Note that the notion of whether or not the change is significant enough to qualify as a new asset is subjective). To the extracted Asset a next policy may be applied.</skos:note>
    <skos:note xml:lang="es">Se crea un nuevo activo y puede tener muy poco en común con el Activo original. (Tenga en cuenta que la noción de si el cambio es lo suficientemente significativo como para calificar como un nuevo activo es subjetiva). Al Activo extraído se le puede aplicar una política siguiente.</skos:note>
    <skos:note xml:lang="ca">Es crea un nou actiu i pot tenir molt poc en comú amb l'Actiu original. (Tingueu en compte que la noció de si el canvi és prou significatiu com per qualificar-lo com un nou actiu és subjectiva). A l'Actiu extret se li pot aplicar una política següent.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/reproduce"/>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/extractChar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Extract character</rdfs:label>
    <rdfs:label xml:lang="es">Extraer caracter</rdfs:label>
    <rdfs:label xml:lang="ca">Extreure caràcter</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The act of extracting (replicating) unchanged characters from the asset.</skos:definition>
    <skos:definition xml:lang="es">El acto de extraer (replicar) caracteres sin cambios del activo.</skos:definition>
    <skos:definition xml:lang="ca">L'acte d'extreure (replicar) caràcters sense canvis de l'actiu.</skos:definition>
    <skos:note xml:lang="en">This original term and URI from the ONIX specification should be used: http://www.editeur.org/onix-pl/extract-char .</skos:note>
    <skos:note xml:lang="es">Se debe utilizar este término y URI originales de la especificación ONIX: http://www.editeur.org/onix-pl/extract-char .</skos:note>
    <skos:note xml:lang="ca">S'ha d'utilitzar aquest terme i URI originals de l'especificació ONIX: http://www.editeur.org/onix-pl/extract-char .</skos:note>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/extractPage">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Extract page</rdfs:label>
    <rdfs:label xml:lang="es">Extraer página</rdfs:label>
    <rdfs:label xml:lang="ca">Extreure pàgina</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The act of extracting (replicating) unchanged pages from the asset.</skos:definition>
    <skos:definition xml:lang="es">El acto de extraer (replicar) páginas sin cambios del activo.</skos:definition>
    <skos:definition xml:lang="ca">L'acte d'extreure (replicar) pàgines sense canvis de l'actiu.</skos:definition>
    <skos:note xml:lang="en">This original term and URI from the ONIX specification should be used: http://www.editeur.org/onix-pl/extract-page .</skos:note>
    <skos:note xml:lang="es">Se debe utilizar este término y URI originales de la especificación ONIX: http://www.editeur.org/onix-pl/extract-page .</skos:note>
    <skos:note xml:lang="ca">S'ha d'utilitzar aquest terme i URI originals de l'especificació ONIX: http://www.editeur.org/onix-pl/extract-page .</skos:note>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/extractWord">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Extract word</rdfs:label>
    <rdfs:label xml:lang="es">Extraer palabra</rdfs:label>
    <rdfs:label xml:lang="ca">Extreure paraula</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The act of extracting (replicating) unchanged words from the asset.</skos:definition>
    <skos:definition xml:lang="es">El acto de extraer (replicar) palabras sin cambios del activo.</skos:definition>
    <skos:definition xml:lang="ca">L'acte d'extreure (replicar) paraules sense canvis de l'actiu.</skos:definition>
    <skos:note xml:lang="en">This original term and URI from the ONIX specification should be used: http://www.editeur.org/onix-pl/extract-word .</skos:note>
    <skos:note xml:lang="es">Se debe utilizar este término y URI originales de la especificación ONIX: http://www.editeur.org/onix-pl/extract-word .</skos:note>
    <skos:note xml:lang="ca">S'ha d'utilitzar aquest terme i URI originals de l'especificació ONIX: http://www.editeur.org/onix-pl/extract-word .</skos:note>
  </Action>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/failure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Rule"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Failure</rdfs:label>
    <rdfs:label xml:lang="es">Fallo</rdfs:label>
    <rdfs:label xml:lang="ca">Fallada</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Rule"/>
    <skos:definition xml:lang="en">Failure is an abstract property that defines the violation (or unmet) relationship between Rules.</skos:definition>
    <skos:definition xml:lang="es">Fallo es una propiedad abstracta que define la relación de violación (o incumplimiento) entre Reglas.</skos:definition>
    <skos:definition xml:lang="ca">Fallada és una propietat abstracta que defineix la relació de violació (o incompliment) entre Regles.</skos:definition>
    <skos:note xml:lang="en">The parent property to sub-properties that express explicit failure contexts.</skos:note>
    <skos:note xml:lang="es">La propiedad principal de las sub-propiedades que expresan contextos de fallo explícitos.</skos:note>
    <skos:note xml:lang="ca">La propietat principal de les sub-propietats que expressen contextos de fallada explícits.</skos:note>
  </rdf:Property>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/fileFormat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">File Format</rdfs:label>
    <rdfs:label xml:lang="es">Formato de Archivo</rdfs:label>
    <rdfs:label xml:lang="ca">Format de Fitxer</rdfs:label>
    <skos:definition xml:lang="en">A transformed file format of the target Asset.</skos:definition>
    <skos:definition xml:lang="es">Un formato de archivo transformado del Activo de destino.</skos:definition>
    <skos:definition xml:lang="ca">Un format de fitxer transformat de l'Actiu de destinació.</skos:definition>
    <skos:note xml:lang="en">Example: An asset may be transformed into JPEG format.</skos:note>
    <skos:note xml:lang="es">Ejemplo: Un activo puede transformarse a formato JPEG.</skos:note>
    <skos:note xml:lang="ca">Exemple: Un actiu pot transformar-se a format JPEG.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/function">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf>
          <rdf:Description>
            <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Rule"/>
            <rdf:rest>
              <rdf:Description>
                <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
              </rdf:Description>
            </rdf:rest>
          </rdf:Description>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Function</rdfs:label>
    <rdfs:label xml:lang="es">Función</rdfs:label>
    <rdfs:label xml:lang="ca">Funció</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Party"/>
    <skos:definition xml:lang="en">Function is an abstract property whose sub-properties define the functional roles which may be fulfilled by a party in relation to a Rule.</skos:definition>
    <skos:definition xml:lang="es">Función es una propiedad abstracta cuyas sub-propiedades definen los roles funcionales que puede cumplir una parte en relación con una Regla.</skos:definition>
    <skos:definition xml:lang="ca">Funció és una propietat abstracta les sub-propietats de la qual defineixen els rols funcionals que pot complir una part en relació amb una Regla.</skos:definition>
  </rdf:Property>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/give">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Give</rdfs:label>
    <rdfs:label xml:lang="es">Dar</rdfs:label>
    <rdfs:label xml:lang="ca">Donar</rdfs:label>
    <skos:definition xml:lang="en">To transfer the ownership of the Asset to a third party without compensation and while deleting the original asset.</skos:definition>
    <skos:definition xml:lang="es">Transferir la propiedad del Activo a un tercero sin compensación y eliminando el activo original.</skos:definition>
    <skos:definition xml:lang="ca">Transferir la propietat de l'Actiu a un tercer sense compensació i eliminant l'actiu original.</skos:definition>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/transfer"/>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/grantUse">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Grant Use</rdfs:label>
    <rdfs:label xml:lang="es">Conceder Uso</rdfs:label>
    <rdfs:label xml:lang="ca">Concedir Ús</rdfs:label>
    <skos:definition xml:lang="en">To grant the use of the Asset to third parties.</skos:definition>
    <skos:definition xml:lang="es">Conceder el uso del Activo a terceros.</skos:definition>
    <skos:definition xml:lang="ca">Concedir l'ús de l'Actiu a tercers.</skos:definition>
    <skos:note xml:lang="en">This action enables the assignee to create policies for the use of the Asset for third parties. The nextPolicy is recommended to be agreed with the third party. Use of temporal constraints is recommended.</skos:note>
    <skos:note xml:lang="es">Esta acción permite al cesionario crear políticas para el uso del Activo por parte de terceros. Se recomienda que la nextPolicy se acuerde con el tercero. Se recomienda el uso de restricciones temporales.</skos:note>
    <skos:note xml:lang="ca">Aquesta acció permet al cessionari crear polítiques per a l'ús de l'Actiu per part de tercers. Es recomana que la nextPolicy s'acordi amb el tercer. Es recomana l'ús de restriccions temporals.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <Operator rdf:about="http://www.w3.org/ns/odrl/2/gt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Greater than</rdfs:label>
    <rdfs:label xml:lang="es">Mayor que</rdfs:label>
    <rdfs:label xml:lang="ca">Més gran que</rdfs:label>
    <skos:definition xml:lang="en">Indicating that a given value is greater than the right operand of the Constraint.</skos:definition>
    <skos:definition xml:lang="es">Indica que un valor dado es mayor que el operando derecho de la Restricción.</skos:definition>
    <skos:definition xml:lang="ca">Indica que un valor donat és més gran que l'operand dret de la Restricció.</skos:definition>
  </Operator>
  <Operator rdf:about="http://www.w3.org/ns/odrl/2/gteq">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Greater than or equal to</rdfs:label>
    <rdfs:label xml:lang="es">Mayor o igual que</rdfs:label>
    <rdfs:label xml:lang="ca">Més gran o igual que</rdfs:label>
    <skos:definition xml:lang="en">Indicating that a given value is greater than or equal to the right operand of the Constraint.</skos:definition>
    <skos:definition xml:lang="es">Indica que un valor dado es mayor o igual que el operando derecho de la Restricción.</skos:definition>
    <skos:definition xml:lang="ca">Indica que un valor donat és més gran o igual que l'operand dret de la Restricció.</skos:definition>
  </Operator>
  <Operator rdf:about="http://www.w3.org/ns/odrl/2/hasPart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Has part</rdfs:label>
    <rdfs:label xml:lang="es">Tiene parte</rdfs:label>
    <rdfs:label xml:lang="ca">Té part</rdfs:label>
    <skos:definition xml:lang="en">A set-based operator indicating that a given value contains the right operand of the Constraint.</skos:definition>
    <skos:definition xml:lang="es">Un operador basado en conjuntos que indica que un valor dado contiene el operando derecho de la Restricción.</skos:definition>
    <skos:definition xml:lang="ca">Un operador basat en conjunts que indica que un valor donat conté l'operand dret de la Restricció.</skos:definition>
  </Operator>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/hasPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Asset"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Target Policy</rdfs:label>
    <rdfs:label xml:lang="es">Política de Destino</rdfs:label>
    <rdfs:label xml:lang="ca">Política de Destinació</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
    <skos:definition xml:lang="en">Identifies an ODRL Policy for which the identified Asset is the target Asset to all the Rules.</skos:definition>
    <skos:definition xml:lang="es">Identifica una Política ODRL para la cual el Activo identificado es el Activo de destino para todas las Reglas.</skos:definition>
    <skos:definition xml:lang="ca">Identifica una Política ODRL per a la qual l'Actiu identificat és l'Actiu de destinació per a totes les Regles.</skos:definition>
    <skos:note xml:lang="en">The Asset being identified MUST be inferred to be the target Asset of all of the Rules of the Policy.</skos:note>
    <skos:note xml:lang="es">El Activo que se está identificando DEBE inferirse como el Activo de destino de todas las Reglas de la Política.</skos:note>
    <skos:note xml:lang="ca">L'Actiu que s'està identificant HA D'inferir-se com l'Actiu de destinació de totes les Regles de la Política.</skos:note>
  </rdf:Property>
  <UndefinedTerm rdf:about="http://www.w3.org/ns/odrl/2/ignore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Ignore Undefined Actions</rdfs:label>
    <rdfs:label xml:lang="es">Ignorar Acciones Indefinidas</rdfs:label>
    <rdfs:label xml:lang="ca">Ignorar Accions Indefinides</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The Action is to be ignored and is not part of the policy – and the policy remains valid.</skos:definition>
    <skos:definition xml:lang="es">La Acción debe ser ignorada y no forma parte de la política, y la política sigue siendo válida.</skos:definition>
    <skos:definition xml:lang="ca">L'Acció ha de ser ignorada i no forma part de la política, i la política continua sent vàlida.</skos:definition>
    <skos:note xml:lang="en">Used to support actions not known to the policy system.</skos:note>
    <skos:note xml:lang="es">Se utiliza para admitir acciones no conocidas por el sistema de políticas.</skos:note>
    <skos:note xml:lang="ca">S'utilitza per admetre accions no conegudes pel sistema de polítiques.</skos:note>
  </UndefinedTerm>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/implies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Action"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Implies</rdfs:label>
    <rdfs:label xml:lang="es">Implica</rdfs:label>
    <rdfs:label xml:lang="ca">Implica</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Action"/>
    <skos:definition xml:lang="en">An Action asserts that another Action is not prohibited to enable its operational semantics.</skos:definition>
    <skos:definition xml:lang="es">Una Acción afirma que otra Acción no está prohibida para habilitar su semántica operativa.</skos:definition>
    <skos:definition xml:lang="ca">Una Acció afirma que una altra Acció no està prohibida per habilitar la seva semàntica operativa.</skos:definition>
    <skos:note xml:lang="en">The property asserts that an instance of Action entails that the other instance of Action is not prohibited.</skos:note>
    <skos:note xml:lang="es">La propiedad afirma que una instancia de Acción implica que la otra instancia de Acción no está prohibida.</skos:note>
    <skos:note xml:lang="ca">La propietat afirma que una instància d'Acció implica que l'altra instància d'Acció no està prohibida.</skos:note>
  </rdf:Property>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/include">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Include</rdfs:label>
    <rdfs:label xml:lang="es">Incluir</rdfs:label>
    <rdfs:label xml:lang="ca">Incloure</rdfs:label>
    <skos:definition xml:lang="en">To include other related assets in the Asset.</skos:definition>
    <skos:definition xml:lang="es">Incluir otros activos relacionados en el Activo.</skos:definition>
    <skos:definition xml:lang="ca">Incloure altres actius relacionats a l'Actiu.</skos:definition>
    <skos:note xml:lang="en">For example: bio picture must be included in the attribution. Use of a relation sub-property is required for the related assets.</skos:note>
    <skos:note xml:lang="es">Por ejemplo: la foto de la biografía debe incluirse en la atribución. Se requiere el uso de una subpropiedad de relación para los activos relacionados.</skos:note>
    <skos:note xml:lang="ca">Per exemple: la foto de la biografia s'ha d'incloure a l'atribució. Es requereix l'ús d'una subpropietat de relació per als actius relacionats.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/includedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Action"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Included In</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Action"/>
    <skos:definition xml:lang="en">An Action transitively asserts that another Action that encompasses its operational semantics.</skos:definition>
    <skos:note xml:lang="en">The purpose is to explicitly assert that the semantics of the referenced instance of an other Action encompasses (includes) the semantics of this instance of Action. The includedIn property is transitive, and as such, the Actions form ancestor relationships.</skos:note>
  </rdf:Property>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/index">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Index</rdfs:label>
    <rdfs:label xml:lang="es">Indexar</rdfs:label>
    <rdfs:label xml:lang="ca">Indexar</rdfs:label>
    <skos:definition xml:lang="en">To record the Asset in an index.</skos:definition>
    <skos:definition xml:lang="es">Registrar el Activo en un índice.</skos:definition>
    <skos:definition xml:lang="ca">Registrar l'Actiu en un índex.</skos:definition>
    <skos:note xml:lang="en">For example, to include a link to the Asset in a search engine database.</skos:note>
    <skos:note xml:lang="es">Por ejemplo, incluir un enlace al Activo en una base de datos de un motor de búsqueda.</skos:note>
    <skos:note xml:lang="ca">Per exemple, incloure un enllaç a l'Actiu en una base de dades d'un motor de cerca.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
    </Action>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/industry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Industry Context</rdfs:label>
    <rdfs:label xml:lang="es">Contexto de la Industria</rdfs:label>
    <rdfs:label xml:lang="ca">Context de la Indústria</rdfs:label>
    <skos:definition xml:lang="en">A defined industry sector setting a context for exercising the action of the Rule.</skos:definition>
    <skos:definition xml:lang="es">Un sector industrial definido que establece un contexto para ejercer la acción de la Regla.</skos:definition>
    <skos:definition xml:lang="ca">Un sector industrial definit que estableix un context per exercir l'acció de la Regla.</skos:definition>
    <skos:note xml:lang="en">Example: publishing or financial industry.</skos:note>
    <skos:note xml:lang="es">Ejemplo: la industria editorial o la financiera.</skos:note>
    <skos:note xml:lang="ca">Exemple: la indústria editorial o la financera.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/inform">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Inform</rdfs:label>
    <rdfs:label xml:lang="es">Informar</rdfs:label>
    <rdfs:label xml:lang="ca">Informar</rdfs:label>
    <skos:definition xml:lang="en">To inform that an action has been performed on or in relation to the Asset.</skos:definition>
    <skos:definition xml:lang="es">Informar de que se ha realizado una acción sobre el Activo o en relación con él.</skos:definition>
    <skos:definition xml:lang="ca">Informar que s'ha realitzat una acció sobre l'Actiu o en relació amb aquest.</skos:definition>
    <skos:note xml:lang="en">May link to a Party with the role 'informedParty' function.</skos:note>
    <skos:note xml:lang="es">Puede vincularse a una Parte con la función de rol 'informedParty'.</skos:note>
    <skos:note xml:lang="ca">Pot vincular-se a una Part amb la funció de rol 'informedParty'.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/informedParty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Informed Party</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/function"/>
    <skos:definition xml:lang="en">The Party to be informed of all uses.</skos:definition>
    <skos:note xml:lang="en">Maybe specified as part of the inform action.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/informingParty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Informing Party</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/function"/>
    <skos:definition xml:lang="en">The Party who provides the inform use data.</skos:definition>
    <skos:note xml:lang="en">Maybe specified as part of the inform action.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/inheritAllowed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Inheritance Allowed</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">Indicates if the Policy entity can be inherited.</skos:definition>
    <skos:note xml:lang="en">A boolean value.</skos:note>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/inheritFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Inherits From</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
    <skos:definition xml:lang="en">Relates a (child) policy to another (parent) policy from which terms are inherited.</skos:definition>
    <skos:note xml:lang="en">The child policy will inherit Rules from the parent policy</skos:note>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/inheritRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Inherit Relation</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">Indentifies the type of inheritance.</skos:definition>
    <skos:note xml:lang="en">For example, this may indicate the business scenario, such as subscription, or prior arrangements between the parties (that are not machine representable).</skos:note>
  </rdf:Property>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/install">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Install</rdfs:label>
    <rdfs:label xml:lang="es">Instalar</rdfs:label>
    <rdfs:label xml:lang="ca">Instal·lar</rdfs:label>
    <skos:definition xml:lang="en">To load the computer program Asset onto a storage device which allows operating or running the Asset.</skos:definition>
    <skos:definition xml:lang="es">Cargar el Activo de programa informático en un dispositivo de almacenamiento que permita operar o ejecutar el Activo.</skos:definition>
    <skos:definition xml:lang="ca">Carregar l'Actiu de programa informàtic en un dispositiu d'emmagatzematge que permeti operar o executar l'Actiu.</skos:definition>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <ConflictTerm rdf:about="http://www.w3.org/ns/odrl/2/invalid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Void Policy</rdfs:label>
    <skos:definition xml:lang="en">The policy is void.</skos:definition>
    <skos:note xml:lang="en">Used to indicate the policy is void for Conflict Strategy.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
  </ConflictTerm>
  <Operator rdf:about="http://www.w3.org/ns/odrl/2/isA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Is a</rdfs:label>
    <rdfs:label xml:lang="es">Es un</rdfs:label>
    <rdfs:label xml:lang="ca">És un</rdfs:label>
    <skos:definition xml:lang="en">A set-based operator indicating that a given value is an instance of the right operand of the Constraint.</skos:definition>
    <skos:definition xml:lang="es">Un operador basado en conjuntos que indica que un valor dado es una instancia del operando derecho de la Restricción.</skos:definition>
    <skos:definition xml:lang="ca">Un operador basat en conjunts que indica que un valor donat és una instància de l'operand dret de la Restricció.</skos:definition>
  </Operator>
  <Operator rdf:about="http://www.w3.org/ns/odrl/2/isAllOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Is all of</rdfs:label>
    <rdfs:label xml:lang="es">Es todo de</rdfs:label>
    <rdfs:label xml:lang="ca">És tot de</rdfs:label>
    <skos:definition xml:lang="en">A set-based operator indicating that a given value is all of the right operand of the Constraint.</skos:definition>
    <skos:definition xml:lang="es">Un operador basado en conjuntos que indica que un valor dado es todo el operando derecho de la Restricción.</skos:definition>
    <skos:definition xml:lang="ca">Un operador basat en conjunts que indica que un valor donat és tot l'operand dret de la Restricció.</skos:definition>
  </Operator>
  <Operator rdf:about="http://www.w3.org/ns/odrl/2/isAnyOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Is any of</rdfs:label>
    <rdfs:label xml:lang="es">Es cualquiera de</rdfs:label>
    <rdfs:label xml:lang="ca">És qualsevol de</rdfs:label>
    <skos:definition xml:lang="en">A set-based operator indicating that a given value is any of the right operand of the Constraint.</skos:definition>
    <skos:definition xml:lang="es">Un operador basado en conjuntos que indica que un valor dado es cualquiera del operando derecho de la Restricción.</skos:definition>
    <skos:definition xml:lang="ca">Un operador basat en conjunts que indica que un valor donat és qualsevol de l'operand dret de la Restricció.</skos:definition>
  </Operator>
  <Operator rdf:about="http://www.w3.org/ns/odrl/2/isNoneOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Is none of</rdfs:label>
    <rdfs:label xml:lang="es">No es ninguno de</rdfs:label>
    <rdfs:label xml:lang="ca">No és cap de</rdfs:label>
    <skos:definition xml:lang="en">A set-based operator indicating that a given value is none of the right operand of the Constraint.</skos:definition>
    <skos:definition xml:lang="es">Un operador basado en conjuntos que indica que un valor dado no es ninguno del operando derecho de la Restricción.</skos:definition>
    <skos:definition xml:lang="ca">Un operador basat en conjunts que indica que un valor donat no és cap de l'operand dret de la Restricció.</skos:definition>
  </Operator>
  <Operator rdf:about="http://www.w3.org/ns/odrl/2/isPartOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Is part of</rdfs:label>
    <rdfs:label xml:lang="es">Es parte de</rdfs:label>
    <rdfs:label xml:lang="ca">És part de</rdfs:label>
    <skos:definition xml:lang="en">A set-based operator indicating that a given value is contained by the right operand of the Constraint.</skos:definition>
    <skos:definition xml:lang="es">Un operador basado en conjuntos que indica que un valor dado está contenido por el operando derecho de la Restricción.</skos:definition>
    <skos:definition xml:lang="ca">Un operador basat en conjunts que indica que un valor donat està contingut per l'operand dret de la Restricció.</skos:definition>
  </Operator>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/language">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Language</rdfs:label>
    <rdfs:label xml:lang="es">Idioma</rdfs:label>
    <rdfs:label xml:lang="ca">Idioma</rdfs:label>
    <skos:definition xml:lang="en">A natural language used by the target Asset.</skos:definition>
    <skos:definition xml:lang="es">Un idioma natural utilizado por el Activo de destino.</skos:definition>
    <skos:definition xml:lang="ca">Un idioma natural utilitzat per l'Actiu de destinació.</skos:definition>
    <skos:note xml:lang="en">Example: the asset can only be translated into Greek. Must use [[bcp47]] codes for language values.</skos:note>
    <skos:note xml:lang="es">Ejemplo: el activo solo puede traducirse al griego. Deben utilizarse códigos [[bcp47]] para los valores de idioma.</skos:note>
    <skos:note xml:lang="ca">Exemple: l'actiu només es pot traduir al grec. S'han d'utilitzar codis [[bcp47]] per als valors d'idioma.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/lease">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Lease</rdfs:label>
    <rdfs:label xml:lang="es">Arrendar</rdfs:label>
    <rdfs:label xml:lang="ca">Arrendar</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The act of making available the asset to a third-party for a fixed period of time with exchange of value.</skos:definition>
    <skos:definition xml:lang="es">El acto de poner el activo a disposición de un tercero durante un período de tiempo fijo a cambio de un valor.</skos:definition>
    <skos:definition xml:lang="ca">L'acte de posar l'actiu a disposició d'un tercer durant un període de temps fix a canvi d'un valor.</skos:definition>
  </Action>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/leftOperand">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Constraint"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Has Left Operand</rdfs:label>
    <rdfs:label xml:lang="es">Tiene Operando Izquierdo</rdfs:label>
    <rdfs:label xml:lang="ca">Té Operand Esquerre</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/LeftOperand"/>
    <skos:definition xml:lang="en">The left operand in a constraint expression.</skos:definition>
    <skos:definition xml:lang="es">El operando izquierdo en una expresión de restricción.</skos:definition>
    <skos:definition xml:lang="ca">L'operand esquerre en una expressió de restricció.</skos:definition>
  </rdf:Property>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/lend">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Lend</rdfs:label>
    <rdfs:label xml:lang="es">Prestar</rdfs:label>
    <rdfs:label xml:lang="ca">Prestar</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The act of making available the asset to a third-party for a fixed period of time without exchange of value.</skos:definition>
    <skos:definition xml:lang="es">El acto de poner a disposición el activo a un tercero por un período de tiempo fijo sin intercambio de valor.</skos:definition>
    <skos:definition xml:lang="ca">L'acte de posar a disposició l'actiu a un tercer per un període de temps fix sense intercanvi de valor.</skos:definition>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/license">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">License</rdfs:label>
    <rdfs:label xml:lang="es">Licenciar</rdfs:label>
    <rdfs:label xml:lang="ca">Llicenciar</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The act of granting the right to use the asset to a third-party.</skos:definition>
    <skos:definition xml:lang="es">El acto de conceder el derecho de uso del activo a un tercero.</skos:definition>
    <skos:definition xml:lang="ca">L'acte de concedir el dret d'ús de l'actiu a un tercer.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.w3.org/ns/odrl/2/grantUse"/>
  </Action>
  <Operator rdf:about="http://www.w3.org/ns/odrl/2/lt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Less than</rdfs:label>
    <rdfs:label xml:lang="es">Menor que</rdfs:label>
    <rdfs:label xml:lang="ca">Menys que</rdfs:label>
    <skos:definition xml:lang="en">Indicating that a given value is less than the right operand of the Constraint.</skos:definition>
    <skos:definition xml:lang="es">Indica que un valor dado es menor que el operando derecho de la Restricción.</skos:definition>
    <skos:definition xml:lang="ca">Indica que un valor donat és menor que l'operand dret de la Restricció.</skos:definition>
  </Operator>
  <Operator rdf:about="http://www.w3.org/ns/odrl/2/lteq">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Less than or equal to</rdfs:label>
    <rdfs:label xml:lang="es">Menor o igual que</rdfs:label>
    <rdfs:label xml:lang="ca">Menys o igual que</rdfs:label>
    <skos:definition xml:lang="en">Indicating that a given value is less than or equal to the right operand of the Constraint.</skos:definition>
    <skos:definition xml:lang="es">Indica que un valor dado es menor o igual que el operando derecho de la Restricción.</skos:definition>
    <skos:definition xml:lang="ca">Indica que un valor donat és menor o igual que l'operand dret de la Restricció.</skos:definition>
  </Operator>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/media">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Media Context</rdfs:label>
    <rdfs:label xml:lang="es">Contexto de Medios</rdfs:label>
    <rdfs:label xml:lang="ca">Context de Mitjans</rdfs:label>
    <skos:definition xml:lang="en">Category of a media asset setting a context for exercising the action of the Rule.</skos:definition>
    <skos:definition xml:lang="es">Categoría de un activo de medios que establece un contexto para ejercer la acción de la Regla.</skos:definition>
    <skos:definition xml:lang="ca">Categoria d'un actiu de mitjans que estableix un context per exercir l'acció de la Regla.</skos:definition>
    <skos:note xml:lang="en">Example media types: electronic, print, advertising, marketing. Note: The used type should not be an IANA MediaType as they are focused on technical characteristics. </skos:note>
    <skos:note xml:lang="es">Ejemplos de tipos de medios: electrónico, impreso, publicidad, marketing. Nota: El tipo utilizado no debe ser un MediaType de IANA, ya que se centran en características técnicas.</skos:note>
    <skos:note xml:lang="ca">Exemples de tipus de mitjans: electrònic, imprès, publicitat, màrqueting. Nota: El tipus utilitzat no ha de ser un MediaType d'IANA, ja que se centren en característiques tècniques.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/meteredTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Metered Time</rdfs:label>
    <rdfs:label xml:lang="es">Tiempo Medido</rdfs:label>
    <rdfs:label xml:lang="ca">Temps Mesurat</rdfs:label>
    <skos:definition xml:lang="en">An accumulated amount of one to many metered time periods which were used for exercising the action of the Rule. Right operand value MUST be an xsd:duration as defined by [[xmlschema11-2]].</skos:definition>
    <skos:definition xml:lang="es">Una cantidad acumulada de uno a muchos períodos de tiempo medidos que se utilizaron para ejercer la acción de la Regla. El valor del operando derecho DEBE ser un xsd:duration como se define en [[xmlschema11-2]].</skos:definition>
    <skos:definition xml:lang="ca">Una quantitat acumulada d'un a molts períodes de temps mesurats que es van utilitzar per exercir l'acció de la Regla. El valor de l'operand dret HA DE ser un xsd:duration com es defineix a [[xmlschema11-2]].</skos:definition>
    <skos:note>Only the eq, lt, lteq operators SHOULD be used. See also Elapsed Time. &lt;br /&gt;Example: &lt;code&gt;meteredTime lteq P60M&lt;/code&gt; indicates an accumulated period of 60 Minutes or less.</skos:note>
    <skos:note xml:lang="es">Solo se DEBEN usar los operadores eq, lt, lteq. Ver también Tiempo Transcurrido. &lt;br /&gt;Ejemplo: &lt;code&gt;meteredTime lteq P60M&lt;/code&gt; indica un período acumulado de 60 minutos o menos.</skos:note>
    <skos:note xml:lang="ca">Només s'HAURIEN d'usar els operadors eq, lt, lteq. Vegeu també Temps Transcorregut. &lt;br /&gt;Exemple: &lt;code&gt;meteredTime lteq P60M&lt;/code&gt; indica un període acumulat de 60 minuts o menys.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/modify">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Modify</rdfs:label>
    <rdfs:label xml:lang="es">Modificar</rdfs:label>
    <rdfs:label xml:lang="ca">Modificar</rdfs:label>
    <skos:definition xml:lang="en">To change existing content of the Asset. A new asset is not created by this action.</skos:definition>
    <skos:definition xml:lang="es">Cambiar el contenido existente del Activo. No se crea un nuevo activo con esta acción.</skos:definition>
    <skos:definition xml:lang="ca">Canviar el contingut existent de l'Actiu. No es crea un nou actiu amb aquesta acció.</skos:definition>
    <skos:note xml:lang="en">This action will modify an asset which is typically updated from time to time without creating a new asset. If the result from modifying the asset should be a new asset the actions derive or extract should be used. (Note that the notion of whether or not the change is significant enough to qualify as a new asset is subjective).</skos:note>
    <skos:note xml:lang="es">Esta acción modificará un activo que normalmente se actualiza de vez en cuando sin crear un nuevo activo. Si el resultado de modificar el activo debe ser un nuevo activo, se deben usar las acciones derivar o extraer. (Tenga en cuenta que la noción de si el cambio es lo suficientemente significativo como para calificar como un nuevo activo es subjetiva).</skos:note>
    <skos:note xml:lang="ca">Aquesta acció modificarà un actiu que normalment s'actualitza de tant en tant sense crear un nou actiu. Si el resultat de modificar l'actiu ha de ser un nou actiu, s'han d'usar les accions derivar o extreure. (Tingueu en compte que la noció de si el canvi és prou significatiu com per qualificar-lo com un nou actiu és subjectiva).</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/move">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Move</rdfs:label>
    <rdfs:label xml:lang="es">Mover</rdfs:label>
    <rdfs:label xml:lang="ca">Moure</rdfs:label>
    <skos:definition xml:lang="en">To move the Asset from one digital location to another including deleting the original copy.</skos:definition>
    <skos:definition xml:lang="es">Mover el Activo de una ubicación digital a otra, incluida la eliminación de la copia original.</skos:definition>
    <skos:definition xml:lang="ca">Moure l'Actiu d'una ubicació digital a una altra, inclosa l'eliminació de la còpia original.</skos:definition>
    <skos:note xml:lang="en">After the Asset has been moved, the original copy must be deleted.</skos:note>
    <skos:note xml:lang="es">Después de mover el Activo, se debe eliminar la copia original.</skos:note>
    <skos:note xml:lang="ca">Després de moure l'Actiu, s'ha d'eliminar la còpia original.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <Operator rdf:about="http://www.w3.org/ns/odrl/2/neq">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Not equal to</rdfs:label>
    <rdfs:label xml:lang="es">No igual a</rdfs:label>
    <rdfs:label xml:lang="ca">No igual a</rdfs:label>
    <skos:definition xml:lang="en">Indicating that a given value is not equal to the right operand of the Constraint.</skos:definition>
    <skos:definition xml:lang="es">Indica que un valor dado no es igual al operando derecho de la Restricción.</skos:definition>
    <skos:definition xml:lang="ca">Indica que un valor donat no és igual a l'operand dret de la Restricció.</skos:definition>
  </Operator>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/nextPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Next Policy</rdfs:label>
    <rdfs:label xml:lang="es">Siguiente Política</rdfs:label>
    <rdfs:label xml:lang="ca">Següent Política</rdfs:label>
    <skos:definition xml:lang="en">To grant the specified Policy to a third party for their use of the Asset.</skos:definition>
    <skos:definition xml:lang="es">Conceder la Política especificada a un tercero para su uso del Activo.</skos:definition>
    <skos:definition xml:lang="ca">Concedir la Política especificada a un tercer per al seu ús de l'Actiu.</skos:definition>
    <skos:note xml:lang="en">Useful for downstream policies.</skos:note>
    <skos:note xml:lang="es">Útil para políticas posteriores.</skos:note>
    <skos:note xml:lang="ca">Útil per a polítiques posteriors.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/obligation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Obligation</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Duty"/>
    <skos:definition xml:lang="en">Relates an individual Duty to a Policy.</skos:definition>
    <skos:note xml:lang="en">The Duty is a requirement which must be fulfilled.</skos:note>
  </rdf:Property>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/obtainConsent">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Obtain Consent</rdfs:label>
    <rdfs:label xml:lang="es">Obtener Consentimiento</rdfs:label>
    <rdfs:label xml:lang="ca">Obtenir Consentiment</rdfs:label>
    <skos:definition xml:lang="en">To obtain verifiable consent to perform the requested action in relation to the Asset.</skos:definition>
    <skos:definition xml:lang="es">Obtener un consentimiento verificable para realizar la acción solicitada en relación con el Activo.</skos:definition>
    <skos:definition xml:lang="ca">Obtenir un consentiment verificable per realitzar l'acció sol·licitada en relació amb l'Actiu.</skos:definition>
    <skos:note xml:lang="en">May be used as a Duty to ensure that the Assigner or a Party is authorized to approve such actions on a case-by-case basis. May link to a Party with the role “consentingParty” function.</skos:note>
    <skos:note xml:lang="es">Puede usarse como un Deber para garantizar que el Asignador o una Parte estén autorizados para aprobar tales acciones caso por caso. Puede vincularse a una Parte con la función de rol “consentingParty”.</skos:note>
    <skos:note xml:lang="ca">Es pot usar com un Deure per garantir que l'Assignador o una Part estiguin autoritzats per aprovar aquestes accions cas per cas. Pot vincular-se a una Part amb la funció de rol “consentingParty”.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/operand">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/LogicalConstraint"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Operand</rdfs:label>
    <rdfs:label xml:lang="es">Operando</rdfs:label>
    <rdfs:label xml:lang="ca">Operand</rdfs:label>
    <skos:definition xml:lang="en">Operand is an abstract property for a logical relationship.</skos:definition>
    <skos:definition xml:lang="es">Operando es una propiedad abstracta para una relación lógica.</skos:definition>
    <skos:definition xml:lang="ca">Operand és una propietat abstracta per a una relació lògica.</skos:definition>
    <skos:note xml:lang="en">Sub-properties of operand are used for Logical Constraints.</skos:note>
    <skos:note xml:lang="es">Las sub-propiedades de operando se utilizan para Restricciones Lógicas.</skos:note>
    <skos:note xml:lang="ca">Les sub-propietats d'operand s'utilitzen per a Restriccions Lògiques.</skos:note>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/operator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Constraint"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Has Operator</rdfs:label>
    <rdfs:label xml:lang="es">Tiene Operador</rdfs:label>
    <rdfs:label xml:lang="ca">Té Operador</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Operator"/>
    <skos:definition xml:lang="en">The operator function applied to operands of a Constraint</skos:definition>
    <skos:definition xml:lang="es">La función de operador aplicada a los operandos de una Restricción</skos:definition>
    <skos:definition xml:lang="ca">La funció d'operador aplicada als operands d'una Restricció</skos:definition>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/or">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Or</rdfs:label>
    <rdfs:label xml:lang="es">O</rdfs:label>
    <rdfs:label xml:lang="ca">O</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/operand"/>
    <skos:definition xml:lang="en">The relation is satisfied when at least one of the Constraints is satisfied.</skos:definition>
    <skos:definition xml:lang="es">La relación se satisface cuando se cumple al menos una de las Restricciones.</skos:definition>
    <skos:definition xml:lang="ca">La relació se satisfà quan es compleix almenys una de les Restriccions.</skos:definition>
    <skos:note xml:lang="en">This property MUST only be used for Logical Constraints, and the list of operand values MUST be Constraint instances.</skos:note>
    <skos:note xml:lang="es">Esta propiedad SÓLO DEBE usarse para Restricciones Lógicas, y la lista de valores de operando DEBE ser instancias de Restricción.</skos:note>
    <skos:note xml:lang="ca">Aquesta propietat NOMÉS S'HA d'usar per a Restriccions Lògiques, i la llista de valors d'operand HA DE ser instàncies de Restricció.</skos:note>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/output">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Rule"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Output</rdfs:label>
    <rdfs:label xml:lang="es">Salida</rdfs:label>
    <rdfs:label xml:lang="ca">Sortida</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Asset"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/relation"/>
    <skos:definition xml:lang="en">The output property specifies the Asset which is created from the output of the Action.</skos:definition>
    <skos:definition xml:lang="es">La propiedad de salida especifica el Activo que se crea a partir de la salida de la Acción.</skos:definition>
    <skos:definition xml:lang="ca">La propietat de sortida especifica l'Actiu que es crea a partir de la sortida de l'Acció.</skos:definition>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/partOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf>
          <rdf:Description>
            <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Asset"/>
            <rdf:rest>
              <rdf:Description>
                <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Party"/>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
              </rdf:Description>
            </rdf:rest>
          </rdf:Description>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Part Of</rdfs:label>
    <rdfs:label xml:lang="es">Parte de</rdfs:label>
    <rdfs:label xml:lang="ca">Part de</rdfs:label>
    <rdfs:range>
      <owl:Class>
        <owl:unionOf>
          <rdf:Description>
            <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/AssetCollection"/>
            <rdf:rest>
              <rdf:Description>
                <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/PartyCollection"/>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
              </rdf:Description>
            </rdf:rest>
          </rdf:Description>
        </owl:unionOf>
      </owl:Class>
    </rdfs:range>
    <skos:definition xml:lang="en">Identifies an Asset/PartyCollection that the Asset/Party is a member of.</skos:definition>
    <skos:definition xml:lang="es">Identifica una Colección de Activos/Partes de la que el Activo/Parte es miembro.</skos:definition>
    <skos:definition xml:lang="ca">Identifica una Col·lecció d'Actius/Parts de la qual l'Actiu/Part és membre.</skos:definition>
  </rdf:Property>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/pay">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Pay</rdfs:label>
    <rdfs:label xml:lang="es">Pagar</rdfs:label>
    <rdfs:label xml:lang="ca">Pagar</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The act of paying a financial amount to a party for use of the asset.</skos:definition>
    <skos:definition xml:lang="es">El acto de pagar una cantidad financiera a una parte por el uso del activo.</skos:definition>
    <skos:definition xml:lang="ca">L'acte de pagar una quantitat financera a una part per l'ús de l'actiu.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.w3.org/ns/odrl/2/compensate"/>
  </Action>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/payAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Payment Amount</rdfs:label>
    <rdfs:label xml:lang="es">Cantidad de Pago</rdfs:label>
    <rdfs:label xml:lang="ca">Quantitat de Pagament</rdfs:label>
    <skos:definition xml:lang="en">The amount of a financial payment. Right operand value MUST be an xsd:decimal. </skos:definition>
    <skos:definition xml:lang="es">El importe de un pago financiero. El valor del operando derecho DEBE ser un xsd:decimal.</skos:definition>
    <skos:definition xml:lang="ca">L'import d'un pagament financer. El valor de l'operand dret HA DE ser un xsd:decimal.</skos:definition>
    <skos:note xml:lang="en">Can be used for compensation duties with the unit property indicating the currency of the payment.</skos:note>
    <skos:note xml:lang="es">Se puede utilizar para deberes de compensación con la propiedad de unidad que indica la moneda del pago.</skos:note>
    <skos:note xml:lang="ca">Es pot utilitzar per a deures de compensació amb la propietat d'unitat que indica la moneda del pagament.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/payeeParty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Payee Party</rdfs:label>
    <rdfs:label xml:lang="es">Parte Receptora del Pago</rdfs:label>
    <rdfs:label xml:lang="ca">Part Receptora del Pagament</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The Party is the recipient of the payment.</skos:definition>
    <skos:definition xml:lang="es">La Parte es la receptora del pago.</skos:definition>
    <skos:definition xml:lang="ca">La Part és la receptora del pagament.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.w3.org/ns/odrl/2/compensatedParty"/>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </rdf:Property>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/percentage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Asset Percentage</rdfs:label>
    <rdfs:label xml:lang="es">Porcentaje de Activo</rdfs:label>
    <rdfs:label xml:lang="ca">Percentatge d'Actiu</rdfs:label>
    <skos:definition xml:lang="en">A percentage amount of the target Asset relevant for exercising the action of the Rule. Right operand value MUST be an xsd:decimal from 0 to 100.</skos:definition>
    <skos:definition xml:lang="es">Un porcentaje del Activo de destino relevante para ejercer la acción de la Regla. El valor del operando derecho DEBE ser un xsd:decimal de 0 a 100.</skos:definition>
    <skos:definition xml:lang="ca">Un percentatge de l'Actiu de destinació rellevant per exercir l'acció de la Regla. El valor de l'operand dret HA DE ser un xsd:decimal de 0 a 100.</skos:definition>
    <skos:note xml:lang="en">Example: Extract less than or equal to 50%.</skos:note>
    <skos:note xml:lang="es">Ejemplo: Extraer menos o igual al 50%.</skos:note>
    <skos:note xml:lang="ca">Exemple: Extreure menys o igual al 50%.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <ConflictTerm rdf:about="http://www.w3.org/ns/odrl/2/perm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Prefer Permissions</rdfs:label>
    <rdfs:label xml:lang="es">Preferir Permisos</rdfs:label>
    <rdfs:label xml:lang="ca">Preferir Permisos</rdfs:label>
    <skos:definition xml:lang="en">Permissions take preference over prohibitions.</skos:definition>
    <skos:definition xml:lang="es">Los permisos tienen preferencia sobre las prohibiciones.</skos:definition>
    <skos:definition xml:lang="ca">Els permisos tenen preferència sobre les prohibicions.</skos:definition>
    <skos:note xml:lang="en">Used to determine policy conflict outcomes.</skos:note>
    <skos:note xml:lang="es">Se utiliza para determinar los resultados de conflictos de políticas.</skos:note>
    <skos:note xml:lang="ca">S'utilitza per determinar els resultats de conflictes de polítiques.</skos:note>
  </ConflictTerm>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/permission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Has Permission</rdfs:label>
    <rdfs:label xml:lang="es">Tiene Permiso</rdfs:label>
    <rdfs:label xml:lang="ca">Té Permís</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Permission"/>
    <skos:definition xml:lang="en">Relates an individual Permission to a Policy.</skos:definition>
    <skos:definition xml:lang="es">Relaciona un Permiso individual con una Política.</skos:definition>
    <skos:definition xml:lang="ca">Relaciona un Permís individual amb una Política.</skos:definition>
  </rdf:Property>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/play">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Play</rdfs:label>
    <rdfs:label xml:lang="es">Reproducir</rdfs:label>
    <rdfs:label xml:lang="ca">Reproduir</rdfs:label>
    <skos:definition xml:lang="en">To create a sequential and transient rendition of an Asset.</skos:definition>
    <skos:definition xml:lang="es">Crear una representación secuencial y transitoria de un Activo.</skos:definition>
    <skos:definition xml:lang="ca">Crear una representació seqüencial i transitòria d'un Actiu.</skos:definition>
    <skos:note>For example, to play a video or audio track. If the action is to be performed to a wider audience than just the Assignees, then the Recipient constraint is recommended to be used.</skos:note>
    <skos:note xml:lang="es">Por ejemplo, para reproducir una pista de video o audio. Si la acción se va a realizar a una audiencia más amplia que solo los Cesionarios, se recomienda utilizar la restricción de Destinatario.</skos:note>
    <skos:note xml:lang="ca">Per exemple, per reproduir una pista de vídeo o àudio. Si l'acció s'ha de realitzar a una audiència més àmplia que només els Cessionaris, es recomana utilitzar la restricció de Destinatari.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <RightOperand rdf:about="http://www.w3.org/ns/odrl/2/policyUsage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Policy Rule Usage</rdfs:label>
    <rdfs:label xml:lang="es">Uso de Regla de Política</rdfs:label>
    <rdfs:label xml:lang="ca">Ús de Regla de Política</rdfs:label>
    <skos:definition xml:lang="en">Indicates the actual datetime the action of the Rule was exercised.</skos:definition>
    <skos:definition xml:lang="es">Indica la fecha y hora real en que se ejerció la acción de la Regla.</skos:definition>
    <skos:definition xml:lang="ca">Indica la data i hora real en què es va exercir l'acció de la Regla.</skos:definition>
    <skos:note xml:lang="en">This can be used to express constraints with a LeftOperand relative to the time the rule is exercised. Operators indicate before (lt, lteq), during (eq) or after (gt, gteq) the usage of the rule. &lt;br /&gt;Example: &lt;code&gt;event lt policyUsage&lt;/code&gt; expresses that the identified event must have happened before the action of the rule is exercised.</skos:note>
    <skos:note xml:lang="es">Esto se puede usar para expresar restricciones con un Operando Izquierdo relativo al tiempo en que se ejerce la regla. Los operadores indican antes (lt, lteq), durante (eq) o después (gt, gteq) del uso de la regla. &lt;br /&gt;Ejemplo: &lt;code&gt;event lt policyUsage&lt;/code&gt; expresa que el evento identificado debe haber ocurrido antes de que se ejerza la acción de la regla.</skos:note>
    <skos:note xml:lang="ca">Això es pot usar per expressar restriccions amb un Operand Esquerre relatiu al temps en què s'exerceix la regla. Els operadors indiquen abans (lt, lteq), durant (eq) o després (gt, gteq) de l'ús de la regla. &lt;br /&gt;Exemple: &lt;code&gt;event lt policyUsage&lt;/code&gt; expressa que l'esdeveniment identificat ha d'haver ocorregut abans que s'exerceixi l'acció de la regla.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </RightOperand>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/present">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Present</rdfs:label>
    <rdfs:label xml:lang="es">Presentar</rdfs:label>
    <rdfs:label xml:lang="ca">Presentar</rdfs:label>
    <skos:definition xml:lang="en">To publicly perform the Asset.</skos:definition>
    <skos:definition xml:lang="es">Realizar públicamente el Activo.</skos:definition>
    <skos:definition xml:lang="ca">Realitzar públicament l'Actiu.</skos:definition>
    <skos:note>The asset can be performed (or communicated) in public.</skos:note>
    <skos:note xml:lang="es">El activo puede ser representado (o comunicado) en público.</skos:note>
    <skos:note xml:lang="ca">L'actiu pot ser representat (o comunicat) en públic.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/preview">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Preview</rdfs:label>
    <rdfs:label xml:lang="es">Previsualizar</rdfs:label>
    <rdfs:label xml:lang="ca">Previsualitzar</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The act of providing a short preview of the asset.</skos:definition>
    <skos:definition xml:lang="es">El acto de proporcionar una breve previsualización del activo.</skos:definition>
    <skos:definition xml:lang="ca">L'acte de proporcionar una breu previsualització de l'actiu.</skos:definition>
    <skos:note xml:lang="en">Use a time constraint with the appropriate action.</skos:note>
    <skos:note xml:lang="es">Use una restricción de tiempo con la acción apropiada.</skos:note>
    <skos:note xml:lang="ca">Useu una restricció de temps amb l'acció apropiada.</skos:note>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/print">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Print</rdfs:label>
    <rdfs:label xml:lang="es">Imprimir</rdfs:label>
    <rdfs:label xml:lang="ca">Imprimir</rdfs:label>
    <skos:definition xml:lang="en">To create a tangible and permanent rendition of an Asset.</skos:definition>
    <skos:definition xml:lang="es">Crear una representación tangible y permanente de un Activo.</skos:definition>
    <skos:definition xml:lang="ca">Crear una representació tangible i permanent d'un Actiu.</skos:definition>
    <skos:note xml:lang="en">For example, creating a permanent, fixed (static), and directly perceivable representation of the Asset, such as printing onto paper.</skos:note>
    <skos:note xml:lang="es">Por ejemplo, crear una representación permanente, fija (estática) y directamente perceptible del Activo, como imprimir en papel.</skos:note>
    <skos:note xml:lang="ca">Per exemple, crear una representació permanent, fixa (estàtica) i directament perceptible de l'Actiu, com imprimir en paper.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/product">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Product Context</rdfs:label>
    <rdfs:label xml:lang="es">Contexto del Producto</rdfs:label>
    <rdfs:label xml:lang="ca">Context del Producte</rdfs:label>
    <skos:definition xml:lang="en">Category of a product or service setting a context for exercising the action of the Rule.</skos:definition>
    <skos:definition xml:lang="es">Categoría de un producto o servicio que establece un contexto para ejercer la acción de la Regla.</skos:definition>
    <skos:definition xml:lang="ca">Categoria d'un producte o servei que estableix un context per exercir l'acció de la Regla.</skos:definition>
    <skos:note xml:lang="en">Example: May only be used in the XYZ Magazine.</skos:note>
    <skos:note xml:lang="es">Ejemplo: solo se puede usar en la revista XYZ.</skos:note>
    <skos:note xml:lang="ca">Exemple: només es pot usar a la revista XYZ.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/profile">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Profile</rdfs:label>
    <rdfs:label xml:lang="es">Perfil</rdfs:label>
    <rdfs:label xml:lang="ca">Perfil</rdfs:label>
    <skos:definition xml:lang="en">The identifier(s) of an ODRL Profile that the Policy conforms to.</skos:definition>
    <skos:definition xml:lang="es">El(los) identificador(es) de un Perfil ODRL al que se ajusta la Política.</skos:definition>
    <skos:definition xml:lang="ca">L'(els) identificador(s) d'un Perfil ODRL al qual s'ajusta la Política.</skos:definition>
    <skos:note xml:lang="en">The profile property is mandatory if the Policy is using an ODRL Profile.</skos:note>
    <skos:note xml:lang="es">La propiedad de perfil es obligatoria si la Política utiliza un Perfil ODRL.</skos:note>
    <skos:note xml:lang="ca">La propietat de perfil és obligatòria si la Política utilitza un Perfil ODRL.</skos:note>
  </rdf:Property>
  <ConflictTerm rdf:about="http://www.w3.org/ns/odrl/2/prohibit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Prefer Prohibitions</rdfs:label>
    <rdfs:label xml:lang="es">Preferir Prohibiciones</rdfs:label>
    <rdfs:label xml:lang="ca">Preferir Prohibicions</rdfs:label>
    <skos:definition xml:lang="en">Prohibitions take preference over permissions.</skos:definition>
    <skos:definition xml:lang="es">Las prohibiciones tienen preferencia sobre los permisos.</skos:definition>
    <skos:definition xml:lang="ca">Les prohibicions tenen preferència sobre els permisos.</skos:definition>
    <skos:note xml:lang="en">Used to determine policy conflict outcomes.</skos:note>
    <skos:note xml:lang="es">Se utiliza para determinar los resultados de conflictos de políticas.</skos:note>
    <skos:note xml:lang="ca">S'utilitza per determinar els resultats de conflictes de polítiques.</skos:note>
  </ConflictTerm>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/prohibition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Has Prohibition</rdfs:label>
    <rdfs:label xml:lang="es">Tiene Prohibición</rdfs:label>
    <rdfs:label xml:lang="ca">Té Prohibició</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Prohibition"/>
    <skos:definition xml:lang="en">Relates an individual Prohibition to a Policy.</skos:definition>
    <skos:definition xml:lang="es">Relaciona una Prohibición individual con una Política.</skos:definition>
    <skos:definition xml:lang="ca">Relaciona una Prohibició individual amb una Política.</skos:definition>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/proximity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">proximity</rdfs:label>
    <rdfs:label xml:lang="es">proximidad</rdfs:label>
    <rdfs:label xml:lang="ca">proximitat</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">An value indicating the closeness or nearness.</skos:definition>
    <skos:definition xml:lang="es">Un valor que indica la cercanía o proximidad.</skos:definition>
    <skos:definition xml:lang="ca">Un valor que indica la proximitat o proximitat.</skos:definition>
    <skos:note xml:lang="en">This original term and URI from the OMA specification should be used: http://www.openmobilealliance.com/oma-dd/proximity .</skos:note>
    <skos:note xml:lang="es">Se debe utilizar este término y URI originales de la especificación OMA: http://www.openmobilealliance.com/oma-dd/proximity .</skos:note>
    <skos:note xml:lang="ca">S'ha d'utilitzar aquest terme i URI originals de l'especificació OMA: http://www.openmobilealliance.com/oma-dd/proximity .</skos:note>
  </rdf:Property>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/purpose">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Purpose</rdfs:label>
    <rdfs:label xml:lang="es">Propósito</rdfs:label>
    <rdfs:label xml:lang="ca">Propòsit</rdfs:label>
    <skos:definition xml:lang="en">A defined purpose for exercising the action of the Rule.</skos:definition>
    <skos:definition xml:lang="es">Un propósito definido para ejercer la acción de la Regla.</skos:definition>
    <skos:definition xml:lang="ca">Un propòsit definit per exercir l'acció de la Regla.</skos:definition>
    <skos:note xml:lang="en">Example: Educational use.</skos:note>
    <skos:note xml:lang="es">Ejemplo: Uso educativo.</skos:note>
    <skos:note xml:lang="ca">Exemple: Ús educatiu.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/read">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Read</rdfs:label>
    <rdfs:label xml:lang="es">Leer</rdfs:label>
    <rdfs:label xml:lang="ca">Llegir</rdfs:label>
    <skos:definition xml:lang="en">To obtain data from the Asset.</skos:definition>
    <skos:definition xml:lang="es">Obtener datos del Activo.</skos:definition>
    <skos:definition xml:lang="ca">Obtenir dades de l'Actiu.</skos:definition>
    <skos:note xml:lang="en">For example, the ability to read a record from a database (the Asset).</skos:note>
    <skos:note xml:lang="es">Por ejemplo, la capacidad de leer un registro de una base de datos (el Activo).</skos:note>
    <skos:note xml:lang="ca">Per exemple, la capacitat de llegir un registre d'una base de dades (l'Actiu).</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/recipient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Recipient</rdfs:label>
    <rdfs:label xml:lang="es">Destinatario</rdfs:label>
    <rdfs:label xml:lang="ca">Destinatari</rdfs:label>
    <skos:definition xml:lang="en">The party receiving the result/outcome of exercising the action of the Rule.</skos:definition>
    <skos:definition xml:lang="es">La parte que recibe el resultado/desenlace de ejercer la acción de la Regla.</skos:definition>
    <skos:definition xml:lang="ca">La part que rep el resultat/desenllaç d'exercir l'acció de la Regla.</skos:definition>
    <skos:note xml:lang="en">The Right Operand must identify one or more specific Parties or category/ies of the Party.</skos:note>
    <skos:note xml:lang="es">El Operando Derecho debe identificar una o más Partes específicas o categoría(s) de la Parte.</skos:note>
    <skos:note xml:lang="ca">L'Operand Dret ha d'identificar una o més Parts específiques o categoria(ies) de la Part.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/refinement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf>
          <rdf:Description>
            <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Action"/>
            <rdf:rest>
              <rdf:Description>
                <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/AssetCollection"/>
                <rdf:rest>
                  <rdf:Description>
                    <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/PartyCollection"/>
                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                  </rdf:Description>
                </rdf:rest>
              </rdf:Description>
            </rdf:rest>
          </rdf:Description>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Refinement</rdfs:label>
    <rdfs:label xml:lang="es">Refinamiento</rdfs:label>
    <rdfs:label xml:lang="ca">Refinament</rdfs:label>
    <rdfs:range>
      <owl:Class>
        <owl:unionOf>
          <rdf:Description>
            <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Constraint"/>
            <rdf:rest>
              <rdf:Description>
                <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/LogicalConstraint"/>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
              </rdf:Description>
            </rdf:rest>
          </rdf:Description>
        </owl:unionOf>
      </owl:Class>
    </rdfs:range>
    <skos:definition xml:lang="en">Constraint used to refine the semantics of an Action, or Party/Asset Collection</skos:definition>
    <skos:definition xml:lang="es">Restricción utilizada para refinar la semántica de una Acción, o Colección de Partes/Activos</skos:definition>
    <skos:definition xml:lang="ca">Restricció utilitzada per refinar la semàntica d'una Acció, o Col·lecció de Parts/Actius</skos:definition>
    <skos:note xml:lang="en">Example: the Action print is only permitted on 50% of the asset.</skos:note>
    <skos:note xml:lang="es">Ejemplo: la Acción imprimir solo se permite en el 50% del activo.</skos:note>
    <skos:note xml:lang="ca">Exemple: l'Acció imprimir només es permet en el 50% de l'actiu.</skos:note>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/relation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf>
          <rdf:Description>
            <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Rule"/>
            <rdf:rest>
              <rdf:Description>
                <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
              </rdf:Description>
            </rdf:rest>
          </rdf:Description>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Relation</rdfs:label>
    <rdfs:label xml:lang="es">Relación</rdfs:label>
    <rdfs:label xml:lang="ca">Relació</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Asset"/>
    <skos:definition xml:lang="en">Relation is an abstract property which creates an explicit link between an Action and an Asset.</skos:definition>
    <skos:definition xml:lang="es">Relación es una propiedad abstracta que crea un vínculo explícito entre una Acción y un Activo.</skos:definition>
    <skos:definition xml:lang="ca">Relació és una propietat abstracta que crea un vincle explícit entre una Acció i un Actiu.</skos:definition>
    <skos:note xml:lang="en">Sub-properties of relation are used to define the nature of that link.</skos:note>
    <skos:note xml:lang="es">Las sub-propiedades de relación se utilizan para definir la naturaleza de ese vínculo.</skos:note>
    <skos:note xml:lang="ca">Les sub-propietats de relació s'utilitzen per definir la naturalesa d'aquest vincle.</skos:note>
  </rdf:Property>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/relativePosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Relative Asset Position</rdfs:label>
    <rdfs:label xml:lang="es">Posición Relativa del Activo</rdfs:label>
    <rdfs:label xml:lang="ca">Posició Relativa de l'Actiu</rdfs:label>
    <skos:definition xml:lang="en">A point in space or time defined with coordinates relative to full measures the positioning of the target Asset.</skos:definition>
    <skos:definition xml:lang="es">Un punto en el espacio o tiempo definido con coordenadas relativas a medidas completas que posiciona el Activo de destino.</skos:definition>
    <skos:definition xml:lang="ca">Un punt en l'espai o temps definit amb coordenades relatives a mesures completes que posiciona l'Actiu de destinació.</skos:definition>
    <skos:note xml:lang="en">Example: The upper left corner of a picture may be constrained to a specific position of the canvas rendering it.</skos:note>
    <skos:note xml:lang="es">Ejemplo: La esquina superior izquierda de una imagen puede estar restringida a una posición específica del lienzo que la representa.</skos:note>
    <skos:note xml:lang="ca">Exemple: La cantonada superior esquerra d'una imatge pot estar restringida a una posició específica del llenç que la representa.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/relativeSize">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Relative Asset Size</rdfs:label>
    <rdfs:label xml:lang="es">Tamaño Relativo del Activo</rdfs:label>
    <rdfs:label xml:lang="ca">Mida Relativa de l'Actiu</rdfs:label>
    <skos:definition xml:lang="en">Measure(s) of one or two axes for 2D-objects or measure(s) of one to tree axes for 3D-objects - expressed as percentages of full values - of the target Asset.</skos:definition>
    <skos:definition xml:lang="es">Medida(s) de uno o dos ejes para objetos 2D o medida(s) de uno a tres ejes para objetos 3D - expresadas como porcentajes de los valores completos - del Activo de destino.</skos:definition>
    <skos:definition xml:lang="ca">Mesura(es) d'un o dos eixos per a objectes 2D o mesura(es) d'un a tres eixos per a objectes 3D - expressades com a percentatges dels valors complets - de l'Actiu de destinació.</skos:definition>
    <skos:note xml:lang="en">Example: The image can be resized in width to a maximum of 200%. Note: See the Left Operand absoluteSize. </skos:note>
    <skos:note xml:lang="es">Ejemplo: La imagen se puede redimensionar en anchura hasta un máximo del 200%. Nota: Ver el Operando Izquierdo absoluteSize.</skos:note>
    <skos:note xml:lang="ca">Exemple: La imatge es pot redimensionar en amplada fins a un màxim del 200%. Nota: Vegeu l'Operand Esquerre absoluteSize.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/relativeSpatialPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Relative Spatial Asset Position</rdfs:label>
    <rdfs:label xml:lang="es">Posición Espacial Relativa del Activo</rdfs:label>
    <rdfs:label xml:lang="ca">Posició Espacial Relativa de l'Actiu</rdfs:label>
    <skos:broader rdf:resource="http://www.w3.org/ns/odrl/2/relativePosition"/>
    <skos:definition xml:lang="en">The relative spatial positions - expressed as percentages of full values - of four corners of a rectangle on a 2D-canvas or the eight corners of a cuboid in a 3D-space of the target Asset.</skos:definition>
    <skos:definition xml:lang="es">Las posiciones espaciales relativas - expresadas como porcentajes de los valores completos - de las cuatro esquinas de un rectángulo en un lienzo 2D o las ocho esquinas de un cuboide en un espacio 3D del Activo de destino.</skos:definition>
    <skos:definition xml:lang="ca">Les posicions espacials relatives - expressades com a percentatges dels valors complets - de les quatre cantonades d'un rectangle en un llenç 2D o les vuit cantonades d'un cuboide en un espai 3D de l'Actiu de destinació.</skos:definition>
    <skos:note xml:lang="en">See also Absolute Spatial Asset Position.</skos:note>
    <skos:note xml:lang="es">Ver también Posición Espacial Absoluta del Activo.</skos:note>
    <skos:note xml:lang="ca">Vegeu també Posició Espacial Absoluta de l'Actiu.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/relativeTemporalPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Relative Temporal Asset Position</rdfs:label>
    <rdfs:label xml:lang="es">Posición Temporal Relativa del Activo</rdfs:label>
    <rdfs:label xml:lang="ca">Posició Temporal Relativa de l'Actiu</rdfs:label>
    <skos:broader rdf:resource="http://www.w3.org/ns/odrl/2/relativePosition"/>
    <skos:definition xml:lang="en">A point in space or time defined with coordinates relative to full measures the positioning of the target Asset.</skos:definition>
    <skos:definition xml:lang="es">Un punto en el espacio o tiempo definido con coordenadas relativas a medidas completas que posiciona el Activo de destino.</skos:definition>
    <skos:definition xml:lang="ca">Un punt en l'espai o temps definit amb coordenades relatives a mesures completes que posiciona l'Actiu de destinació.</skos:definition>
    <skos:note xml:lang="en">See also Absolute Temporal Asset Position. &lt;br /&gt;Example: The MP3 music file must be positioned between the positions at 33% and 48% of the temporal length of a stream. </skos:note>
    <skos:note xml:lang="es">Ver también Posición Temporal Absoluta del Activo. &lt;br /&gt;Ejemplo: El archivo de música MP3 debe posicionarse entre las posiciones al 33% y 48% de la longitud temporal de una transmisión.</skos:note>
    <skos:note xml:lang="ca">Vegeu també Posició Temporal Absoluta de l'Actiu. &lt;br /&gt;Exemple: El fitxer de música MP3 s'ha de posicionar entre les posicions al 33% i 48% de la longitud temporal d'una transmissió.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/remedy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Prohibition"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Remedy</rdfs:label>
    <rdfs:label xml:lang="es">Remedio</rdfs:label>
    <rdfs:label xml:lang="ca">Remei</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Duty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/failure"/>
    <skos:definition xml:lang="en">Relates an individual remedy Duty to a Prohibition.</skos:definition>
    <skos:definition xml:lang="es">Relaciona un Deber de remedio individual con una Prohibición.</skos:definition>
    <skos:definition xml:lang="ca">Relaciona un Deure de remei individual amb una Prohibició.</skos:definition>
    <skos:note xml:lang="en">The remedy property expresses an agreed Duty that must be fulfilled in case that a Prohibition has been violated by being exercised.</skos:note>
    <skos:note xml:lang="es">La propiedad de remedio expresa un Deber acordado que debe cumplirse en caso de que se haya violado una Prohibición al ser ejercida.</skos:note>
    <skos:note xml:lang="ca">La propietat de remei expressa un Deure acordat que s'ha de complir en cas que s'hagi violat una Prohibició en ser exercida.</skos:note>
  </rdf:Property>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/reproduce">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Reproduce</rdfs:label>
    <rdfs:label xml:lang="es">Reproducir</rdfs:label>
    <rdfs:label xml:lang="ca">Reproduir</rdfs:label>
    <skos:definition xml:lang="en">To make duplicate copies the Asset in any material form.</skos:definition>
    <skos:definition xml:lang="es">Hacer copias duplicadas del Activo en cualquier forma material.</skos:definition>
    <skos:definition xml:lang="ca">Fer còpies duplicades de l'Actiu en qualsevol forma material.</skos:definition>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/resolution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Rendition Resolution</rdfs:label>
    <rdfs:label xml:lang="es">Resolución de Representación</rdfs:label>
    <rdfs:label xml:lang="ca">Resolució de Representació</rdfs:label>
    <skos:definition xml:lang="en">Resolution of the rendition of the target Asset.</skos:definition>
    <skos:definition xml:lang="es">Resolución de la representación del Activo de destino.</skos:definition>
    <skos:definition xml:lang="ca">Resolució de la representació de l'Actiu de destinació.</skos:definition>
    <skos:note xml:lang="en">Example: the image may be printed at 1200dpi.</skos:note>
    <skos:note xml:lang="es">Ejemplo: la imagen puede imprimirse a 1200 ppp.</skos:note>
    <skos:note xml:lang="ca">Exemple: la imatge es pot imprimir a 1200 ppp.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/reviewPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Review Policy</rdfs:label>
    <rdfs:label xml:lang="es">Revisar Política</rdfs:label>
    <rdfs:label xml:lang="ca">Revisar Política</rdfs:label>
    <skos:definition xml:lang="en">To review the Policy applicable to the Asset.</skos:definition>
    <skos:definition xml:lang="es">Revisar la Política aplicable al Activo.</skos:definition>
    <skos:definition xml:lang="ca">Revisar la Política aplicable a l'Actiu.</skos:definition>
    <skos:note xml:lang="en">Used when human intervention is required to review the Policy. May link to an Asset which represents the full Policy information.</skos:note>
    <skos:note xml:lang="es">Se utiliza cuando se requiere intervención humana para revisar la Política. Puede enlazar a un Activo que representa la información completa de la Política.</skos:note>
    <skos:note xml:lang="ca">S'utilitza quan es requereix intervenció humana per revisar la Política. Pot enllaçar a un Actiu que representa la informació completa de la Política.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/rightOperand">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Constraint"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Has Right Operand</rdfs:label>
    <rdfs:label xml:lang="es">Tiene Operando Derecho</rdfs:label>
    <rdfs:label xml:lang="ca">Té operand dret</rdfs:label>
    <rdfs:label xml:lang="es">Tiene Operando Derecho</rdfs:label>
    <rdfs:label xml:lang="ca">Té operand dret</rdfs:label>
    <rdfs:range>
      <owl:Class>
        <owl:unionOf>
          <rdf:Description>
            <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/RightOperand"/>
            <rdf:rest>
              <rdf:Description>
                <rdf:first rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
                <rdf:rest>
                  <rdf:Description>
                    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                  </rdf:Description>
                </rdf:rest>
              </rdf:Description>
            </rdf:rest>
          </rdf:Description>
        </owl:unionOf>
      </owl:Class>
    </rdfs:range>
    <skos:definition xml:lang="en">The value of the right operand in a constraint expression.</skos:definition>
    <skos:definition xml:lang="es">El valor del operando derecho en una expresión de restricción.</skos:definition>
    <skos:definition xml:lang="ca">El valor de l'operant dret en una expressió de restricció.</skos:definition>
    <skos:definition xml:lang="es">El valor del operando derecho en una expresión de restricción.</skos:definition>
    <skos:definition xml:lang="ca">El valor de l'operant dret en una expressió de restricció.</skos:definition>
    <skos:note xml:lang="en">When used with set-based operators, a list of values may be used.</skos:note>
    <skos:note xml:lang="es">Cuando se utiliza con operadores basados en conjuntos, se puede usar una lista de valores.</skos:note>
    <skos:note xml:lang="ca">Quan s'utilitza amb operadors basats en conjunts, es pot utilitzar una llista de valors.</skos:note>
    <skos:note xml:lang="es">Cuando se utiliza con operadores basados en conjuntos, se puede usar una lista de valores.</skos:note>
    <skos:note xml:lang="ca">Quan s'utilitza amb operadors basats en conjunts, es pot utilitzar una llista de valors.</skos:note>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/rightOperandReference">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Constraint"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Has Right Operand Reference</rdfs:label>
    <rdfs:label xml:lang="es">Tiene referencia de operando derecho</rdfs:label>
    <rdfs:label xml:lang="ca">Té referència d'operant dret</rdfs:label>
    <rdfs:label xml:lang="es">Tiene referencia de operando derecho</rdfs:label>
    <rdfs:label xml:lang="ca">Té referència d'operant dret</rdfs:label>
    <skos:definition xml:lang="en">A reference to a web resource providing the value for the right operand of a Constraint.</skos:definition>
    <skos:definition xml:lang="es">Una referencia a un recurso web que proporciona el valor para el operando derecho de una restricción.</skos:definition>
    <skos:definition xml:lang="ca">Una referència a un recurs web que proporciona el valor per a l'operant dret d'una restricció.</skos:definition>
    <skos:definition xml:lang="es">Una referencia a un recurso web que proporciona el valor para el operando derecho de una restricción.</skos:definition>
    <skos:definition xml:lang="ca">Una referència a un recurs web que proporciona el valor per a l'operant dret d'una restricció.</skos:definition>
    <skos:note xml:lang="en">An IRI that MUST be dereferenced to obtain the actual right operand value. When used with set-based operators, a list of IRIs may be used</skos:note>
    <skos:note xml:lang="es">Un IRI que DEBE ser desreferenciado para obtener el valor real del operando derecho. Cuando se utiliza con operadores basados en conjuntos, se puede usar una lista de IRIs.</skos:note>
    <skos:note xml:lang="ca">Un IRI que S'HA de desreferenciar per obtenir el valor real de l'operant dret. Quan s'utilitza amb operadors basats en conjunts, es pot utilitzar una llista d'IRIs.</skos:note>
    <skos:note xml:lang="es">Un IRI que DEBE ser desreferenciado para obtener el valor real del operando derecho. Cuando se utiliza con operadores basados en conjuntos, se puede usar una lista de IRIs.</skos:note>
    <skos:note xml:lang="ca">Un IRI que S'HA de desreferenciar per obtenir el valor real de l'operant dret. Quan s'utilitza amb operadors basats en conjunts, es pot utilitzar una llista d'IRIs.</skos:note>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/scope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Scope</rdfs:label>
    <rdfs:label xml:lang="es">Ámbito</rdfs:label>
    <rdfs:label xml:lang="ca">Abast</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The identifier of a scope that provides context to the extent of the entity.</skos:definition>
    <skos:definition xml:lang="es">El identificador de un ámbito que proporciona contexto al alcance de la entidad.</skos:definition>
    <skos:definition xml:lang="ca">L'identificador d'un abast que proporciona context a l'abast de l'entitat.</skos:definition>
    <skos:note xml:lang="en">Used to define scopes for Assets and Parties.</skos:note>
    <skos:note xml:lang="es">Se utiliza para definir ámbitos para Activos y Partes.</skos:note>
    <skos:note xml:lang="ca">S'utilitza per definir àmbits per a Actius i Parts.</skos:note>
  </rdf:Property>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/secondaryUse">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Secondary Use</rdfs:label>
    <rdfs:label xml:lang="es">Uso Secundario</rdfs:label>
    <rdfs:label xml:lang="ca">Ús secundari</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The act of using the asset for a purpose other than the purpose it was intended for.</skos:definition>
    <skos:definition xml:lang="es">El acto de utilizar el recurso para un propósito distinto al que fue destinado.</skos:definition>
    <skos:definition xml:lang="ca">L'acte d'utilitzar el recurs per a una finalitat diferent de la que estava previst.</skos:definition>
    </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/sell">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Sell</rdfs:label>
    <rdfs:label xml:lang="es">Vender</rdfs:label>
    <rdfs:label xml:lang="ca">Vendre</rdfs:label>
    <skos:definition xml:lang="en">To transfer the ownership of the Asset to a third party with compensation and while deleting the original asset.</skos:definition>
    <skos:definition xml:lang="es">Transferir la propiedad del recurso a un tercero con compensación y eliminando el recurso original.</skos:definition>
    <skos:definition xml:lang="ca">Transferir la propietat del recurs a un tercer amb compensació i eliminant el recurs original.</skos:definition>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/transfer"/>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/share">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Share</rdfs:label>
    <rdfs:label xml:lang="es">Compartir</rdfs:label>
    <rdfs:label xml:lang="ca">Compartir</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The act of the non-commercial reproduction and distribution of the asset to third-parties.</skos:definition>
    <skos:definition xml:lang="es">El acto de la reproducción y distribución no comercial del recurso a terceros.</skos:definition>
    <skos:definition xml:lang="ca">L'acte de la reproducció i distribució no comercial del recurs a tercers.</skos:definition>
    <skos:exactMatch rdf:resource="http://creativecommons.org/ns#Sharing"/>
    </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/shareAlike">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Share-alike</rdfs:label>
    <rdfs:label xml:lang="es">Compartir igual</rdfs:label>
    <rdfs:label xml:lang="ca">Compartir igual</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The act of distributing any derivative asset under the same terms as the original asset.</skos:definition>
    <skos:definition xml:lang="es">El acto de distribuir cualquier recurso derivado bajo los mismos términos que el recurso original.</skos:definition>
    <skos:definition xml:lang="ca">L'acte de distribuir qualsevol recurs derivat sota els mateixos termes que el recurs original.</skos:definition>
    <skos:exactMatch rdf:resource="http://creativecommons.org/ns#ShareAlike"/>
    </Action>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/source">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf>
          <rdf:Description>
            <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/AssetCollection"/>
            <rdf:rest>
              <rdf:Description>
                <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/PartyCollection"/>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
              </rdf:Description>
            </rdf:rest>
          </rdf:Description>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Source</rdfs:label>
    <rdfs:label xml:lang="es">Fuente</rdfs:label>
    <rdfs:label xml:lang="ca">Font</rdfs:label>
    <skos:definition xml:lang="en">Reference to a Asset/PartyCollection</skos:definition>
    <skos:definition xml:lang="es">Referencia a una Asset/PartyCollection</skos:definition>
    <skos:definition xml:lang="ca">Referència a una Asset/PartyCollection</skos:definition>
    <skos:note xml:lang="en">Used by AssetCollection and PartyCollection when constraints are applied.</skos:note>
    <skos:note xml:lang="es">Utilizado por AssetCollection y PartyCollection cuando se aplican restricciones.</skos:note>
    <skos:note xml:lang="ca">Utilitzat per AssetCollection i PartyCollection quan s'apliquen restriccions.</skos:note>
    </rdf:Property>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/spatial">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Geospatial Named Area</rdfs:label>
    <rdfs:label xml:lang="es">Área geoespacial nombrada</rdfs:label>
    <rdfs:label xml:lang="ca">Àrea geoespacial anomenada</rdfs:label>
    <skos:definition xml:lang="en">A named and identified geospatial area with defined borders which is used for exercising the action of the Rule. An IRI MUST be used to represent this value.</skos:definition>
    <skos:definition xml:lang="es">Un área geoespacial nombrada e identificada con fronteras definidas que se utiliza para ejercer la acción de la Regla. Se DEBE usar un IRI para representar este valor.</skos:definition>
    <skos:definition xml:lang="ca">Una àrea geoespacial anomenada i identificada amb fronteres definides que s'utilitza per exercir l'acció de la Regla. S'HA d'utilitzar un IRI per representar aquest valor.</skos:definition>
    <skos:note xml:lang="en">A code value for the area and source of the code must be presented in the Right Operand. &lt;br /&gt;Example: the [[iso3166]] Country Codes or the Getty Thesaurus of Geographic Names. </skos:note>
    <skos:note xml:lang="es">Se debe presentar un valor de código para el área y la fuente del código en el Operando Derecho. &lt;br /&gt;Ejemplo: los códigos de país [[iso3166]] o el Getty Thesaurus of Geographic Names.</skos:note>
    <skos:note xml:lang="ca">S'ha de presentar un valor de codi per a l'àrea i la font del codi a l'Operant Dret. &lt;br /&gt;Exemple: els codis de país [[iso3166]] o el Getty Thesaurus of Geographic Names.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    </LeftOperand>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/spatialCoordinates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Geospatial Coordinates</rdfs:label>
    <rdfs:label xml:lang="es">Coordenadas geoespaciales</rdfs:label>
    <rdfs:label xml:lang="ca">Coordenades geoespacials</rdfs:label>
    <skos:broader rdf:resource="http://www.w3.org/ns/odrl/2/spatial"/>
    <skos:definition xml:lang="en">A set of coordinates setting the borders of a geospatial area used for exercising the action of the Rule. The coordinates MUST include longitude and latitude, they MAY include altitude and the geodetic datum.</skos:definition>
    <skos:definition xml:lang="es">Un conjunto de coordenadas que establecen los límites de un área geoespacial utilizada para ejercer la acción de la Regla. Las coordenadas DEBEN incluir longitud y latitud, pueden incluir altitud y el datum geodésico.</skos:definition>
    <skos:definition xml:lang="ca">Un conjunt de coordenades que estableixen els límits d'una àrea geoespacial utilitzada per exercir l'acció de la Regla. Les coordenades HAN d'incloure longitud i latitud, poden incloure altitud i el datum geodèsic.</skos:definition>
    <skos:note xml:lang="en">The default values are the altitude of earth's surface at this location and the WGS 84 datum.</skos:note>
    <skos:note xml:lang="es">Los valores predeterminados son la altitud de la superficie terrestre en esta ubicación y el datum WGS 84.</skos:note>
    <skos:note xml:lang="ca">Els valors predeterminats són l'altitud de la superfície terrestre en aquesta ubicació i el datum WGS 84.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    </LeftOperand>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/status">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Constraint"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Status</rdfs:label>
    <rdfs:label xml:lang="es">Estado</rdfs:label>
    <rdfs:label xml:lang="ca">Estat</rdfs:label>
    <skos:definition xml:lang="en">the value generated from the leftOperand action or a value related to the leftOperand set as the reference for the comparison.</skos:definition>
    <skos:definition xml:lang="es">el valor generado a partir de la acción del leftOperand o un valor relacionado con el leftOperand establecido como referencia para la comparación.</skos:definition>
    <skos:definition xml:lang="ca">el valor generat a partir de l'acció del leftOperand o un valor relacionat amb el leftOperand establert com a referència per a la comparació.</skos:definition>
  </rdf:Property>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/stream">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Stream</rdfs:label>
    <rdfs:label xml:lang="es">Transmitir en tiempo real</rdfs:label>
    <rdfs:label xml:lang="ca">Transmetre en temps real</rdfs:label>
    <skos:definition xml:lang="en">To deliver the Asset in real-time.</skos:definition>
    <skos:definition xml:lang="es">Entregar el recurso en tiempo real.</skos:definition>
    <skos:definition xml:lang="ca">Lliurar el recurs en temps real.</skos:definition>
    <skos:note>The Asset maybe utilised in real-time as it is being delivered. If the action is to be performed to a wider audience than just the Assignees, then the Recipient constraint is recommended to be used.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <UndefinedTerm rdf:about="http://www.w3.org/ns/odrl/2/support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Support Undefined Actions</rdfs:label>
    <rdfs:label xml:lang="es">Soportar acciones indefinidas</rdfs:label>
    <rdfs:label xml:lang="ca">Donar suport a accions no definides</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The Action is to be supported as part of the policy – and the policy remains valid.</skos:definition>
    <skos:definition xml:lang="es">La acción debe ser soportada como parte de la política y la política sigue siendo válida.</skos:definition>
    <skos:definition xml:lang="ca">L'acció s'ha de donar suport com a part de la política i la política segueix sent vàlida.</skos:definition>
    <skos:note xml:lang="en">Used to support actions not known to the policy system.</skos:note>
    <skos:note xml:lang="es">Se utiliza para soportar acciones no conocidas por el sistema de políticas.</skos:note>
    <skos:note xml:lang="ca">S'utilitza per donar suport a accions desconegudes pel sistema de polítiques.</skos:note>
  </UndefinedTerm>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/synchronize">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Synchronize</rdfs:label>
    <rdfs:label xml:lang="es">Sincronizar</rdfs:label>
    <rdfs:label xml:lang="ca">Sincronitzar</rdfs:label>
    <skos:definition xml:lang="en">To use the Asset in timed relations with media (audio/visual) elements of another Asset.</skos:definition>
    <skos:definition xml:lang="es">Utilizar el recurso en relaciones temporizadas con elementos multimedia (audio/visual) de otro recurso.</skos:definition>
    <skos:definition xml:lang="ca">Utilitzar el recurs en relacions temporitzades amb elements multimèdia (àudio/visual) d'un altre recurs.</skos:definition>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
    </Action>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/system">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">System</rdfs:label>
    <rdfs:label xml:lang="es">Sistema</rdfs:label>
    <rdfs:label xml:lang="ca">Sistema</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">An identified computing system used for exercising the action of the Rule.</skos:definition>
    <skos:definition xml:lang="es">Un sistema informático identificado utilizado para ejercer la acción de la regla.</skos:definition>
    <skos:definition xml:lang="ca">Un sistema informàtic identificat utilitzat per exercir l'acció de la regla.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.w3.org/ns/odrl/2/systemDevice"/>
    <skos:note>See System Device</skos:note>
    </LeftOperand>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/systemDevice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">System Device</rdfs:label>
    <rdfs:label xml:lang="es">Dispositivo del sistema</rdfs:label>
    <rdfs:label xml:lang="ca">Dispositiu del sistema</rdfs:label>
    <skos:definition xml:lang="en">An identified computing system or computing device used for exercising the action of the Rule.</skos:definition>
    <skos:definition xml:lang="es">Un sistema informático o dispositivo informático identificado utilizado para ejercer la acción de la regla.</skos:definition>
    <skos:definition xml:lang="ca">Un sistema informàtic o dispositiu informàtic identificat utilitzat per exercir l'acció de la regla.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.w3.org/ns/odrl/2/device"/>
    <skos:exactMatch rdf:resource="http://www.w3.org/ns/odrl/2/system"/>
    <skos:note xml:lang="en">Example: The system device can be identified by a unique code created from the used hardware.</skos:note>
    <skos:note xml:lang="es">Ejemplo: El dispositivo del sistema puede identificarse mediante un código único creado a partir del hardware utilizado.</skos:note>
    <skos:note xml:lang="ca">Exemple: El dispositiu del sistema es pot identificar mitjançant un codi únic creat a partir del maquinari utilitzat.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    </LeftOperand>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/target">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf>
          <rdf:Description>
            <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Rule"/>
            <rdf:rest>
              <rdf:Description>
                <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
              </rdf:Description>
            </rdf:rest>
          </rdf:Description>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Target</rdfs:label>
    <rdfs:label xml:lang="es">Objetivo</rdfs:label>
    <rdfs:label xml:lang="ca">Objectiu</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Asset"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/relation"/>
    <skos:definition xml:lang="en">The target property indicates the Asset that is the primary subject to which the Rule action directly applies.</skos:definition>
    <skos:definition xml:lang="es">La propiedad objetivo indica el Recurso que es el sujeto principal al que se aplica directamente la acción de la Regla.</skos:definition>
    <skos:definition xml:lang="ca">La propietat objectiu indica el Recurs que és el subjecte principal al qual s'aplica directament l'acció de la Regla.</skos:definition>
    </rdf:Property>
    <Action rdf:about="http://www.w3.org/ns/odrl/2/textToSpeech">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Text-to-speech</rdfs:label>
    <rdfs:label xml:lang="es">Texto a voz</rdfs:label>
    <rdfs:label xml:lang="ca">Text a veu</rdfs:label>
    <skos:definition xml:lang="en">To have a text Asset read out loud.</skos:definition>
    <skos:definition xml:lang="es">Hacer que un Recurso de texto sea leído en voz alta.</skos:definition>
    <skos:definition xml:lang="ca">Fer que un Recurs de text sigui llegit en veu alta.</skos:definition>
    <skos:note>If the action is to be performed to a wider audience than just the Assignees, then the recipient constraint is recommended to be used.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
    </Action>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/timeInterval">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Recurring Time Interval</rdfs:label>
    <rdfs:label xml:lang="es">Intervalo Temporal Recurrente</rdfs:label>
    <rdfs:label xml:lang="ca">Interval Temporal Recurrent</rdfs:label>
    <skos:definition xml:lang="en">A recurring period of time before the next execution of the action of the Rule. Right operand value MUST be an xsd:duration as defined by [[xmlschema11-2]].</skos:definition>
    <skos:definition xml:lang="es">Un período de tiempo recurrente antes de la siguiente ejecución de la acción de la Regla. El valor del operando derecho DEBE ser un xsd:duration como se define en [[xmlschema11-2]].</skos:definition>
    <skos:definition xml:lang="ca">Un període de temps recurrent abans de la següent execució de l'acció de la Regla. El valor de l'operand dret HA DE ser un xsd:duration com es defineix a [[xmlschema11-2]].</skos:definition>
    <skos:note>Only the eq operator SHOULD be used. &lt;br /&gt;Example: &lt;code&gt;timeInterval eq P7D&lt;/code&gt; indicates a recurring 7 day period.</skos:note>
    <skos:note xml:lang="es">Solo debería usarse el operador eq. &lt;br /&gt;Ejemplo: &lt;code&gt;timeInterval eq P7D&lt;/code&gt; indica un período recurrente de 7 días.</skos:note>
    <skos:note xml:lang="ca">Només s'hauria d'utilitzar l'operador eq. &lt;br /&gt;Exemple: &lt;code&gt;timeInterval eq P7D&lt;/code&gt; indica un període recurrent de 7 dies.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
  </LeftOperand>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/timedCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Timed Count</rdfs:label>
    <rdfs:label xml:lang="es">Conteo Temporizado</rdfs:label>
    <rdfs:label xml:lang="ca">Comptador Temporitzat</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The number of seconds after which timed metering use of the asset begins.</skos:definition>
    <skos:definition xml:lang="es">El número de segundos después del cual comienza el uso medido en el tiempo del recurso.</skos:definition>
    <skos:definition xml:lang="ca">El nombre de segons després del qual comença l'ús mesurat en el temps del recurs.</skos:definition>
    <skos:note xml:lang="en">This original term and URI from the OMA specification should be used: http://www.openmobilealliance.com/oma-dd/timed-count .</skos:note>
    <skos:note xml:lang="es">Este término original y URI de la especificación OMA deben usarse: http://www.openmobilealliance.com/oma-dd/timed-count .</skos:note>
    <skos:note xml:lang="ca">Aquest terme original i URI de l'especificació OMA s'han d'utilitzar: http://www.openmobilealliance.com/oma-dd/timed-count .</skos:note>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/trackedParty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Tracked Party</rdfs:label>
    <rdfs:label xml:lang="es">Parte Rastreada</rdfs:label>
    <rdfs:label xml:lang="ca">Part Rastrejada</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/function"/>
    <skos:definition xml:lang="en">The Party whose usage is being tracked.</skos:definition>
    <skos:definition xml:lang="es">La parte cuyo uso está siendo rastreado.</skos:definition>
    <skos:definition xml:lang="ca">La part l'ús de la qual està sent rastrejat.</skos:definition>
    <skos:note xml:lang="en">May be specified as part of the acceptTracking action.</skos:note>
    <skos:note xml:lang="es">Puede especificarse como parte de la acción acceptTracking.</skos:note>
    <skos:note xml:lang="ca">Pot especificar-se com a part de l'acció acceptTracking.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/trackingParty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Tracking Party</rdfs:label>
    <rdfs:label xml:lang="es">Parte que Rastreja</rdfs:label>
    <rdfs:label xml:lang="ca">Part que Rastreja</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/function"/>
    <skos:definition xml:lang="en">The Party who is tracking usage.</skos:definition>
    <skos:definition xml:lang="es">La parte que está rastreando el uso.</skos:definition>
    <skos:definition xml:lang="ca">La part que està rastrejant l'ús.</skos:definition>
    <skos:note xml:lang="en">May be specified as part of the acceptTracking action.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
  </rdf:Property>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/transfer">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Transfer Ownership</rdfs:label>
    <rdfs:label xml:lang="es">Transferir Propiedad</rdfs:label>
    <rdfs:label xml:lang="ca">Transferir Propietat</rdfs:label>
    <skos:definition xml:lang="en">To transfer the ownership of the Asset in perpetuity.</skos:definition>
    <skos:definition xml:lang="es">Transferir la propiedad del recurso a perpetuidad.</skos:definition>
    <skos:definition xml:lang="ca">Transferir la propietat del recurs a perpetuïtat.</skos:definition>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/transform">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Transform</rdfs:label>
    <rdfs:label xml:lang="es">Transformar</rdfs:label>
    <rdfs:label xml:lang="ca">Transformar</rdfs:label>
    <skos:definition xml:lang="en">To convert the Asset into a different format.</skos:definition>
    <skos:definition xml:lang="es">Convertir el recurso a un formato diferente.</skos:definition>
    <skos:definition xml:lang="ca">Convertir el recurs a un format diferent.</skos:definition>
    <skos:note xml:lang="en">Typically used to convert the Asset into a different format for consumption on/transfer to a third party system.</skos:note>
    <skos:note xml:lang="es">Normalmente se utiliza para convertir el recurso a un formato diferente para su consumo o transferencia a un sistema de terceros.</skos:note>
    <skos:note xml:lang="ca">Normalment s'utilitza per convertir el recurs a un format diferent per al seu consum o transferència a un sistema de tercers.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/translate">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Translate</rdfs:label>
    <rdfs:label xml:lang="es">Traducir</rdfs:label>
    <rdfs:label xml:lang="ca">Traduir</rdfs:label>
    <skos:definition xml:lang="en">To translate the original natural language of an Asset into another natural language.</skos:definition>
    <skos:definition xml:lang="es">Traducir el idioma natural original de un recurso a otro idioma natural.</skos:definition>
    <skos:definition xml:lang="ca">Traduir l'idioma natural original d'un recurs a un altre idioma natural.</skos:definition>
    <skos:note xml:lang="en">A new derivative Asset is created by that action.</skos:note>
    <skos:note xml:lang="es">Se crea un nuevo recurso derivado mediante esa acción.</skos:note>
    <skos:note xml:lang="ca">Es crea un nou recurs derivat mitjançant aquesta acció.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/uid">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf>
          <rdf:Description>
            <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
            <rdf:rest>
              <rdf:Description>
                <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Asset"/>
                <rdf:rest>
                  <rdf:Description>
                    <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Rule"/>
                    <rdf:rest>
                      <rdf:Description>
                        <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Party"/>
                        <rdf:rest>
                          <rdf:Description>
                            <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/Constraint"/>
                            <rdf:rest>
                              <rdf:Description>
                                <rdf:first rdf:resource="http://www.w3.org/ns/odrl/2/LogicalConstraint"/>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                              </rdf:Description>
                            </rdf:rest>
                          </rdf:Description>
                        </rdf:rest>
                      </rdf:Description>
                    </rdf:rest>
                  </rdf:Description>
                </rdf:rest>
              </rdf:Description>
            </rdf:rest>
          </rdf:Description>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Unique Identifier</rdfs:label>
    <rdfs:label xml:lang="es">Identificador Único</rdfs:label>
    <rdfs:label xml:lang="ca">Identificador Únic</rdfs:label>
    <skos:definition xml:lang="en">An unambiguous identifier</skos:definition>
    <skos:definition xml:lang="es">Un identificador inequívoco</skos:definition>
    <skos:definition xml:lang="ca">Un identificador inequívoc</skos:definition>
    <skos:note xml:lang="en">Used by the Policy, Rule, Asset, Party, Constraint, and Logical Constraint Classes.</skos:note>
    <skos:note xml:lang="es">Utilizado por las clases Policy, Rule, Asset, Party, Constraint y Logical Constraint.</skos:note>
    <skos:note xml:lang="ca">Utilitzat per les classes Policy, Rule, Asset, Party, Constraint i Logical Constraint.</skos:note>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/undefined">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Handle Undefined Term</rdfs:label>
    <rdfs:label xml:lang="es">Gestionar Término Indefinido</rdfs:label>
    <rdfs:label xml:lang="ca">Gestionar Terme Indefinit</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/UndefinedTerm"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">Relates the strategy used for handling undefined actions to a Policy.</skos:definition>
    <skos:definition xml:lang="es">Relaciona la estrategia utilizada para gestionar acciones indefinidas con una política.</skos:definition>
    <skos:definition xml:lang="ca">Relaciona l'estratègia utilitzada per gestionar accions indefinides amb una política.</skos:definition>
    <skos:note xml:lang="en">If no strategy is specified, the default is invalid.</skos:note>
  </rdf:Property>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/uninstall">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Uninstall</rdfs:label>
    <rdfs:label xml:lang="es">Desinstalar</rdfs:label>
    <rdfs:label xml:lang="ca">Desinstal·lar</rdfs:label>
    <skos:definition xml:lang="en">To unload and delete the computer program Asset from a storage device and disable its readiness for operation.</skos:definition>
    <skos:definition xml:lang="es">Desinstalar y eliminar el recurso de programa informático de un dispositivo de almacenamiento y deshabilitar su disponibilidad para operar.</skos:definition>
    <skos:definition xml:lang="ca">Desinstal·lar i eliminar el recurs de programa informàtic d'un dispositiu d'emmagatzematge i deshabilitar la seva disponibilitat per operar.</skos:definition>
    <skos:note xml:lang="en">The Asset is no longer accessible to the assignees after it has been used.</skos:note>
    <skos:note xml:lang="es">El recurso ya no está accesible para los asignatarios después de haber sido utilizado.</skos:note>
    <skos:note xml:lang="ca">El recurs ja no està accessible per als assignataris després d'haver estat utilitzat.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/unit">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Constraint"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Unit</rdfs:label>
    <rdfs:label xml:lang="es">Unidad</rdfs:label>
    <rdfs:label xml:lang="ca">Unitat</rdfs:label>
    <skos:definition xml:lang="en">The unit of measurement of the value of the rightOperand or rightOperandReference of a Constraint.</skos:definition>
    <skos:definition xml:lang="es">La unidad de medida del valor del rightOperand o rightOperandReference de una restricción.</skos:definition>
    <skos:definition xml:lang="ca">La unitat de mesura del valor del rightOperand o rightOperandReference d'una restricció.</skos:definition>
  </rdf:Property>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/unitOfCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Unit Of Count</rdfs:label>
    <rdfs:label xml:lang="es">Unidad de Conteo</rdfs:label>
    <rdfs:label xml:lang="ca">Unitat de Compte</rdfs:label>
    <skos:definition xml:lang="en">The unit of measure used for counting the executions of the action of the Rule.</skos:definition>
    <skos:definition xml:lang="es">La unidad de medida utilizada para contar las ejecuciones de la acción de la Regla.</skos:definition>
    <skos:definition xml:lang="ca">La unitat de mesura utilitzada per comptar les execucions de l'acció de la Regla.</skos:definition>
    <skos:note xml:lang="en">Note: Typically used with Duties to indicate the unit entity to be counted of the Action. &lt;br /&gt;Example: A duty to compensate and a unitOfCount constraint of 'perUser' would indicate that the compensation by multiplied by the 'number of users'.</skos:note>
    <skos:note xml:lang="es">Nota: Normalmente se utiliza con Duties para indicar la entidad unitaria a contar de la Acción. &lt;br /&gt;Ejemplo: Un deber de compensar y una restricción unitOfCount de 'perUser' indicaría que la compensación se multiplica por el 'número de usuarios'.</skos:note>
    <skos:note xml:lang="ca">Nota: Normalment s'utilitza amb Duties per indicar l'entitat unitària a comptar de l'Acció. &lt;br /&gt;Exemple: Un deure de compensar i una restricció unitOfCount de 'perUser' indicaria que la compensació es multiplica pel 'nombre d'usuaris'.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
  </LeftOperand>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/use">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Use</rdfs:label>
    <rdfs:label xml:lang="es">Usar</rdfs:label>
    <rdfs:label xml:lang="ca">Utilitzar</rdfs:label>
    <skos:definition xml:lang="en">To use the Asset</skos:definition>
    <skos:definition xml:lang="es">Utilizar el recurso</skos:definition>
    <skos:definition xml:lang="ca">Utilitzar el recurs</skos:definition>
    <skos:note xml:lang="en">Use is the most generic action for all non-third-party usage. More specific types of the use action can be expressed by more targetted actions.</skos:note>
    <skos:note xml:lang="es">Usar es la acción más genérica para todo uso que no sea de terceros. Tipos más específicos de la acción usar pueden expresarse mediante acciones más concretas.</skos:note>
    <skos:note xml:lang="ca">Utilitzar és l'acció més genèrica per a tot ús que no sigui de tercers. Tipus més específics de l'acció utilitzar es poden expressar mitjançant accions més concretes.</skos:note>
  </Action>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/version">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Version</rdfs:label>
    <rdfs:label xml:lang="es">Versión</rdfs:label>
    <rdfs:label xml:lang="ca">Versió</rdfs:label>
    <skos:definition xml:lang="en">The version of the target Asset.</skos:definition>
    <skos:definition xml:lang="es">La versión del recurso objetivo.</skos:definition>
    <skos:definition xml:lang="ca">La versió del recurs objectiu.</skos:definition>
    <skos:note xml:lang="en">Example: Single Paperback or Multiple Issues or version 2.0 or higher.</skos:note>
    <skos:note xml:lang="es">Ejemplo: Tapa blanda única o múltiples ediciones o versión 2.0 o superior.</skos:note>
    <skos:note xml:lang="ca">Exemple: Tapa tova única o múltiples edicions o versió 2.0 o superior.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
  </LeftOperand>
  <LeftOperand rdf:about="http://www.w3.org/ns/odrl/2/virtualLocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Virtual IT Communication Location</rdfs:label>
    <rdfs:label xml:lang="es">Ubicación Virtual de Comunicación IT</rdfs:label>
    <rdfs:label xml:lang="ca">Ubicació Virtual de Comunicació IT</rdfs:label>
    <skos:definition xml:lang="en">An identified location of the IT communication space which is relevant for exercising the action of the Rule.</skos:definition>
    <skos:definition xml:lang="es">Una ubicación identificada del espacio de comunicación IT relevante para ejercer la acción de la Regla.</skos:definition>
    <skos:definition xml:lang="ca">Una ubicació identificada de l'espai de comunicació IT rellevant per exercir l'acció de la Regla.</skos:definition>
    <skos:note xml:lang="en">Example: an Internet domain or IP address range.</skos:note>
    <skos:note xml:lang="es">Ejemplo: un dominio de Internet o un rango de direcciones IP.</skos:note>
    <skos:note xml:lang="ca">Exemple: un domini d'Internet o un rang d'adreces IP.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
  </LeftOperand>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/watermark">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Watermark</rdfs:label>
    <rdfs:label xml:lang="es">Marca de Agua</rdfs:label>
    <rdfs:label xml:lang="ca">Marca d'Aigua</rdfs:label>
    <skos:definition xml:lang="en">To apply a watermark to the Asset.</skos:definition>
    <skos:definition xml:lang="es">Aplicar una marca de agua al recurso.</skos:definition>
    <skos:definition xml:lang="ca">Aplicar una marca d'aigua al recurs.</skos:definition>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/write">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Write</rdfs:label>
    <rdfs:label xml:lang="es">Escribir</rdfs:label>
    <rdfs:label xml:lang="ca">Escriure</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The act of writing to the Asset.</skos:definition>
    <skos:definition xml:lang="es">El acto de escribir en el recurso.</skos:definition>
    <skos:definition xml:lang="ca">L'acte d'escriure en el recurs.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.w3.org/ns/odrl/2/modify"/>
  </Action>
  <Action rdf:about="http://www.w3.org/ns/odrl/2/writeTo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Write to</rdfs:label>
    <rdfs:label xml:lang="es">Escribir en</rdfs:label>
    <rdfs:label xml:lang="ca">Escriure a</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">The act of adding data to the Asset.</skos:definition>
    <skos:definition xml:lang="es">El acto de añadir datos al recurso.</skos:definition>
    <skos:definition xml:lang="ca">L'acte d'afegir dades al recurs.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.w3.org/ns/odrl/2/modify"/>
  </Action>
  <rdf:Property rdf:about="http://www.w3.org/ns/odrl/2/xone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Only One</rdfs:label>
    <rdfs:label xml:lang="es">Solo Uno</rdfs:label>
    <rdfs:label xml:lang="ca">Només Un</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/odrl/2/operand"/>
    <skos:definition xml:lang="en">The relation is satisfied when only one, and not more, of the Constaints is satisfied</skos:definition>
    <skos:definition xml:lang="es">La relación se satisface cuando solo una, y no más, de las restricciones se cumple</skos:definition>
    <skos:definition xml:lang="ca">La relació es compleix quan només una, i no més, de les restriccions es compleix</skos:definition>
    <skos:note xml:lang="en">This property MUST only be used for Logical Constraints, and the list of operand values MUST be Constraint instances.</skos:note>
  </rdf:Property>
</rdf:RDF>




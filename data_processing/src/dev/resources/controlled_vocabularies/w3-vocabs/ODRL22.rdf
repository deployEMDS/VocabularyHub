<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF xmlns:cc="http://creativecommons.org/ns#"
   xmlns:dct="http://purl.org/dc/terms/"
   xmlns:foaf="http://xmlns.com/foaf/0.1/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:schema="http://schema.org/"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:vcard="http://www.w3.org/2006/vcard/ns#"
   xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
   xmlns="http://www.w3.org/ns/odrl/2/">
  <Action rdf:about="http://creativecommons.org/ns#Attribution">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Attribution</rdfs:label>
    <rdfs:label xml:lang="es">Atribución</rdfs:label>
    <rdfs:label xml:lang="ca">Atribució</rdfs:label>
    <skos:definition xml:lang="en">Credit be given to copyright holder and/or author.</skos:definition>
    <skos:definition xml:lang="es">Se debe dar crédito al titular de los derechos de autor y/o autor.</skos:definition>
    <skos:definition xml:lang="ca">S'ha de donar crèdit al titular dels drets d'autor i/o autor.</skos:definition>
    <skos:note xml:lang="en">This term is defined by Creative Commons.</skos:note>
    <skos:note xml:lang="es">Este término está definido por Creative Commons.</skos:note>
    <skos:note xml:lang="ca">Aquest terme està definit per Creative Commons.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <Action rdf:about="http://creativecommons.org/ns#CommercialUse">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Commercial Use</rdfs:label>
    <rdfs:label xml:lang="es">Uso comercial</rdfs:label>
    <rdfs:label xml:lang="ca">Ús comercial</rdfs:label>
    <skos:definition xml:lang="en">Exercising rights for commercial purposes.</skos:definition>
    <skos:definition xml:lang="es">Ejercicio de derechos con fines comerciales.</skos:definition>
    <skos:definition xml:lang="ca">Exercici de drets amb finalitats comercials.</skos:definition>
    <skos:note xml:lang="en">This term is defined by Creative Commons.</skos:note>
    <skos:note xml:lang="es">Este término está definido por Creative Commons.</skos:note>
    <skos:note xml:lang="ca">Aquest terme està definit per Creative Commons.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <Action rdf:about="http://creativecommons.org/ns#DerivativeWorks">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Derivative Works</rdfs:label>
    <rdfs:label xml:lang="es">Obras derivadas</rdfs:label>
    <rdfs:label xml:lang="ca">Obres derivades</rdfs:label>
    <skos:definition xml:lang="en">Distribution of derivative works.</skos:definition>
    <skos:definition xml:lang="es">Distribución de obras derivadas.</skos:definition>
    <skos:definition xml:lang="ca">Distribució d'obres derivades.</skos:definition>
    <skos:note xml:lang="en">This term is defined by Creative Commons.</skos:note>
    <skos:note xml:lang="es">Este término está definido por Creative Commons.</skos:note>
    <skos:note xml:lang="ca">Aquest terme està definit per Creative Commons.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <Action rdf:about="http://creativecommons.org/ns#Distribution">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Distribution</rdfs:label>
    <rdfs:label xml:lang="es">Distribución</rdfs:label>
    <rdfs:label xml:lang="ca">Distribució</rdfs:label>
    <skos:definition xml:lang="en">Distribution, public display, and publicly performance.</skos:definition>
    <skos:definition xml:lang="es">Distribución, exhibición pública y actuación pública.</skos:definition>
    <skos:definition xml:lang="ca">Distribució, exhibició pública i actuació pública.</skos:definition>
    <skos:note xml:lang="en">This term is defined by Creative Commons.</skos:note>
    <skos:note xml:lang="es">Este término está definido por Creative Commons.</skos:note>
    <skos:note xml:lang="ca">Aquest terme està definit per Creative Commons.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <Action rdf:about="http://creativecommons.org/ns#Notice">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Notice</rdfs:label>
    <rdfs:label xml:lang="es">Aviso</rdfs:label>
    <rdfs:label xml:lang="ca">Avís</rdfs:label>
    <skos:definition xml:lang="en">Copyright and license notices be kept intact.</skos:definition>
    <skos:definition xml:lang="es">Los avisos de derechos de autor y licencia deben mantenerse intactos.</skos:definition>
    <skos:definition xml:lang="ca">Els avisos de drets d'autor i llicència s'han de mantenir intactes.</skos:definition>
    <skos:note xml:lang="en">This term is defined by Creative Commons.</skos:note>
    <skos:note xml:lang="es">Este término está definido por Creative Commons.</skos:note>
    <skos:note xml:lang="ca">Aquest terme està definit per Creative Commons.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <Action rdf:about="http://creativecommons.org/ns#Reproduction">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Reproduction</rdfs:label>
    <rdfs:label xml:lang="es">Reproducción</rdfs:label>
    <rdfs:label xml:lang="ca">Reproducció</rdfs:label>
    <skos:definition xml:lang="en">Making multiple copies.</skos:definition>
    <skos:definition xml:lang="es">Hacer copias múltiples.</skos:definition>
    <skos:definition xml:lang="ca">Fer còpies múltiples.</skos:definition>
    <skos:note xml:lang="en">This term is defined by Creative Commons.</skos:note>
    <skos:note xml:lang="es">Este término está definido por Creative Commons.</skos:note>
    <skos:note xml:lang="ca">Aquest terme està definit per Creative Commons.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <Action rdf:about="http://creativecommons.org/ns#ShareAlike">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Share Alike</rdfs:label>
    <rdfs:label xml:lang="es">Compartir igual</rdfs:label>
    <rdfs:label xml:lang="ca">Compartir igual</rdfs:label>
    <skos:definition xml:lang="en">Derivative works be licensed under the same terms or compatible terms as the original work.</skos:definition>
    <skos:definition xml:lang="es">Las obras derivadas deben licenciarse bajo los mismos términos o términos compatibles que la obra original.</skos:definition>
    <skos:definition xml:lang="ca">Les obres derivades s'han de llicenciar sota els mateixos termes o termes compatibles que l'obra original.</skos:definition>
    <skos:note xml:lang="en">This term is defined by Creative Commons.</skos:note>
    <skos:note xml:lang="es">Este término está definido por Creative Commons.</skos:note>
    <skos:note xml:lang="ca">Aquest terme està definit per Creative Commons.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <Action rdf:about="http://creativecommons.org/ns#Sharing">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Sharing</rdfs:label>
    <rdfs:label xml:lang="es">Compartir</rdfs:label>
    <rdfs:label xml:lang="ca">Compartir</rdfs:label>
    <skos:definition xml:lang="en">Permits commercial derivatives, but only non-commercial distribution.</skos:definition>
    <skos:definition xml:lang="es">Permite derivados comerciales, pero solo distribución no comercial.</skos:definition>
    <skos:definition xml:lang="ca">Permet derivats comercials, però només distribució no comercial.</skos:definition>
    <skos:note xml:lang="en">This term is defined by Creative Commons.</skos:note>
    <skos:note xml:lang="es">Este término está definido por Creative Commons.</skos:note>
    <skos:note xml:lang="ca">Aquest terme està definit per Creative Commons.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>
  <Action rdf:about="http://creativecommons.org/ns#SourceCode">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/odrl/2/"/>
    <rdfs:label xml:lang="en">Source Code</rdfs:label>
    <rdfs:label xml:lang="es">Código fuente</rdfs:label>
    <rdfs:label xml:lang="ca">Codi font</rdfs:label>
    <skos:definition xml:lang="en">Source code (the preferred form for making modifications) must be provided when exercising some rights granted by the license.</skos:definition>
    <skos:definition xml:lang="es">El código fuente (la forma preferida para realizar modificaciones) debe proporcionarse al ejercer algunos derechos otorgados por la licencia.</skos:definition>
    <skos:definition xml:lang="ca">El codi font (la forma preferida per fer modificacions) s'ha de proporcionar en exercir alguns drets atorgats per la llicència.</skos:definition>
    <skos:note xml:lang="en">This term is defined by Creative Commons.</skos:note>
    <skos:note xml:lang="es">Este término está definido por Creative Commons.</skos:note>
    <skos:note xml:lang="ca">Aquest terme està definit per Creative Commons.</skos:note>
    <skos:scopeNote xml:lang="en">Non-Normative</skos:scopeNote>
    <skos:scopeNote xml:lang="es">No normativo</skos:scopeNote>
    <skos:scopeNote xml:lang="ca">No normatiu</skos:scopeNote>
    <includedIn rdf:resource="http://www.w3.org/ns/odrl/2/use"/>
  </Action>

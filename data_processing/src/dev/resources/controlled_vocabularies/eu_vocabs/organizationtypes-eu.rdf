   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/organization-type/SEC_GEN_DPT"
                 at:deprecated="false">
      <euvoc:order>235</euvoc:order>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/organization-type"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/organization-type"/>
      <skos:prefLabel xml:lang="da">Tjeneste tilknyttet vicegeneralsekretæren</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Asepeasekretäri talitus</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Generalinio sekretoriaus pavaduotojo tarnyba</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Útvar zástupcu generálneho tajomníka</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Apulaispääsihteerin alainen yksikkö</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Útvar zástupce generálního tajemníka</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Dienests, kas pakļauts ģenerālsekretāra vietniekam</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Biuro zastępcy sekretarza generalnego</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Serviciu pe lângă Secretarul general adjunct</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Serviços do Secretário-Geral adjunto</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Tjänst knuten till biträdande generalsekreterare</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Seirbhís an Leas-Ardrúnaí</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Υπηρεσία του Αναπληρωτή Γενικού Γραμματέα</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Služba zamjenika glavnog tajnika</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Dienst van een adjunct-secretaris-generaal</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Service du secrétaire général adjoint</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Servicio del secretario general adjunto</skos:prefLabel>
      <skos:prefLabel xml:lang="ca">Servei del secretari general adjunt</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Služba namestnika generalnega sekretarja</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">A főtitkárhelyettes munkáját segítő szolgálat</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Servizio del Segretario generale aggiunto</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Service of deputy secretary general</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Dienst des stellvertretenden Generalsekretärs</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Servizz ta’ deputat segretarju ġenerali</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Служба на заместник генерален секретар</skos:prefLabel>
      <skos:definition xml:lang="en">Service of deputy secretary general is a type of organisational entity that it is attached to the secretary general.</skos:definition>
      <skos:altLabel xml:lang="fr">Service de la secrétaire générale adjointe</skos:altLabel>
      <skos:altLabel xml:lang="de">Dienst der stellvertretenden Generalsekretärin</skos:altLabel>
      <dc:identifier>SEC_GEN_DPT</dc:identifier>
      <atold:op-code>SEC_GEN_DPT</atold:op-code>
      <at:op-code>SEC_GEN_DPT</at:op-code>
      <at:start.use>1952-09-09</at:start.use>
      <at:authority-code>SEC_GEN_DPT</at:authority-code>
   </skos:Concept>

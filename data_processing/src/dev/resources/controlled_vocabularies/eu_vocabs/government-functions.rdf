	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="et">Keskkonnakaitse</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="el">Προστασία του περιβάλλοντος</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sv">Miljöskydd</prefLabel>

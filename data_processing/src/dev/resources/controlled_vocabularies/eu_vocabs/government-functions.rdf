	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="da">Fritid, kultur og religion</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pt">Serviços recreativos, culturais e religiosos</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="mt">Rikreazzjoni, kultura u reliġjon</prefLabel>

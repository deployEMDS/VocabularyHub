<rdf:Description rdf:about="http://data.europa.eu/7yx/cofog/09">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/7yx/cofog"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ro">Educație</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="es">Educación</prefLabel>

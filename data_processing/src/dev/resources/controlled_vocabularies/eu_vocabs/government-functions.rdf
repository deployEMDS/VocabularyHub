	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fi">Sairaalapalvelut eli laitoshoito</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pt">Serviços dos hospitais</prefLabel>

	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ca">Assumptes exteriors (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="mt">Affarijiet esterni (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ro">Afaceri externe (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="de">Auswärtige Angelegenheiten (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="et">Välispoliitika (KT)</prefLabel>

	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Upper-secondary education (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="mt">Edukazzjoni sekondarja tat-tieni livell (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="cs">Vyšší sekundární vzdělávání (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="bg">Горна степен на прогимназиалния етап на основното образование и средното образование (ИУ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lv">Vidējā izglītība (IP)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hr">Više srednjoškolsko obrazovanje (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hu">Felső középfokú oktatás (ESZ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lt">Aukštesnysis vidurinis (antrinis) mokymas (IP)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sk">Vyššie sekundárne vzdelávanie (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ro">Învățământ secundar superior (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pl">Edukacja II stopnia w zakresie szkoły średniej (UI)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="it">Istruzione secondaria superiore (SI)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fr">Deuxième cycle de l’enseignement secondaire (SI)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ga">Oideachas meánscoile sinsearach (SA)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="et">Teise taseme hariduse ülemine aste (IT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sv">Gymnasieutbildning (IT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="nl">Hoger secundair onderwijs (ID)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pt">Ensino secundário (SI)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sl">Višje sekundarno izobraževanje (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fi">Keskiasteen koulutus (YP)</prefLabel>
	<identifier xmlns="http://purl.org/dc/elements/1.1/">09.2.2</identifier>
	<exclusionNote xmlns="http://rdf-vocabulary.ddialliance.org/xkos#" xml:lang="en">Subsidiary services to education (09.6.0).</exclusionNote>
	<inclusionNote xmlns="http://rdf-vocabulary.ddialliance.org/xkos#" xml:lang="en">Out-of-school upper-secondary education for adults and young people.</inclusionNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">− Provision of upper-secondary education at ISCED-97 level 3;
− administration, inspection, operation or support of schools and other institutions providing upper-secondary education at ISCED-97 level 3;
− scholarships, grants, loans and allowances to support pupils pursuing upper-secondary education at ISCED-97 level 3.</definition>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/7yx/cofog/09.2">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/7yx/cofog/09"/>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/7yx/cofog"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pt">Ensino secundário</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="cs">Sekundární vzdělávání</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="et">Teise taseme haridus</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="da">Sekundær undervisning</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ro">Învățământ secundar</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="mt">Edukazzjoni sekondarja</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hr">Srednjoškolsko obrazovanje</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fr">Enseignement secondaire</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="nl">Secundair onderwijs</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Secondary education</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hu">Középfokú oktatás</prefLabel>

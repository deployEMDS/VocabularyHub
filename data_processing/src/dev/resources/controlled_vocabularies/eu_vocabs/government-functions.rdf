<rdf:Description rdf:about="http://data.europa.eu/7yx/cofog/01.8.0">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/7yx/cofog/01.8"/>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/7yx/cofog"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hu">A különböző kormányzati szintek közötti, általános jellegű átcsoportosítások (KSZ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ro">Transferuri generale între diferite niveluri ale administrațiilor publice (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sk">Transfery všeobecnej povahy medzi rôznymi úrovňami verejnej správy (KS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pl">Transfery o charakterze ogólnym między różnymi szczeblami sektora instytucji rządowych i samorządowych (UO)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hr">Opći transferi između različitih državnih razina (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fr">Transferts de caractère général entre administrations publiques (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fi">Hallinnon eri tasojen väliset yleisluontoiset siirrot (KP)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="et">Üldiseloomuga ülekanded valitsemissektori teistele tasanditele (KT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pt">Transferências de caráter geral entre diferentes níveis das administrações públicas (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="bg">Трансфери от общ характер между различни равнища на държавното управление (КУ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lt">Bendrieji pervedimai tarp įvairių vyriausybės lygių (KP)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="cs">Transfery obecného charakteru mezi různými úrovněmi státní a veřejné správy (KS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lv">Vispārīga rakstura pārskaitījumi starp dažādiem valsts pārvaldes līmeņiem (KP)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="da">Overførsler af generel art mellem forskellige forvaltningsniveauer (KT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="de">Transfers allgemeiner Art zwischen verschiedenen staatlichen Ebenen (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Transfers of a general character between different levels of government (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="nl">Overdrachten van algemene aard tussen verschillende bestuursniveaus (CD)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ga">Aistrithe de chineál ginearálta idir leibhéil éagsúla rialtais (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="el">Μεταβιβάσεις γενικού χαρακτήρα μεταξύ διαφόρων επιπέδων διακυβέρνησης (ΣΥ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sl">Splošni transferji med različnimi ravnmi države (KS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="es">Transferencias de carácter general entre diferentes niveles de gobierno (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ca">Transferències de caràcter general entre diferents nivells de govern (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sv">Allmänna transfereringar mellan olika delsektorer inom den offentliga sektorn (KT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="mt">Trasferimenti ta’ karattru ġenerali bejn livelli differenti ta’ gvern (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="it">Trasferimenti di carattere generale tra vari livelli delle amministrazioni pubbliche (SC)</prefLabel>
	<identifier xmlns="http://purl.org/dc/elements/1.1/">01.8.0</identifier>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">− Transfers between different levels of government that are of a general character and not allocated to a particular function.</definition>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/7yx/cofog/01.8">

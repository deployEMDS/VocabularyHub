	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hr">Obitelj i djeca (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="de">Familie und Kinder (IS)</prefLabel>

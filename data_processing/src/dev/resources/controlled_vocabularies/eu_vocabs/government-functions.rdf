	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="nl">Sociale uitsluiting, n.e.g.</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="es">Exclusión social n.e.p.</prefLabel>

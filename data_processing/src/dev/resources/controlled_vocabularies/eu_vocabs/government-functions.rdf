	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fr">Services de santé publique (SI)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sk">Ochrana, podpora a rozvoj verejného zdravia (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="nl">Diensten in de openbare gezondheidszorg (ID)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sl">Javnozdravstvene storitve (IS)</prefLabel>

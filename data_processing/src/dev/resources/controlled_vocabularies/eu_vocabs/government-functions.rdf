<rdf:Description rdf:about="http://data.europa.eu/7yx/cofog/09.5">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/7yx/cofog/09"/>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/7yx/cofog"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="es">Enseñanza no atribuible a ningún nivel</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ca">Ensenyament no atribuïble a cap nivell</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Education not definable by level</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="cs">Vzdělávání nedefinované podle úrovně</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="et">Haridus, mille taset ei ole võimalik määrata</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sv">Ej nivåbestämd utbildning</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="bg">Образование, недефинирано с образователна степен</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lt">Švietimas, neskaidomos pagal lygmenis</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="it">Istruzione non definibile per livello</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hu">Nem besorolható szintű oktatás</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ro">Învățământ neîncadrabil în niciun nivel de studii</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hr">Obrazovanje koje se ne može klasificirati prema stupnju</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fr">Enseignement non défini par niveau</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="de">Nicht einstufbares Bildungswesen</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ga">Oideachas nach féidir a shainiú de réir leibhéil</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="da">Undervisning uden for niveauplacering</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sl">Izobraževanje, ki ni opredeljeno po ravneh</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pl">Edukacja nieprzyporządkowana do konkretnego poziomu</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sk">Vzdelanie nedefinované podľa úrovne</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="mt">Edukazzjoni li ma tistax tiġi ddefinita skont il-livell</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lv">Līmeņos nedefinējama izglītība</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fi">Tutkintoon johtamaton koulutus</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="nl">Onderwijs dat niet naar niveau kan worden ingedeeld</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="el">Εκπαίδευση μη ταξινομημένη βάσει επιπέδου</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pt">Ensino não definido por níveis</prefLabel>
	<identifier xmlns="http://purl.org/dc/elements/1.1/">09.5</identifier>
</rdf:Description>


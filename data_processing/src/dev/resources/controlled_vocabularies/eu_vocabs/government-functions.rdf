	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sl">Varstvo okolja</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lv">Vides aizsardzība</prefLabel>

	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ga">Trádáil dáileacháin, stóráil agus trádstóráil (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hr">Distribucija i skladištenje (CS)</prefLabel>

<rdf:Description rdf:about="http://data.europa.eu/7yx/cofog/07.2">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/7yx/cofog/07"/>

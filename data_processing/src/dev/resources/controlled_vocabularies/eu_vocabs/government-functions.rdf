	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sk">Znižovanie znečistenia</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pt">Redução da poluição</prefLabel>

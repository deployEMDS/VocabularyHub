	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">External affairs (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pt">Negócios estrangeiros (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hr">Vanjski poslovi (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fr">Affaires étrangères (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="nl">Buitenlandse zaken (CD)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hu">Külügyek (KSZ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lv">Ārlietas (KP)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pl">Sprawy zagraniczne (UO)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="da">Udenrigsanliggender (KT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fi">Ulkoasiainhallinto (KP)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sk">Zahraničné vzťahy (KS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ga">Gnóthaí seachtracha (SC)</prefLabel>
	<identifier xmlns="http://purl.org/dc/elements/1.1/">01.1.3</identifier>
	<exclusionNote xmlns="http://rdf-vocabulary.ddialliance.org/xkos#" xml:lang="en">Economic aid to developing countries and countries in transition (01.2.1); economic aid missions accredited to foreign governments (01.2.1); contributions to aid programs administered by international or regional organizations (01.2.2); military units stationed abroad (02.1.0); military aid to foreign countries (02.3.0); general foreign economic and commercial affairs (04.1.1); tourism affairs and services (04.7.3).</exclusionNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">− Administration of external affairs and services;
− operation of the ministry of external affairs and diplomatic and consular missions stationed abroad or at offices of international organizations; operation or support of information and cultural services for distribution beyond national boundaries; operation or support of libraries, reading rooms and reference services located abroad;
− regular subscriptions and special contributions to meet general operating expenses of international organizations.</definition>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/7yx/cofog/01.1">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/7yx/cofog/01"/>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/7yx/cofog"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hu">Végrehajtó és törvényhozó szervek, pénzügyi és költségvetési tevékenységek, külügyek</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="nl">Wetgevende en uitvoerende organen, financiële en fiscale zaken, buitenlandse zaken</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="da">Udøvende og lovgivende organer, skatte- og finansvæsen, udenrigstjenesten</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="mt">Organi eżekuttivi u leġiżlattivi, affarijiet finanzjarji u fiskali, affarijiet esterni</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sk">Výkonné a zákonodarné orgány, finančné a rozpočtové záležitosti, zahraničné vzťahy</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Executive and legislative organs, financial and fiscal affairs, external affairs</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fr">Fonctionnement des organes exécutifs et législatifs, affaires financières et fiscales, affaires étrangères</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="el">Εκτελεστικά και νομοθετικά όργανα, χρηματοπιστωτικές και δημοσιονομικές υποθέσεις, εξωτερικές υποθέσεις</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ga">Comhlachtaí feidhmiúcháin agus reachtacha, gnóthaí airgeadais agus fioscacha, gnóthaí seachtracha</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="it">Organi esecutivi e legislativi, amministrazione finanziaria e fiscale, affari esteri</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="cs">Zákonodárné, výkonné a další normotvorné orgány, záležitosti finanční, rozpočtové, daňové a zahraniční kromě zahraniční pomoci</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sv">Verkställande och lagstiftande organ, ekonomi- och skatteförvaltning, utrikesförvaltning</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="bg">Органи на изпълнителната и законодателната власт, финансови и фискални въпроси, външни работи</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sl">Izvršilni in zakonodajni organi, finančne in davčne zadeve, zunanje zadeve</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fi">Toimeenpano- ja lainsäädäntöelimet, finanssi- ja veroasiat, ulkoasiainhallinto</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pl">Organy wykonawcze i ustawodawcze, sprawy finansowe i skarbowe, sprawy zagraniczne</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="es">Órganos ejecutivos y legislativos, asuntos financieros y fiscales, asuntos exteriores</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ca">Òrgans executius i legislatius, assumptes financers i fiscals, assumptes exteriors</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lv">Izpildvaras un likumdošanas iestādes, finanšu un fiskālās lietas, ārlietas</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lt">Įstatymų leidžiamoji ir vykdomoji valdžia, finansiniai ir fiskaliniai reikalai, užsienio reikalai</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="de">Exekutiv- und Legislativorgane, Finanz- und Steuerwesen, auswärtige Angelegenheiten</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ro">Organe executive și legislative, afaceri financiare și fiscale, afaceri externe</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="et">Täidesaatvad ja seadusandlikud organid, rahandus- ja fiskaalpoliitika, välispoliitika</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hr">Izvršna i zakonodavna tijela, financijski i porezni poslovi, vanjski poslovi</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pt">Órgãos executivos e legislativos, administração financeira e fiscal, negócios estrangeiros</prefLabel>
	<identifier xmlns="http://purl.org/dc/elements/1.1/">01.1</identifier>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/7yx/cofog/08.2.0">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/7yx/cofog/08.2"/>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/7yx/cofog"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pt">Serviços culturais (SI)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="it">Servizi culturali (SI)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="el">Πολιτιστικές υπηρεσίες (ΣΥ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pl">Usługi związane z kulturą (UI)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sv">Kulturell verksamhet (IT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ro">Servicii culturale (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="nl">Diensten op het gebied van cultuur (ID)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hr">Kulturne usluge (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="es">Servicios culturales (SI)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ca">Serveis culturals (SI)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="mt">Servizzi kulturali (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lt">Kultūros paslaugos (IP)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="da">Kulturtjenester (IT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="bg">Услуги в областта на културата (ИУ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sl">Kulturne storitve (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sk">Kultúrne služby (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hu">Kulturális szolgáltatások (ESZ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="cs">Kulturní služby (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="de">Kulturdienstleistungen (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Cultural services (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lv">Kultūras pakalpojumi (IP)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="et">Kultuuriteenused (IT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ga">Seirbhísí cultúrtha (SA)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fr">Services culturels (SI)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fi">Kulttuuripalvelut (YP)</prefLabel>
	<identifier xmlns="http://purl.org/dc/elements/1.1/">08.2.0</identifier>
	<exclusionNote xmlns="http://rdf-vocabulary.ddialliance.org/xkos#" xml:lang="en">Cultural events intended for presentation beyond national boundaries (01.1.3); national, regional or local celebrations intended chiefly to attract tourists (04.7.3); production of cultural material intended for distribution by broadcasting (08.3.0).</exclusionNote>
	<inclusionNote xmlns="http://rdf-vocabulary.ddialliance.org/xkos#" xml:lang="en">National, regional or local celebrations provided they are not intended chiefly to attract tourists.</inclusionNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">− Provision of cultural services; administration of cultural affairs; supervision and regulation of cultural facilities;
− operation or support of facilities for cultural pursuits (libraries, museums, art galleries, theatres, exhibition halls, monuments, historic houses and sites, zoological and botanical gardens, aquaria, arboreta, etc.); production, operation or support of cultural events (concerts, stage and film productions, art shows, etc.);
− grants, loans or subsidies to support individual artists, writers, designers, composers and others working in the arts or to organizations engaged in promoting cultural activities.</definition>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/7yx/cofog/02.1.0">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>

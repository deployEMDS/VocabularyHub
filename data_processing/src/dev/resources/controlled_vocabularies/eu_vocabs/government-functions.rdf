	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hu">Szennyezéscsökkentés</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sv">Föroreningsbekämpning</prefLabel>

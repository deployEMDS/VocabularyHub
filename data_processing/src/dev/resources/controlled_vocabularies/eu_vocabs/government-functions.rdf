	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ga">Taighde bunúsach (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sk">Základný výskum (KS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="mt">Riċerka bażika (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hu">Alapkutatás (KSZ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hr">Temeljna istraživanja (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pl">Badania podstawowe (UO)</prefLabel>
	<identifier xmlns="http://purl.org/dc/elements/1.1/">01.4.0</identifier>
	<exclusionNote xmlns="http://rdf-vocabulary.ddialliance.org/xkos#" xml:lang="en">Applied research and experimental development (classified by function).</exclusionNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">− Administration and operation of government agencies engaged in basic research;
− grants, loans or subsidies to support basic research undertaken by non-government
bodies such as research institutes and universities.</definition>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/7yx/cofog/01.4">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>

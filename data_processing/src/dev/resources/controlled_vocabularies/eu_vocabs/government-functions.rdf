	<inclusionNote xmlns="http://rdf-vocabulary.ddialliance.org/xkos#" xml:lang="en">Education affairs and services that cannot be assigned to (09.1), (09.2), (09.3), (09.4), (09.5), (09.6) or (09.7).</inclusionNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">− Administration, operation or support of activities such as formulation, administration, coordination and monitoring of overall educational policies, plans, programmes and budgets; preparation and enforcement of legislation and standards for the provision of education, including licensing of educational establishments; production and dissemination of general information, technical documentation and statistics on education.</definition>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/7yx/cofog/10.5.0">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/7yx/cofog/10.5"/>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/7yx/cofog"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sv">Arbetslöshet (IT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hr">Nezaposlenost (IS)</prefLabel>

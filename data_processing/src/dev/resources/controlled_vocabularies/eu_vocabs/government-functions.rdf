	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pt">Proteção da biodiversidade e da paisagem</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hr">Zaštita bioraznolikosti i krajolika</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="et">Bioloogilise mitmekesisuse ja maastiku kaitse</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="cs">Ochrana biodiverzity a krajiny</prefLabel>

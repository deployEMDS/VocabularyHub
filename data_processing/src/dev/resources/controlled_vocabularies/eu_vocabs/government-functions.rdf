	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lt">Tyrimų ir taikomoji veikla žemės ūkio, miškininkystės, žvejybos ir medžioklės srityse (KP)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="da">FoU inden for landbrug, skovbrug, fiskeri og jagt (KT)</prefLabel>

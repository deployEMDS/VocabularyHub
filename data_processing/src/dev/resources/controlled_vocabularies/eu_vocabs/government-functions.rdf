	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hu">Szén és egyéb szilárd ásványi tüzelőanyagok (KSZ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="de">Kohle und andere feste mineralische Brennstoffe (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="mt">Faħam u fjuwils minerali solidi oħrajn (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hr">Ugljen i druga kruta mineralna goriva (CS)</prefLabel>

	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fr">Recherche fondamentale</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hr">Temeljna istraživanja</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ga">Taighde bunúsach</prefLabel>

	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="nl">O&amp;O op het gebied van landbouw, bosbouw, visserij en jacht (CD)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fi">Maa-, metsä-, kala- ja riistatalouteen liittyvä tutkimus ja kehittäminen (KP)</prefLabel>
	<identifier xmlns="http://purl.org/dc/elements/1.1/">04.8.2</identifier>
	<exclusionNote xmlns="http://rdf-vocabulary.ddialliance.org/xkos#" xml:lang="en">Basic research (01.4.0).</exclusionNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">− Administration and operation of government agencies engaged in applied research and experimental development related to agriculture, forestry, fishing and hunting;
− grants, loans or subsidies to support applied research and experimental development related to agriculture, forestry, fishing and hunting undertaken by non-government bodies such as research institutes and universities.</definition>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/7yx/cofog/04.3.5">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/7yx/cofog/04.3"/>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/7yx/cofog"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hu">Villamos energia (KSZ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Electricity (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sl">Električna energija (KS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ga">Leictreachas (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sk">Elektrická energia (KS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sv">Elektricitet (KT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="da">Elektricitet (KT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hr">Električna energija (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lv">Elektrība (KP)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fr">Électricité (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pt">Eletricidade (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="it">Elettricità (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="de">Strom (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pl">Sprawy związane z energią elektryczną (UO)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ro">Electricitate (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="bg">Електрическа енергия (КУ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="cs">Elektrická energie (KS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="es">Electricidad (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ca">Electricitat (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="el">Ηλεκτρική ενέργεια (ΣΥ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="et">Elektrienergia (KT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="nl">Elektriciteit (CD)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fi">Sähköhuolto (KP)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="mt">Elettriku (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lt">Elektros energija (KP)</prefLabel>
	<identifier xmlns="http://purl.org/dc/elements/1.1/">04.3.5</identifier>
	<exclusionNote xmlns="http://rdf-vocabulary.ddialliance.org/xkos#" xml:lang="en">Non-electric energy produced by wind or solar heat (04.3.6).</exclusionNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">This class covers both traditional sources of electricity such as thermal or hydro supplies and newer sources such as wind or solar heat.
− Administration of electricity affairs and services; conservation, development and rationalized exploitation of electricity supplies; supervision and regulation of the generation, transmission and distribution of electricity;
− construction or operation of non-enterprise-type electricity supply systems;
− production and dissemination of general information, technical documentation and statistics on electricity affairs and services;
− grants, loans or subsidies to support the electricity supply industry, including such outlays for the construction of dams and other works designed chiefly to provide electricity.</definition>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/7yx/cofog/04.5.5">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/7yx/cofog/04.5"/>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/7yx/cofog"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ro">Transport prin conducte sau alte tipuri de transport (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pl">Sprawy związane z transportem rurociągowym i innym transportem (UO)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fr">Pipelines et systèmes de transport divers (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lv">Cauruļvadu un cita veida transports (KP)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="es">Transporte por oleoductos y gasoductos y otros sistemas de transporte</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ca">Transport per oleoductes i gasoductes i altres sistemes de transport</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sl">Plinovodi in druge transportne poti (KS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="et">Torutransport ja muu transport (KT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="mt">Trasport bil-pipelines u trasport ieħor (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="bg">Тръбопроводен транспорт и други видове транспорт (КУ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="da">Rørledninger og andre transportformer (KT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sk">Potrubná a iná doprava (KS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ga">Iompar de phíblíne agus eile (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fi">Putkijohtokuljetukset ja muu kuljetustoiminta (KP)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pt">Condutas e outros sistemas de transporte (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Pipeline and other transport (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sv">Transport i rörledningar och annan transport (KT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="de">Transport in Rohrfernleitungen und sonstiger Transport (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hr">Cjevovodi i ostale vrste transporta (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="nl">Vervoer via pijpleidingen en overig vervoer (CD)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lt">Transportavimas vamzdynais ir kitas transportas (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="it">Condotte e altre modalità di trasporto (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hu">Csővezetékes és egyéb szállítás (KSZ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="el">Μεταφορές μέσω αγωγών και άλλες μεταφορές (ΣΥ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="cs">Potrubní a ostatní doprava (KS)</prefLabel>
	<identifier xmlns="http://purl.org/dc/elements/1.1/">04.5.5</identifier>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">− Administration of affairs and services concerning operation, use, construction and maintenance of pipeline and other transport systems (funiculars, cable cars, chairlifts, etc.);
− supervision and regulation of users of pipeline and other transport systems (registration, licensing, inspection of equipment, operator skills and training; safety standards, etc.); of pipeline and other transport systems operations (granting of franchises, setting tariffs, frequency and levels of service, etc.) and of pipeline and other transport systems construction and maintenance;
− construction or operation of non-enterprise-type pipeline and other transport systems;
− production and dissemination of general information, technical documentation and statistics on the operation and construction of pipeline and other transport systems;
− grants, loans or subsidies to support the operation, construction, maintenance or upgrading of pipeline and other transport systems.</definition>
</rdf:Description>


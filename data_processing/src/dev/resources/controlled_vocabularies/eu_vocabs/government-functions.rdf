	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="it">Protezione sociale n.c.a. (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pt">Serviços de proteção social n.e. (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="nl">Sociale bescherming, n.e.g. (CD)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="bg">Социална защита, н.к.д. (КУ)</prefLabel>
	<identifier xmlns="http://purl.org/dc/elements/1.1/">10.9.0</identifier>
	<inclusionNote xmlns="http://rdf-vocabulary.ddialliance.org/xkos#" xml:lang="en">Provision of social protection in the form of cash benefits and benefits in kind to victims of fires, floods, earthquakes and other peacetime disasters; purchase and storage of food, equipment and other supplies for emergency use in the case of peacetime disasters; other social protection affairs and services that cannot be assigned to (10.1), (10.2), (10.3), (10.4), (10.5), (10.6), (10.7) or (10.8).</inclusionNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">− Administration, operation or support of activities such as formulation, administration, coordination and monitoring of overall social protection policies, plans, programmes and budgets; preparation and enforcement of legislation and standards for the provision of social protection; production and dissemination of general information, technical documentation and statistics on social protection.</definition>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/7yx/cofog/04.8.1">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/7yx/cofog/04.8"/>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="http://data.europa.eu/7yx/cofog"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fr">R-D concernant la tutelle de l’économie générale, des échanges et de l’emploi (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hr">Istraživanje i razvoj u općoj ekonomskoj, trgovinskoj i radnoj problematici (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ga">Taighde agus forbairt—Gnóthaí ginearálta eacnamaíocha, tráchtála agus saothair (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="nl">O&amp;O op het gebied van algemene economische, handels- en arbeidsmarktaangelegenheden (CD)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="da">FoU i generelle emner inden for økonomi, handel og arbejdsmarked (KT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lv">Pētniecība un izstrāde vispārējo ekonomikas, tirdzniecības un nodarbinātības lietu jomā (KP)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="de">FuE im Bereich allgemeine Angelegenheiten der Wirtschaft und des Arbeitsmarkts (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hu">Általános gazdasági, kereskedelmi és foglalkoztatási K+F (KSZ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lt">Tyrimų ir taikomosios veiklos ekonomikos, prekybos ir darbo reikalai (KP)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pl">Prace badawczo-rozwojowe w zakresie spraw ogólnogospodarczych, związanych z handlem i rynkiem pracy (UO)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sk">Výskum a vývoj v ekonomickej, obchodnej a pracovnej oblasti (KS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fi">Taloutta ja kauppaa sekä työvoimapalveluita koskeviin asioihin liittyvä yleinen tutkimus ja kehittäminen (KP)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="es">Investigación y desarrollo relacionados con asuntos económicos, comerciales y laborales en general (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ca">Recerca i desenvolupament relacionats amb assumptes econòmics, comercials i laborals en general (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sl">R&amp;R na področju splošnih gospodarskih in trgovinskih zadev ter zadev, povezanih z delom (KS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sv">FoU övergripande handels-, näringslivs- och arbetsmarknadsfrågor (KT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="cs">Výzkum a vývoj a oblasti všeobecných ekonomických, komerčních a pracovních záležitostí (KS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ro">C&amp;D Afaceri generale economice, comerciale și de forță de muncă (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="el">Έρευνα και ανάπτυξη για τις γενικές οικονομικές, εμπορικές και εργασιακές υποθέσεις (ΣΥ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="mt">R&amp;Ż għall-Affarijiet ekonomiċi, kummerċjali u tax-xogħol ġenerali (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="et">Teadus- ja arendustegevus üldise majandus-, kaubandus- ja tööjõupoliitika alal (KT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="it">R&amp;S in materia di affari economici, commerciali e di lavoro di carattere generale (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">R&amp;D General economic, commercial and labour affairs (CS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pt">Investigação e desenvolvimento em assuntos económicos , comerciais e laborais, em geral (SC)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="bg">Приложни научни изследвания, свързани с общите дейности в областта на икономиката, търговията и труда (КУ)</prefLabel>
	<identifier xmlns="http://purl.org/dc/elements/1.1/">04.8.1</identifier>
	<modified xmlns="http://purl.org/dc/terms/" rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-10</modified>
	<exclusionNote xmlns="http://rdf-vocabulary.ddialliance.org/xkos#" xml:lang="en">Basic research (01.4.0).</exclusionNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">− Administration and operation of government agencies engaged in applied research and experimental development related to general economic, commercial and labour affairs;
− grants, loans or subsidies to support applied research and experimental development related to general economic, commercial and labour affairs undertaken by non government bodies such as research institutes and universities.</definition>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/7yx/cofog/07.2.4">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>

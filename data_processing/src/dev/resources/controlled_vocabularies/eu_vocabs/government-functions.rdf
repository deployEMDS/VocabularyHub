	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ga">Laghdú ar thruailliú</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="et">Reostustõrje</prefLabel>

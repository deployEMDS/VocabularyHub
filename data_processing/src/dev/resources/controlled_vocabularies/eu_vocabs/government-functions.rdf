	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Specialized hospital services (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="cs">Ústavní zdravotní péče specializovaná (IS)</prefLabel>

	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="da">Undervisning uden for niveauplacering (IT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hu">Nem besorolható szintű oktatás (ESZ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="el">Εκπαίδευση μη ταξινομημένη βάσει επιπέδου (ΑΥ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Education not definable by level (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fr">Enseignement non défini par niveau (SI)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="hr">Obrazovanje koje se ne može klasificirati prema stupnju (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="bg">Образование, недефинирано с образователна степен (ИУ)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="it">Istruzione non definibile per livello (SI)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="de">Nicht einstufbares Bildungswesen (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sk">Vzdelávanie nedefinované podľa úrovne (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sl">Izobraževanje, ki ni opredeljeno po ravneh (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="mt">Edukazzjoni li ma tistax tiġi ddefinita skont il-livell (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="es">Enseñanza no atribuible a ningún nivel (SI)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ca">Ensenyament no atribuïble a cap nivell (SI)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fi">Tutkintoon johtamaton koulutus (YP)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ro">Învățământ neîncadrabil în niciun nivel de studii (IS)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ga">Oideachas nach féidir a shainiú de réir leibhéil (SA)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="sv">Ej nivåbestämd utbildning (IT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="et">Haridus, mille taset ei ole võimalik määrata (IT)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lt">Pagal lygmenis neskaidomas švietimas (IP)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="lv">Līmeņos nedefinējama izglītība (IP)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pl">Edukacja nieprzyporządkowana do konkretnego poziomu (UI)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="pt">Ensino não definido por níveis (SI)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="nl">Onderwijs dat niet naar niveau kan worden ingedeeld (ID)</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="cs">Vzdělávání nedefinované podle úrovně (IS)</prefLabel>
	<identifier xmlns="http://purl.org/dc/elements/1.1/">09.5.0</identifier>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">− Provision of education not definable by level (that is, educational programmes, generally for adults, which do not require any special prior instruction, in particular vocational training and cultural development);
− administration, inspection, operation or support of institutions providing education not definable by level;
− scholarships, grants, loans and allowances to support students pursuing education programmes not definable by level.</definition>
</rdf:Description>


	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Recreation, culture and religion</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="es">Actividades recreativas, cultura y religión</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="ca">Activitats recreatives, cultura i religió</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="fr">Loisirs, culture et culte</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="et">Vaba aeg, kultuur ja religioon</prefLabel>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="cs">Rekreace, kultura a náboženství</prefLabel>

<#Distribution>
  a rr:TriplesMap;

  rml:logicalSource [
    rml:source "../resources/test/test_metadata.json";
    rml:referenceFormulation ql:JSONPath;
    rml:iterator "$";
  ];

  rr:subjectMap [
    rr:template "http://data.dsb.com/vocabulary/dataset/distribution/{id}";
    rr:class dcat:Distribution;
  ];

  rr:predicateObjectMap [
    rr:predicate dcat:accessURL;
    rr:objectMap [
      rml:reference "namedGraphURL";
      rr:termType rr:IRI;
    ];
  ];

  rr:predicateObjectMap [
    rr:predicate dcat:downloadURL;
    rr:objectMap [
      rml:reference "accessURL";
      rr:termType rr:IRI;
    ];
  ];

  # Temporary fix for TTL resources.
  # The MDR SHACL expects dcat:mediaType to match the IANA media type URI pattern.
  rr:predicateObjectMap [
    rr:predicate dcat:mediaType;
    rr:objectMap [
      rr:constant <https://www.iana.org/assignments/media-types/text/turtle>;
      rr:termType rr:IRI;
    ];
  ];

  rr:predicateObjectMap [
    rr:predicate dct:license;
    rr:objectMap [
      rr:parentTriplesMap <#License>;
    ];
  ];

  rr:predicateObjectMap [
    rr:predicate adms:status;
    rr:objectMap [
      rml:reference "status";
      rr:termType rr:IRI;
    ];
  ];

  rr:predicateObjectMap [
    rr:predicate mobilitydcatap:mobilityDataStandard;
    rr:objectMap [
      rml:reference "mobility_data_standard";
      rr:termType rr:IRI;
    ];
  ];

  rr:predicateObjectMap [
    rr:predicate dct:format;
    rr:objectMap [
      rr:template "http://publications.europa.eu/resource/authority/file-type/{format}";
      rr:termType rr:IRI;
    ];
  ].


<#DistributionDescription>
  a rr:TriplesMap;

  rml:logicalSource [
    rml:source "../resources/test/test_metadata.json";
    rml:referenceFormulation ql:JSONPath;
    rml:iterator "$.description[*]";
  ];

  rr:subjectMap [
    rr:template "http://data.dsb.com/vocabulary/dataset/distribution/{id}";
    rr:class dcat:Distribution;
  ];

  rr:predicateObjectMap [
    rr:predicate dct:description;
    rr:objectMap [
      rml:reference "value";
      rml:languageMap [
        rr:template "{language}";
      ];
    ];
  ].


<#MediaType>
  a rr:TriplesMap;

  rml:logicalSource [
    rml:source "../resources/test/test_metadata.json";
    rml:referenceFormulation ql:JSONPath;
    rml:iterator "$";
  ];

  rr:subjectMap [
    rr:constant <https://www.iana.org/assignments/media-types/text/turtle>;
    rr:termType rr:IRI;
  ].


<#License>
  a rr:TriplesMap;

  rml:logicalSource [
    rml:source "../resources/test/test_metadata.json";
    rml:referenceFormulation ql:JSONPath;
    rml:iterator "$";
  ];

  rr:subjectMap [
    rml:reference "license";
    rr:termType rr:IRI;
    rr:class dct:LicenseDocument;
  ];

  rr:predicateObjectMap [
    rr:predicate skos:inScheme;
    rr:objectMap [
      rr:constant <http://publications.europa.eu/resource/authority/licence>;
      rr:termType rr:IRI;
    ];
  ].


<#Theme>
  a rr:TriplesMap;


# VARIABLES THAT NEED TO BE CHANGED
# FOLDER WHERE FILE MANAGER DOWNLOAD FILES CORPUS
EXTERNAL_CORPUS_FOLDER=/home/ubuntu/KF/resources/

# FOLDER WHERE FILEBEAT READ LOGS
EXTERNAL_LOGS_FOLDER=/home/ubuntu/KF/logs

# FOLDER WHERE RESOURCES NEEDED IN DIFFERENT PROJECTS
EXTERNAL_RESOURCES_FOLDER=/home/ubuntu/KF/data_processing/src/dev/resources

# FILE WHERE PROJECT ENVIRONMENT VAIABLES ARE DEFINED
CONTAINER_ENV_PATH=.env

# FLASK DATA PROCESSING
CONTAINER_DOCKERFILE=./Dockerfile
CONTAINER_PORT=5000
ELASTIC_OPENSEARCH_DATABASE=opensearch
CONTAINER_CORPUS_FOLDER=/usr/src/corpus
CONTAINER_RESOURCES_FOLDER=/usr/src/resources
CONTAINER_LOGS_FOLDER=/usr/src/logs
RML_VERSION=8.1.0-r380
JAR_SAVE_PATH="/usr/src/resources/rml/lib/rmlmapper-${RML_VERSION}-all.jar"
API_PORT=5000

CORPUS_PATH=/usr/src/corpus
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# For local environment use 'dev' instead 'src'
PROJECT_NAME_FOLDER=src

# VARIABLES FOR SET ENVIRONMENT CONNECTIONS

# use https for domain with SSL certificate, http for develop without SSL
protocol=http
# set your domain name test.,dev., prod., preprod.
subdomain= test.
# always the same domain
domain=nttdata-dataspacebuilder.com
# in case of develop environment set your IP address of the instance
instanceIP=31.70.80.47


URI="${protocol}://${instanceIP}" # Remove '${subdomain}' and switch to instanceIP for develop environment instead of domain

FILE_MANAGER_HOST="${URI}:5100/file-manager/v1" # Add port for develop environment ':5100' instead of '/api'
VALIDATOR_HOST="${URI}:5200/validator/v1" # Add port for develop environment ':5200' instead of '/api'
INFORMATION_EXTRACTION_HOST="${URI}:5300/information-extraction/v1" # Add port for develop environment ':5300' instead of '/api'
PERSISTOR_HOST="${URI}:5400/persistence/v1/Persistence/persistence" # Add port for develop environment ':5400' instead of '/api'
GRAPHDB_HOST="${URI}:7200/repositories/" # Add port for develop environment ':7200' instead of '/graphdb'
ELASTICSEARCH_HOST="${URI}:9200" # Add port for develop environment ':9200' instead of '/opensearch/'
OPENSEARCH_HOST="${URI}:9200" # Add port for develop environment ':9200' instead of '/opensearch/'
QUALITY_SERVICE_HOST="${URI}:8000/api/v1" # Add port for develop environment ':8000'

# Triplestore selection for DCAT/DataServices only
# Values: graphdb | fuseki | neptune
TRIPLESTORE_BACKEND=graphdb
# Nosql selection
NOSQL_BACKEND=opensearch

# (legacy) persistence settings kept for reference only; not used by data_processing anymore.
#PERSISTENCE_BASE_URL=http://127.0.0.1:5400
#PERSISTENCE_API_PREFIX=/persistence/v1

# Fuseki base URL (only used when TRIPLESTORE_BACKEND=fuseki)
FUSEKI_BASE_URL=http://127.0.0.1:3030
# Dataset name in Fuseki (only used when TRIPLESTORE_BACKEND=fuseki)
FUSEKI_DATASET=catalog
# Optional basic auth for Fuseki
#FUSEKI_USER=
#FUSEKI_PASSWORD=

# Neptune endpoint (only used when TRIPLESTORE_BACKEND=neptune)
# Example: https://dsb-dev-instance-neptune-cluster.cluster-cxa0ikk4oe2o.eu-north-1.neptune.amazonaws.com:8182
# Example 2 ec2 public: https://neptune-dev-cluster.cluster-cxa0ikk4oe2o.eu-north-1.neptune.amazonaws.com:8182
# For local development with Neptune, use the IP address and port of your Neptune instance: http://13.50.173.59:8182
NEPTUNE_ENDPOINT=https://neptune-dev-cluster.cluster-cxa0ikk4oe2o.eu-north-1.neptune.amazonaws.com:8182
# Optional basic auth for Neptune (only needed if you have enabled authentication on your Neptune cluster)
#NEPTUNE_USER=
#NEPTUNE_PASSWORD=

# Existing GraphDB settings are read from GRAPHDB_HOST in this file if you set it.
# Example:
#GRAPHDB_HOST=http://127.0.0.1:7200/repositories/

# Controlled Vocabularies (SKOS) - GraphDB repository and base IRIs
GRAPHDB_CONTROLLED_VOCABS_REPOSITORY_NAME=catalog
DSB_BASE_VOCAB_SCHEMES=http://data.dsb.com/vocab/scheme/
DSB_BASE_VOCAB_CONCEPTS=http://data.dsb.com/vocab/concept/
DSB_GRAPH_VOCABS_OP_EU=http://data.dsb.com/graph/reference/source/op-eu
DSB_GRAPH_VOCABS_EXTENSIONS=http://data.dsb.com/graph/reference/extensions
DSB_GRAPH_VOCABS_W3=http://data.dsb.com/graph/reference/source/w3
DSB_GRAPH_VOCABS_IANA=http://data.dsb.com/graph/reference/source/iana

# Participants graph/base
DSB_GRAPH_PARTICIPANTS=http://data.dsb.com/graph/participants
BASE_GRAPH_PARTICIPANTS=http://data.dsb.com/participant/

CONTROLLED_VOCAB_PROFILE=default
AUTO_IMPORT_CONTROLLED_VOCABS_ENABLED=true
# Comma-separated list of controlled vocabularies to auto-import.For import same list of vocabularies as validation profile:profile, Import all:*, Import just selected vocabularies:languages,countries.
AUTO_IMPORT_CONTROLLED_VOCABS_LIST=profile


#Basic Auth User
API_USER=user
API_PASSWORD=password

# Internationalization fallback language
I18N_FALLBACK_LANG=es
